    "text": "This is a greedy heuristic, not an optimal solver. It pairs vertical photos by tag count, then builds the slideshow by repeatedly picking the unused slide with the best transition score from the current one. Candidates come from a tag-to-slide inverted index, with a per-step scan budget so runtime stays bounded on large inputs. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N;\n    cin >> N;\n\n    unordered_map<string, int> tagId;\n    vector<vector<int>> ptags(N);\n    vector<char> orient(N);\n\n    for (int i = 0; i < N; i++) {\n        char o;\n        int m;\n        cin >> o >> m;\n        orient[i] = o;\n        vector<int> v;\n        v.reserve(m);\n        for (int k = 0; k < m; k++) {\n            string s;\n            cin >> s;\n            auto it = tagId.find(s);\n            int id;\n            if (it == tagId.end()) {\n                id = (int)tagId.size();\n                tagId.emplace(s, id);\n            } else {\n                id = it->second;\n            }\n            v.push_back(id);\n        }\n        sort(v.begin(), v.end());\n        v.erase(unique(v.begin(), v.end()), v.end());\n        ptags[i] = move(v);\n    }\n    int numTags = (int)tagId.size();\n\n    // Build slides\n    vector<vector<int>> slideTags;\n    vector<vector<int>> slidePhotos;\n    vector<int> horiz, vert;\n    for (int i = 0; i < N; i++) {\n        if (orient[i] == 'H') horiz.push_back(i);\n        else vert.push_back(i);\n    }\n    for (int h : horiz) {\n        slideTags.push_back(ptags[h]);\n        slidePhotos.push_back({h});\n    }\n    // pair verticals: sort by tag count, pair adjacent\n    sort(vert.begin(), vert.end(), [&](int a, int b) {\n        if (ptags[a].size() != ptags[b].size()) return ptags[a].size() < ptags[b].size();\n        return a < b;\n    });\n    for (size_t i = 0; i + 1 < vert.size(); i += 2) {\n        int a = vert[i], b = vert[i + 1];\n        vector<int> u;\n        set_union(ptags[a].begin(), ptags[a].end(), ptags[b].begin(), ptags[b].end(),\n                  back_inserter(u));\n        slideTags.push_back(move(u));\n        slidePhotos.push_back({a, b});\n    }\n\n    int S = (int)slideTags.size();\n    if (S == 0) {\n        printf(\"0\\n\");\n        return 0;\n    }\n\n    // Inverted index\n    vector<vector<int>> idx(numTags);\n    for (int j = 0; j < S; j++)\n        for (int t : slideTags[j]) idx[t].push_back(j);\n\n    vector<char> used(S, 0);\n    vector<int> mark(numTags, 0);\n    int stamp = 0;\n    vector<int> cnt(S, 0);\n    vector<int> touched;\n    touched.reserve(8192);\n\n    vector<int> order;\n    order.reserve(S);\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n    int ptr = 0;\n    const int BUDGET = 2000;\n    const int TOPK = 30;\n\n    for (int step = 1; step < S; step++) {\n        stamp++;\n        const vector<int> &T = slideTags[cur];\n        for (int t : T) mark[t] = stamp;\n\n        // tags of current slide, rarest first\n        vector<int> ts = T;\n        sort(ts.begin(), ts.end(), [&](int a, int b) {\n            if (idx[a].size() != idx[b].size()) return idx[a].size() < idx[b].size();\n            return a < b;\n        });\n\n        touched.clear();\n        int budget = BUDGET;\n        for (int t : ts) {\n            if (budget <= 0) break;\n            auto &lst = idx[t];\n            size_t i = 0;\n            while (i < lst.size() && budget > 0) {\n                int j = lst[i];\n                if (used[j]) {\n                    lst[i] = lst.back();\n                    lst.pop_back();\n                    continue;\n                }\n                if (cnt[j] == 0) touched.push_back(j);\n                cnt[j]++;\n                i++;\n                budget--;\n            }\n        }\n\n        int best = -1;\n        int bestInterest = -1;\n        int bestC = -1;\n        if (!touched.empty()) {\n            int k = min((int)touched.size(), TOPK);\n            partial_sort(touched.begin(), touched.begin() + k, touched.end(),\n                         [&](int a, int b) {\n                             if (cnt[a] != cnt[b]) return cnt[a] > cnt[b];\n                             return a < b;\n                         });\n            for (int q = 0; q < k; q++) {\n                int j = touched[q];\n                int c = 0;\n                for (int t : slideTags[j])\n                    if (mark[t] == stamp) c++;\n                int a = (int)T.size() - c;\n                int b = (int)slideTags[j].size() - c;\n                int interest = min(c, min(a, b));\n                if (interest > bestInterest ||\n                    (interest == bestInterest && c > bestC)) {\n                    bestInterest = interest;\n                    bestC = c;\n                    best = j;\n                }\n            }\n        }\n        for (int j : touched) cnt[j] = 0;\n\n        if (best == -1) {\n            while (ptr < S && used[ptr]) ptr++;\n            if (ptr >= S) break;\n            best = ptr;\n        }\n        used[best] = 1;\n        order.push_back(best);\n        cur = best;\n    }\n\n    // Output\n    string out;\n    out.reserve(order.size() * 16 + 16);\n    out += to_string(order.size());\n    out += '\\n';\n    for (int j : order) {\n        const auto &ph = slidePhotos[j];\n        for (size_t k = 0; k < ph.size(); k++) {\n            if (k) out += ' ';\n            out += to_string(ph[k]);\n        }\n        out += '\\n';\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
