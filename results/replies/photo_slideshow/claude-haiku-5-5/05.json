    "text": "This program builds slides with a greedy pairing of vertical photos, then orders the slides with a budgeted greedy walk over a tag inverted index. It is a heuristic, so it doesn't guarantee the optimal score. I haven't compiled or run it against any data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstatic int interSize(const vector<int>& a, const vector<int>& b) {\n    int i = 0, j = 0, c = 0;\n    while (i < (int)a.size() && j < (int)b.size()) {\n        if (a[i] == b[j]) { c++; i++; j++; }\n        else if (a[i] < b[j]) i++;\n        else j++;\n    }\n    return c;\n}\n\nstatic vector<int> unionTags(const vector<int>& a, const vector<int>& b) {\n    vector<int> r;\n    r.reserve(a.size() + b.size());\n    set_union(a.begin(), a.end(), b.begin(), b.end(), back_inserter(r));\n    return r;\n}\n\nstruct Slide {\n    vector<int> tags;\n    int a, b;  // b == -1 for a horizontal slide\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    if (!(cin >> n)) return 0;\n\n    unordered_map<string, int> tid;\n    vector<char> ori(n);\n    vector<vector<int>> tg(n);\n\n    for (int i = 0; i < n; i++) {\n        int m;\n        cin >> ori[i] >> m;\n        tg[i].reserve(m);\n        for (int k = 0; k < m; k++) {\n            string s;\n            cin >> s;\n            auto it = tid.find(s);\n            int id;\n            if (it == tid.end()) {\n                id = (int)tid.size();\n                tid.emplace(s, id);\n            } else {\n                id = it->second;\n            }\n            tg[i].push_back(id);\n        }\n        sort(tg[i].begin(), tg[i].end());\n        tg[i].erase(unique(tg[i].begin(), tg[i].end()), tg[i].end());\n    }\n\n    vector<int> H, V;\n    for (int i = 0; i < n; i++) {\n        if (ori[i] == 'H') H.push_back(i);\n        else V.push_back(i);\n    }\n\n    vector<Slide> sl;\n    sl.reserve(n);\n    for (int h : H) sl.push_back({tg[h], h, -1});\n\n    // Pair verticals: sort by tag count, then for each vertical pick the\n    // partner within a small forward window that minimizes shared tags.\n    sort(V.begin(), V.end(), [&](int x, int y) {\n        if (tg[x].size() != tg[y].size()) return tg[x].size() < tg[y].size();\n        return x < y;\n    });\n    {\n        const int K = 30;\n        int vs = (int)V.size();\n        vector<char> vu(vs, 0);\n        for (int i = 0; i < vs; i++) {\n            if (vu[i]) continue;\n            vu[i] = 1;\n            int best = -1, bi = INT_MAX, seen = 0;\n            for (int j = i + 1; j < vs && seen < K; j++) {\n                if (vu[j]) continue;\n                seen++;\n                int inter = interSize(tg[V[i]], tg[V[j]]);\n                if (inter < bi) { bi = inter; best = j; }\n            }\n            if (best == -1) break;  // no unused verticals remain\n            vu[best] = 1;\n            sl.push_back({unionTags(tg[V[i]], tg[V[best]]), V[i], V[best]});\n        }\n    }\n\n    int S = (int)sl.size();\n    if (S == 0) {\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    int T = (int)tid.size();\n    vector<vector<int>> post(T);\n    for (int s = 0; s < S; s++)\n        for (int t : sl[s].tags) post[t].push_back(s);\n    vector<int> st(T, 0);\n\n    vector<char> used(S, 0);\n    vector<int> cnt(S, 0);\n    vector<int> touched;\n    touched.reserve(S);\n\n    vector<int> order;\n    order.reserve(S);\n\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n    int fp = 0;  // fallback pointer over unused slides\n\n    for (int step = 1; step < S; step++) {\n        const vector<int>& ct = sl[cur].tags;\n        int t = (int)ct.size();\n        touched.clear();\n        long long budget = 3000;\n\n        for (int tag : ct) {\n            vector<int>& lst = post[tag];\n            int& s0 = st[tag];\n            while (s0 < (int)lst.size() && used[lst[s0]]) s0++;\n            for (int k = s0; k < (int)lst.size() && budget > 0; k++) {\n                budget--;\n                int id = lst[k];\n                if (used[id]) continue;\n                if (cnt[id] == 0) touched.push_back(id);\n                cnt[id]++;\n            }\n        }\n\n        int best = -1, bestF = -1;\n        for (int id : touched) {\n            int c = cnt[id];\n            int s = (int)sl[id].tags.size();\n            int f = min(c, min(t - c, s - c));\n            if (f > bestF) { bestF = f; best = id; }\n        }\n        for (int id : touched) cnt[id] = 0;\n\n        int nxt;\n        if (best != -1) {\n            nxt = best;\n        } else {\n            while (fp < S && used[fp]) fp++;\n            if (fp >= S) break;\n            nxt = fp;\n        }\n        used[nxt] = 1;\n        order.push_back(nxt);\n        cur = nxt;\n    }\n\n    string out;\n    out.reserve(order.size() * 16 + 16);\n    out += to_string(order.size());\n    out += '\\n';\n    for (int idx : order) {\n        const Slide& s = sl[idx];\n        out += to_string(s.a);\n        if (s.b != -1) {\n            out += ' ';\n            out += to_string(s.b);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
