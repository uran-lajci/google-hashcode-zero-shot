    "text": "This is a greedy heuristic, not an optimal solver. It pairs verticals with small tag overlap, then chains slides by greedily picking the next slide with the highest transition interest factor, using bounded inverted-index scans to stay within the time limit. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Slide {\n    vector<int> tags; // sorted unique\n    int a, b;         // b = -1 for horizontal\n};\n\nstatic vector<int> par; // DSU \"next unused\" structure\n\nint findNext(int x) {\n    int r = x;\n    while (par[r] != r) r = par[r];\n    while (par[x] != r) { int nx = par[x]; par[x] = r; x = nx; }\n    return r;\n}\n\nint interCount(const vector<int>& a, const vector<int>& b) {\n    int i = 0, j = 0, c = 0;\n    while (i < (int)a.size() && j < (int)b.size()) {\n        if (a[i] == b[j]) { c++; i++; j++; }\n        else if (a[i] < b[j]) i++;\n        else j++;\n    }\n    return c;\n}\n\nvector<int> unionTags(const vector<int>& a, const vector<int>& b) {\n    vector<int> r;\n    set_union(a.begin(), a.end(), b.begin(), b.end(), back_inserter(r));\n    return r;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N;\n    cin >> N;\n    vector<char> ori(N);\n    vector<vector<int>> tg(N);\n    unordered_map<string, int> tmap;\n    tmap.reserve(1 << 18);\n\n    for (int i = 0; i < N; i++) {\n        string o;\n        int m;\n        cin >> o >> m;\n        ori[i] = o[0];\n        tg[i].reserve(m);\n        for (int k = 0; k < m; k++) {\n            string t;\n            cin >> t;\n            auto it = tmap.find(t);\n            int id;\n            if (it == tmap.end()) {\n                id = (int)tmap.size();\n                tmap.emplace(t, id);\n            } else {\n                id = it->second;\n            }\n            tg[i].push_back(id);\n        }\n        sort(tg[i].begin(), tg[i].end());\n        tg[i].erase(unique(tg[i].begin(), tg[i].end()), tg[i].end());\n    }\n    int numTags = (int)tmap.size();\n\n    vector<Slide> slides;\n    vector<int> H, V;\n    for (int i = 0; i < N; i++) {\n        if (ori[i] == 'H') H.push_back(i);\n        else V.push_back(i);\n    }\n\n    for (int h : H) {\n        slides.push_back({tg[h], h, -1});\n    }\n\n    // Pair verticals greedily: each vertical picks, among the next K unused\n    // verticals (sorted by tag count desc), the one with fewest shared tags.\n    sort(V.begin(), V.end(), [&](int x, int y) {\n        if (tg[x].size() != tg[y].size()) return tg[x].size() > tg[y].size();\n        return x < y;\n    });\n    int VN = (int)V.size();\n    vector<char> usedV(VN, 0);\n    par.assign(VN + 1, 0);\n    for (int i = 0; i <= VN; i++) par[i] = i;\n    const int K = 30;\n\n    // mark used helper: remove position p from DSU\n    auto removePos = [&](int p) {\n        usedV[p] = 1;\n        par[p] = p + 1;\n    };\n\n    for (int i = 0; i < VN; i++) {\n        if (usedV[i]) continue;\n        removePos(i);\n        int best = -1, bestInter = INT_MAX;\n        int seen = 0;\n        int j = findNext(i + 1);\n        while (j < VN && seen < K) {\n            seen++;\n            int inter = interCount(tg[V[i]], tg[V[j]]);\n            if (inter < bestInter) {\n                bestInter = inter;\n                best = j;\n            }\n            j = findNext(j + 1);\n        }\n        if (best != -1) {\n            removePos(best);\n            int a = V[i], b = V[best];\n            slides.push_back({unionTags(tg[a], tg[b]), a, b});\n        }\n        // unpaired vertical cannot be used alone; dropped\n    }\n\n    int S = (int)slides.size();\n    if (S == 0) {\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    // Inverted index\n    vector<vector<int>> post(numTags);\n    for (int s = 0; s < S; s++)\n        for (int t : slides[s].tags) post[t].push_back(s);\n\n    vector<char> used(S, 0);\n    vector<int> cnt(S, 0);\n    vector<int> touched;\n    touched.reserve(1024);\n    vector<int> seq;\n    seq.reserve(S);\n\n    int cur = 0;\n    used[cur] = 1;\n    seq.push_back(cur);\n    int fp = 0;\n    const int PERTAG = 200;\n    const int TOTAL = 5000;\n\n    while ((int)seq.size() < S) {\n        int budget = TOTAL;\n        int curSize = (int)slides[cur].tags.size();\n        for (int t : slides[cur].tags) {\n            vector<int>& L = post[t];\n            size_t i = 0;\n            int scanned = 0;\n            while (i < L.size() && scanned < PERTAG && budget > 0) {\n                int s = L[i];\n                if (used[s]) {\n                    L[i] = L.back();\n                    L.pop_back();\n                    continue;\n                }\n                scanned++;\n                budget--;\n                if (cnt[s] == 0) touched.push_back(s);\n                cnt[s]++;\n                i++;\n            }\n            if (budget <= 0) break;\n        }\n\n        int best = -1, bestv = 0;\n        for (int s : touched) {\n            int c = cnt[s];\n            int v = min(c, min(curSize - c, (int)slides[s].tags.size() - c));\n            if (v > bestv) {\n                bestv = v;\n                best = s;\n            } else if (v == bestv && best != -1 && s < best) {\n                best = s;\n            }\n        }\n        for (int s : touched) cnt[s] = 0;\n        touched.clear();\n\n        if (best == -1) {\n            while (fp < S && used[fp]) fp++;\n            best = fp;\n        }\n        used[best] = 1;\n        seq.push_back(best);\n        cur = best;\n    }\n\n    string out;\n    out.reserve(S * 16);\n    out += to_string(S);\n    out += '\\n';\n    for (int s : seq) {\n        out += to_string(slides[s].a);\n        if (slides[s].b != -1) {\n            out += ' ';\n            out += to_string(slides[s].b);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
