    "text": "This is a heuristic, not an exact solver: it pairs vertical photos by tag count, then builds the slideshow greedily, always moving to the unused slide with the highest transition interest factor. Candidates come from a capped scan of the inverted index, so it stays within the time limit on the largest inputs. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N;\n    cin >> N;\n    unordered_map<string, int> tagId;\n    vector<char> orient(N);\n    vector<vector<int>> ptags(N);\n\n    for (int i = 0; i < N; i++) {\n        string o;\n        int m;\n        cin >> o >> m;\n        orient[i] = o[0];\n        for (int j = 0; j < m; j++) {\n            string t;\n            cin >> t;\n            auto it = tagId.find(t);\n            int id;\n            if (it == tagId.end()) {\n                id = (int)tagId.size();\n                tagId.emplace(t, id);\n            } else {\n                id = it->second;\n            }\n            ptags[i].push_back(id);\n        }\n        sort(ptags[i].begin(), ptags[i].end());\n        ptags[i].erase(unique(ptags[i].begin(), ptags[i].end()), ptags[i].end());\n    }\n    int numTags = (int)tagId.size();\n\n    // Build slides.\n    vector<vector<int>> stags;\n    vector<vector<int>> sphotos;\n    vector<int> H, V;\n    for (int i = 0; i < N; i++) {\n        if (orient[i] == 'H') H.push_back(i);\n        else V.push_back(i);\n    }\n    for (int h : H) {\n        stags.push_back(ptags[h]);\n        sphotos.push_back({h});\n    }\n    sort(V.begin(), V.end(), [&](int a, int b) {\n        if (ptags[a].size() != ptags[b].size()) return ptags[a].size() > ptags[b].size();\n        return a < b;\n    });\n    for (size_t i = 0; i + 1 < V.size(); i += 2) {\n        int a = V[i], b = V[i + 1];\n        vector<int> u;\n        set_union(ptags[a].begin(), ptags[a].end(), ptags[b].begin(), ptags[b].end(),\n                  back_inserter(u));\n        stags.push_back(u);\n        sphotos.push_back({a, b});\n    }\n\n    int S = (int)stags.size();\n    if (S == 0) {\n        // No slide possible (cannot happen under constraints with N>=1 unless only one V).\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    // Inverted index.\n    vector<vector<int>> post(numTags);\n    for (int s = 0; s < S; s++)\n        for (int t : stags[s]) post[t].push_back(s);\n    vector<int> ptr(numTags, 0);\n\n    const int L = 200;\n    vector<char> used(S, 0);\n    vector<int> cnt(S, 0);\n    vector<int> touched;\n    vector<int> order;\n    order.reserve(S);\n\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n    int gp = 0;\n\n    for (int step = 1; step < S; step++) {\n        touched.clear();\n        const vector<int>& ct = stags[cur];\n        int csz = (int)ct.size();\n        for (int t : ct) {\n            auto& pl = post[t];\n            int &p = ptr[t];\n            while (p < (int)pl.size() && used[pl[p]]) p++;\n            int end = min((int)pl.size(), p + L);\n            for (int k = p; k < end; k++) {\n                int s = pl[k];\n                if (used[s]) continue;\n                if (cnt[s] == 0) touched.push_back(s);\n                cnt[s]++;\n            }\n        }\n\n        int best = -1, bestVal = 0;\n        for (int s : touched) {\n            int c = cnt[s];\n            int ssz = (int)stags[s].size();\n            int val = min(c, min(csz - c, ssz - c));\n            if (val > bestVal) {\n                bestVal = val;\n                best = s;\n            }\n        }\n        for (int s : touched) cnt[s] = 0;\n\n        int nxt;\n        if (best >= 0) {\n            nxt = best;\n        } else {\n            while (gp < S && used[gp]) gp++;\n            nxt = gp;\n        }\n        used[nxt] = 1;\n        order.push_back(nxt);\n        cur = nxt;\n    }\n\n    string out;\n    out.reserve((size_t)S * 16);\n    out += to_string(order.size());\n    out += '\\n';\n    for (int s : order) {\n        for (size_t k = 0; k < sphotos[s].size(); k++) {\n            if (k) out += ' ';\n            out += to_string(sphotos[s][k]);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
