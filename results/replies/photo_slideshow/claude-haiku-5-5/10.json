    "text": "This is a greedy solver. It pairs vertical photos by similar tag count, then builds the slideshow one slide at a time. For each step it takes a capped set of unused candidates from a tag-to-slide index, scores each by the interest factor, and picks the best. It is deterministic and uses only the standard library. I have not compiled or run it against real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Slide {\n    vector<int> tags;  // sorted unique tag ids\n    int p1, p2;        // photo ids; p2 = -1 for horizontal\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N;\n    cin >> N;\n    vector<char> ori(N);\n    vector<vector<int>> tg(N);\n    unordered_map<string, int> dict;\n    dict.reserve(1 << 20);\n\n    for (int i = 0; i < N; i++) {\n        char c;\n        int m;\n        cin >> c >> m;\n        ori[i] = c;\n        tg[i].reserve(m);\n        for (int k = 0; k < m; k++) {\n            string s;\n            cin >> s;\n            auto it = dict.find(s);\n            int id;\n            if (it == dict.end()) {\n                id = (int)dict.size();\n                dict.emplace(s, id);\n            } else {\n                id = it->second;\n            }\n            tg[i].push_back(id);\n        }\n        sort(tg[i].begin(), tg[i].end());\n        tg[i].erase(unique(tg[i].begin(), tg[i].end()), tg[i].end());\n    }\n    int T = (int)dict.size();\n\n    vector<int> H, V;\n    for (int i = 0; i < N; i++) {\n        if (ori[i] == 'H') H.push_back(i);\n        else V.push_back(i);\n    }\n\n    // Pair verticals with similar tag counts (sorted by size descending).\n    sort(V.begin(), V.end(), [&](int a, int b) {\n        if (tg[a].size() != tg[b].size()) return tg[a].size() > tg[b].size();\n        return a < b;\n    });\n\n    vector<Slide> slides;\n    slides.reserve(H.size() + V.size() / 2 + 1);\n    for (int h : H) {\n        slides.push_back({tg[h], h, -1});\n    }\n    for (size_t k = 0; k + 1 < V.size(); k += 2) {\n        int a = V[k], b = V[k + 1];\n        vector<int> u;\n        u.reserve(tg[a].size() + tg[b].size());\n        set_union(tg[a].begin(), tg[a].end(), tg[b].begin(), tg[b].end(),\n                  back_inserter(u));\n        slides.push_back({u, a, b});\n    }\n\n    int S = (int)slides.size();\n    if (S == 0) {\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    // Inverted index: tag -> slides containing it.\n    vector<vector<int>> lists(T);\n    for (int s = 0; s < S; s++) {\n        for (int t : slides[s].tags) lists[t].push_back(s);\n    }\n\n    // Slides sorted by tag count for fallback.\n    vector<int> bySize(S);\n    for (int s = 0; s < S; s++) bySize[s] = s;\n    sort(bySize.begin(), bySize.end(), [&](int a, int b) {\n        if (slides[a].tags.size() != slides[b].tags.size())\n            return slides[a].tags.size() < slides[b].tags.size();\n        return a < b;\n    });\n    size_t fbPtr = 0;\n\n    vector<char> used(S, 0);\n    vector<int> mark(T, 0);\n    vector<int> seen(S, 0);\n    int stamp = 0;\n    int candStamp = 0;\n\n    vector<int> order;\n    order.reserve(S);\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n\n    const int PER_TAG = 4;\n    const size_t MAX_CAND = 40;\n\n    vector<int> cand;\n    cand.reserve(64);\n\n    while ((int)order.size() < S) {\n        stamp++;\n        const vector<int>& ct = slides[cur].tags;\n        for (int t : ct) mark[t] = stamp;\n\n        candStamp++;\n        cand.clear();\n        for (int t : ct) {\n            vector<int>& L = lists[t];\n            size_t j = 0;\n            int cnt = 0;\n            while (j < L.size() && cnt < PER_TAG) {\n                int s = L[j];\n                if (used[s]) {\n                    L[j] = L.back();\n                    L.pop_back();\n                    continue;\n                }\n                if (seen[s] != candStamp) {\n                    seen[s] = candStamp;\n                    cand.push_back(s);\n                }\n                j++;\n                cnt++;\n            }\n            if (cand.size() >= MAX_CAND) break;\n        }\n\n        if (cand.empty()) {\n            while (fbPtr < bySize.size() && used[bySize[fbPtr]]) fbPtr++;\n            if (fbPtr < bySize.size()) cand.push_back(bySize[fbPtr]);\n            else break;\n        }\n\n        int cs = (int)ct.size();\n        int best = -1;\n        int bestScore = -1;\n        for (int s : cand) {\n            const vector<int>& st = slides[s].tags;\n            int ss = (int)st.size();\n            int c = 0;\n            for (int t : st) if (mark[t] == stamp) c++;\n            int sc = min(c, min(cs - c, ss - c));\n            if (sc > bestScore) {\n                bestScore = sc;\n                best = s;\n            }\n        }\n\n        if (best < 0) break;\n        used[best] = 1;\n        order.push_back(best);\n        cur = best;\n    }\n\n    // Output.\n    string out;\n    out.reserve(order.size() * 14 + 16);\n    out += to_string(order.size());\n    out += '\\n';\n    for (int s : order) {\n        out += to_string(slides[s].p1);\n        if (slides[s].p2 >= 0) {\n            out += ' ';\n            out += to_string(slides[s].p2);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
