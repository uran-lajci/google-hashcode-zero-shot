    "text": "This is a greedy heuristic, not an optimal solver. Vertical photos are paired by sorting on tag count and pairing the smallest with the largest. Slides are then chained greedily: from the current slide, it picks the unused slide that maximizes the interest factor, found via an inverted tag index with a per-step work budget to stay within the time limit. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Slide {\n    vector<int> tags;  // sorted unique tag ids\n    int a;             // first photo id\n    int b;             // second photo id, or -1 if horizontal\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n\n    unordered_map<string, int> tagId;\n    tagId.reserve(1 << 16);\n\n    vector<vector<int>> photoTags(n);\n    vector<char> orient(n);\n\n    for (int i = 0; i < n; ++i) {\n        string o;\n        int m;\n        cin >> o >> m;\n        orient[i] = o[0];\n        photoTags[i].reserve(m);\n        for (int j = 0; j < m; ++j) {\n            string t;\n            cin >> t;\n            auto it = tagId.find(t);\n            int id;\n            if (it == tagId.end()) {\n                id = (int)tagId.size();\n                tagId.emplace(t, id);\n            } else {\n                id = it->second;\n            }\n            photoTags[i].push_back(id);\n        }\n        sort(photoTags[i].begin(), photoTags[i].end());\n        photoTags[i].erase(unique(photoTags[i].begin(), photoTags[i].end()), photoTags[i].end());\n    }\n\n    vector<Slide> slides;\n    vector<int> verts;\n    for (int i = 0; i < n; ++i) {\n        if (orient[i] == 'H') {\n            slides.push_back({photoTags[i], i, -1});\n        } else {\n            verts.push_back(i);\n        }\n    }\n\n    // Pair vertical photos: sort by tag count, pair smallest with largest.\n    stable_sort(verts.begin(), verts.end(), [&](int x, int y) {\n        return photoTags[x].size() < photoTags[y].size();\n    });\n    int V = (int)verts.size();\n    for (int i = 0; i < V / 2; ++i) {\n        int x = verts[i];\n        int y = verts[V - 1 - i];\n        vector<int> u;\n        u.reserve(photoTags[x].size() + photoTags[y].size());\n        set_union(photoTags[x].begin(), photoTags[x].end(),\n                  photoTags[y].begin(), photoTags[y].end(), back_inserter(u));\n        slides.push_back({u, x, y});\n    }\n\n    int S = (int)slides.size();\n    if (S == 0) {\n        // Cannot happen with N >= 1 and at least one photo usable, but be safe.\n        cout << 1 << \"\\n\";\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    int T = (int)tagId.size();\n    vector<vector<int>> post(T);\n    for (int s = 0; s < S; ++s) {\n        for (int t : slides[s].tags) post[t].push_back(s);\n    }\n\n    vector<char> used(S, 0);\n    vector<int> cnt(S, 0);\n    vector<int> touched;\n    touched.reserve(S);\n\n    vector<int> order;\n    order.reserve(S);\n\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n    int fallbackPtr = 0;\n\n    const long long PER_STEP_BUDGET = 4000;\n\n    for (int step = 1; step < S; ++step) {\n        touched.clear();\n        long long budget = PER_STEP_BUDGET;\n        const vector<int>& ct = slides[cur].tags;\n\n        for (int t : ct) {\n            if (budget <= 0) break;\n            vector<int>& p = post[t];\n            size_t i = 0;\n            while (i < p.size() && budget > 0) {\n                int s = p[i];\n                if (used[s]) {\n                    p[i] = p.back();\n                    p.pop_back();\n                    continue;\n                }\n                if (cnt[s] == 0) touched.push_back(s);\n                cnt[s]++;\n                ++i;\n                --budget;\n            }\n        }\n\n        int best = -1;\n        int bestF = -1;\n        int curSize = (int)ct.size();\n        for (int s : touched) {\n            int c = cnt[s];\n            int sz = (int)slides[s].tags.size();\n            int f = min(c, min(curSize - c, sz - c));\n            if (f > bestF) {\n                bestF = f;\n                best = s;\n            }\n            cnt[s] = 0;\n        }\n\n        int chosen;\n        if (best >= 0 && bestF > 0) {\n            chosen = best;\n        } else {\n            while (fallbackPtr < S && used[fallbackPtr]) ++fallbackPtr;\n            chosen = fallbackPtr;\n        }\n\n        used[chosen] = 1;\n        order.push_back(chosen);\n        cur = chosen;\n    }\n\n    string out;\n    out.reserve((size_t)S * 16 + 16);\n    out += to_string(S);\n    out += '\\n';\n    for (int s : order) {\n        out += to_string(slides[s].a);\n        if (slides[s].b >= 0) {\n            out += ' ';\n            out += to_string(slides[s].b);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
