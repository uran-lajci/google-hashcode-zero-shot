    "text": "This is a heuristic solver, not an exact one. It pairs vertical photos to maximize each slide's tag union, then builds the slide order greedily: from the current slide it scores up to 50 candidate slides by the interest factor and takes the best. It has not been compiled or run against real data.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Slide {\n    vector<int> tags;\n    int a, b; // b = -1 for a single horizontal photo\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    cin >> n;\n    vector<char> ori(n);\n    vector<vector<int>> ptags(n);\n    unordered_map<string, int> dict;\n    dict.reserve(1 << 16);\n\n    for (int i = 0; i < n; i++) {\n        char c;\n        int m;\n        cin >> c >> m;\n        ori[i] = c;\n        ptags[i].reserve(m);\n        for (int k = 0; k < m; k++) {\n            string s;\n            cin >> s;\n            auto it = dict.find(s);\n            int id;\n            if (it == dict.end()) {\n                id = (int)dict.size();\n                dict.emplace(s, id);\n            } else {\n                id = it->second;\n            }\n            ptags[i].push_back(id);\n        }\n        sort(ptags[i].begin(), ptags[i].end());\n        ptags[i].erase(unique(ptags[i].begin(), ptags[i].end()), ptags[i].end());\n    }\n    const int T = (int)dict.size();\n\n    vector<int> H, V;\n    for (int i = 0; i < n; i++) {\n        if (ori[i] == 'H') H.push_back(i);\n        else V.push_back(i);\n    }\n\n    vector<Slide> slides;\n    slides.reserve(n);\n    for (int h : H) slides.push_back({ptags[h], h, -1});\n\n    // Pair vertical photos: sort by tag count, pick partner in a window\n    // maximizing the union size (so slide tag sets are richer).\n    sort(V.begin(), V.end(), [&](int x, int y) {\n        if (ptags[x].size() != ptags[y].size()) return ptags[x].size() < ptags[y].size();\n        return x < y;\n    });\n    vector<char> vused(V.size(), 0);\n    vector<int> mk(max(T, 1), 0);\n    int stamp = 0;\n    const int WINDOW = 30;\n    for (size_t i = 0; i < V.size(); i++) {\n        if (vused[i]) continue;\n        stamp++;\n        const vector<int>& A = ptags[V[i]];\n        for (int t : A) mk[t] = stamp;\n        int best = -1, bestU = -1;\n        int considered = 0;\n        for (size_t j = i + 1; j < V.size() && considered < WINDOW; j++) {\n            if (vused[j]) continue;\n            considered++;\n            const vector<int>& B = ptags[V[j]];\n            int common = 0;\n            for (int t : B) if (mk[t] == stamp) common++;\n            int U = (int)A.size() + (int)B.size() - common;\n            if (U > bestU) {\n                bestU = U;\n                best = (int)j;\n            }\n        }\n        if (best >= 0) {\n            vused[i] = vused[best] = 1;\n            vector<int> u = A;\n            for (int t : ptags[V[best]]) u.push_back(t);\n            sort(u.begin(), u.end());\n            u.erase(unique(u.begin(), u.end()), u.end());\n            slides.push_back({u, V[i], V[best]});\n        }\n    }\n\n    const int K = (int)slides.size();\n    if (K == 0) {\n        cout << 0 << \"\\n\";\n        return 0;\n    }\n\n    // Inverted index: tag -> slides containing it\n    vector<vector<int>> inv(max(T, 1));\n    for (int s = 0; s < K; s++)\n        for (int t : slides[s].tags) inv[t].push_back(s);\n\n    vector<char> used(K, 0);\n    vector<int> seen(K, 0);\n    vector<int> mk2(max(T, 1), 0);\n    vector<int> order;\n    order.reserve(K);\n\n    int cur = 0;\n    used[cur] = 1;\n    order.push_back(cur);\n    int remaining = K - 1;\n    int fallback = 0;\n    int step = 0;\n    const size_t C = 50;\n\n    while (remaining > 0) {\n        step++;\n        const Slide& cs = slides[cur];\n        for (int t : cs.tags) mk2[t] = step;\n\n        vector<int> cand;\n        cand.reserve(C);\n        bool full = false;\n        for (int t : cs.tags) {\n            if (full) break;\n            vector<int>& L = inv[t];\n            size_t k = 0;\n            while (k < L.size()) {\n                int s = L[k];\n                if (used[s]) {\n                    L[k] = L.back();\n                    L.pop_back();\n                    continue;\n                }\n                if (seen[s] != step) {\n                    seen[s] = step;\n                    cand.push_back(s);\n                    if (cand.size() >= C) {\n                        full = true;\n                        break;\n                    }\n                }\n                k++;\n            }\n        }\n\n        int best = -1;\n        int bestF = -1;\n        if (!cand.empty()) {\n            for (int s : cand) {\n                const vector<int>& st = slides[s].tags;\n                int common = 0;\n                for (int t : st) if (mk2[t] == step) common++;\n                int sz = (int)st.size();\n                int f = min({common, (int)cs.tags.size() - common, sz - common});\n                if (f > bestF) {\n                    bestF = f;\n                    best = s;\n                }\n            }\n        } else {\n            while (fallback < K && used[fallback]) fallback++;\n            best = fallback;\n        }\n\n        used[best] = 1;\n        order.push_back(best);\n        remaining--;\n        cur = best;\n    }\n\n    string out;\n    out.reserve((size_t)K * 16 + 16);\n    out += to_string(order.size());\n    out += '\\n';\n    for (int s : order) {\n        out += to_string(slides[s].a);\n        if (slides[s].b >= 0) {\n            out += ' ';\n            out += to_string(slides[s].b);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
