    "text": "This is a greedy heuristic, not an optimal solver. It repeatedly picks the router with the best ratio of newly covered targets to cost, where cost is one router plus the backbone cells needed to reach it. Lazy priority-queue evaluation keeps it fast on 1000\u00d71000 grids. I have not compiled or run it against the official data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint H, W, R;\nlong long Pb, Pr, B;\nvector<string> g;\nvector<int> ps;          // 2D prefix sums of wall counts, size (H+1)*(W+1)\nvector<int> dist_;       // king-move distance to backbone\nvector<char> covered;\nvector<int> bfsQ;\n\ninline int PS(int r, int c) { return ps[r * (W + 1) + c]; }\n\n// true if rectangle [r1..r2] x [c1..c2] contains a wall\ninline bool wallRect(int r1, int c1, int r2, int c2) {\n    int s = PS(r2 + 1, c2 + 1) - PS(r1, c2 + 1) - PS(r2 + 1, c1) + PS(r1, c1);\n    return s > 0;\n}\n\n// number of uncovered targets covered by router at (a,b); if apply, mark them covered\nint coverage(int a, int b, bool apply) {\n    int cnt = 0;\n    int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n    int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n    for (int x = x0; x <= x1; x++) {\n        for (int y = y0; y <= y1; y++) {\n            int id = x * W + y;\n            if (g[x][y] != '.' || covered[id]) continue;\n            int r1 = min(a, x), r2 = max(a, x);\n            int c1 = min(b, y), c2 = max(b, y);\n            if (wallRect(r1, c1, r2, c2)) continue;\n            cnt++;\n            if (apply) covered[id] = 1;\n        }\n    }\n    return cnt;\n}\n\n// add cell c to backbone and propagate decreased distances\nvoid addCell(int c) {\n    dist_[c] = 0;\n    bfsQ.clear();\n    bfsQ.push_back(c);\n    size_t head = 0;\n    while (head < bfsQ.size()) {\n        int cur = bfsQ[head++];\n        int cr = cur / W, cc = cur % W;\n        int nd = dist_[cur] + 1;\n        for (int dr = -1; dr <= 1; dr++) {\n            for (int dc = -1; dc <= 1; dc++) {\n                if (dr == 0 && dc == 0) continue;\n                int nr = cr + dr, nc = cc + dc;\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int nid = nr * W + nc;\n                if (dist_[nid] > nd) {\n                    dist_[nid] = nd;\n                    bfsQ.push_back(nid);\n                }\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> H >> W >> R;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    g.resize(H);\n    for (int i = 0; i < H; i++) cin >> g[i];\n\n    ps.assign((H + 1) * (W + 1), 0);\n    for (int i = 0; i < H; i++) {\n        for (int j = 0; j < W; j++) {\n            int w = (g[i][j] == '#') ? 1 : 0;\n            ps[(i + 1) * (W + 1) + (j + 1)] = w + PS(i, j + 1) + PS(i + 1, j) - PS(i, j);\n        }\n    }\n\n    int N = H * W;\n    dist_.assign(N, INT_MAX / 2);\n    covered.assign(N, 0);\n\n    vector<int> backbone;   // cells added to backbone (excluding start)\n    vector<int> routers;\n    long long spent = 0;\n\n    int start = br * W + bc;\n    addCell(start);\n\n    // initial candidates\n    priority_queue<pair<double, int>> pq;\n    for (int i = 0; i < H; i++) {\n        for (int j = 0; j < W; j++) {\n            if (g[i][j] == '#') continue;\n            int id = i * W + j;\n            int gn = coverage(i, j, false);\n            if (gn == 0) continue;\n            double cost = (double)dist_[id] * Pb + Pr;\n            pq.push({(double)gn / cost, id});\n        }\n    }\n\n    while (!pq.empty()) {\n        auto [key, id] = pq.top();\n        pq.pop();\n        int a = id / W, b = id % W;\n        int gn = coverage(a, b, false);\n        if (gn == 0) continue;\n        long long k = dist_[id];\n        long long cost = k * Pb + Pr;\n        if (spent + cost > B) continue;\n        double newKey = (double)gn / (double)cost;\n        if (!pq.empty() && newKey < pq.top().first) {\n            pq.push({newKey, id});\n            continue;\n        }\n\n        // build path from backbone to id\n        vector<int> path;\n        int cur = id;\n        while (dist_[cur] > 0) {\n            path.push_back(cur);\n            int cr = cur / W, cc = cur % W;\n            int nxt = -1;\n            for (int dr = -1; dr <= 1 && nxt < 0; dr++) {\n                for (int dc = -1; dc <= 1 && nxt < 0; dc++) {\n                    if (dr == 0 && dc == 0) continue;\n                    int nr = cr + dr, nc = cc + dc;\n                    if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                    int nid = nr * W + nc;\n                    if (dist_[nid] == dist_[cur] - 1) { nxt = nid; }\n                }\n            }\n            cur = nxt;\n        }\n        reverse(path.begin(), path.end());\n        for (int c : path) {\n            addCell(c);\n            backbone.push_back(c);\n        }\n        spent += k * Pb;\n\n        // place router\n        routers.push_back(id);\n        spent += Pr;\n        coverage(a, b, true);\n    }\n\n    // output\n    ostringstream out;\n    out << backbone.size() << \"\\n\";\n    for (int c : backbone) out << c / W << \" \" << c % W << \"\\n\";\n    out << routers.size() << \"\\n\";\n    for (int c : routers) out << c / W << \" \" << c % W << \"\\n\";\n    cout << out.str();\n    return 0;\n}\n```",
