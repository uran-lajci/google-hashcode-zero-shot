    "text": "This is a greedy heuristic, not an optimal solver. It repeatedly picks the router with the best ratio of newly covered targets to its cost, where cost is the router price plus the backbone cells needed to reach it. Routers and backbone cells are added until no affordable router adds coverage. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int H, W, R;\n    cin >> H >> W >> R;\n    long long Pb, Pr, B;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    vector<string> g(H);\n    for (int i = 0; i < H; i++) cin >> g[i];\n\n    const int n = H * W;\n    const int INF = INT_MAX / 2;\n    const int S = W + 1;\n\n    // 2D prefix sums for walls and targets\n    vector<int> wps((H + 1) * S, 0), tps((H + 1) * S, 0);\n    for (int r = 0; r < H; r++) {\n        for (int c = 0; c < W; c++) {\n            int w = (g[r][c] == '#');\n            int t = (g[r][c] == '.');\n            wps[(r + 1) * S + c + 1] = wps[r * S + c + 1] + wps[(r + 1) * S + c] - wps[r * S + c] + w;\n            tps[(r + 1) * S + c + 1] = tps[r * S + c + 1] + tps[(r + 1) * S + c] - tps[r * S + c] + t;\n        }\n    }\n    auto rc = [&](const vector<int>& ps, int r1, int c1, int r2, int c2) -> int {\n        return ps[(r2 + 1) * S + (c2 + 1)] - ps[r1 * S + (c2 + 1)] - ps[(r2 + 1) * S + c1] + ps[r1 * S + c1];\n    };\n\n    vector<char> covered(n, 0), isR(n, 0);\n\n    // Count uncovered targets a router at (a,b) would newly cover\n    auto gainOf = [&](int a, int b) -> int {\n        int cnt = 0;\n        int r1 = max(0, a - R), r2 = min(H - 1, a + R);\n        int c1 = max(0, b - R), c2 = min(W - 1, b + R);\n        for (int x = r1; x <= r2; x++)\n            for (int y = c1; y <= c2; y++) {\n                int id = x * W + y;\n                if (g[x][y] != '.' || covered[id]) continue;\n                if (rc(wps, min(a, x), min(b, y), max(a, x), max(b, y)) == 0) cnt++;\n            }\n        return cnt;\n    };\n    auto applyCover = [&](int a, int b) {\n        int r1 = max(0, a - R), r2 = min(H - 1, a + R);\n        int c1 = max(0, b - R), c2 = min(W - 1, b + R);\n        for (int x = r1; x <= r2; x++)\n            for (int y = c1; y <= c2; y++) {\n                int id = x * W + y;\n                if (g[x][y] != '.' || covered[id]) continue;\n                if (rc(wps, min(a, x), min(b, y), max(a, x), max(b, y)) == 0) covered[id] = 1;\n            }\n    };\n\n    // Distance (number of new backbone cells needed) from current backbone\n    vector<int> dist(n, INF);\n    int dr8[8] = {-1, -1, -1, 0, 0, 1, 1, 1};\n    int dc8[8] = {-1, 0, 1, -1, 1, -1, 0, 1};\n    {\n        vector<int> q;\n        q.reserve(n);\n        int s = br * W + bc;\n        dist[s] = 0;\n        q.push_back(s);\n        for (size_t h = 0; h < q.size(); h++) {\n            int cur = q[h];\n            int r = cur / W, c = cur % W;\n            for (int k = 0; k < 8; k++) {\n                int nr = r + dr8[k], nc = c + dc8[k];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int nb = nr * W + nc;\n                if (dist[nb] > dist[cur] + 1) {\n                    dist[nb] = dist[cur] + 1;\n                    q.push_back(nb);\n                }\n            }\n        }\n    }\n\n    // Initial candidate heap with upper-bound keys\n    priority_queue<pair<double, int>> pq;\n    for (int idx = 0; idx < n; idx++) {\n        int a = idx / W, b = idx % W;\n        if (g[a][b] == '#') continue;\n        int r1 = max(0, a - R), r2 = min(H - 1, a + R);\n        int c1 = max(0, b - R), c2 = min(W - 1, b + R);\n        int ub = rc(tps, r1, c1, r2, c2);\n        if (ub > 0) pq.push({ub / (double)Pr, idx});\n    }\n\n    long long remaining = B;\n    vector<int> outB;     // backbone cells added, in valid connection order\n    vector<int> routers;\n\n    while (!pq.empty()) {\n        auto top = pq.top();\n        pq.pop();\n        int idx = top.second;\n        if (isR[idx]) continue;\n        int a = idx / W, b = idx % W;\n        if (g[a][b] == '#') continue;\n        int d = dist[idx];\n        long long cost = (long long)d * Pb + Pr;\n        if (cost > remaining) continue;\n        int gain = gainOf(a, b);\n        if (gain == 0) continue;\n        double ratio = (double)gain / (double)cost;\n        if (!pq.empty() && ratio < pq.top().first) {\n            pq.push({ratio, idx});\n            continue;\n        }\n\n        // Build path from backbone to idx\n        vector<int> path;\n        int cur = idx;\n        while (dist[cur] > 0) {\n            path.push_back(cur);\n            int cr = cur / W, cc = cur % W;\n            int nxt = -1;\n            for (int k = 0; k < 8; k++) {\n                int nr = cr + dr8[k], nc = cc + dc8[k];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int nb = nr * W + nc;\n                if (dist[nb] == dist[cur] - 1) { nxt = nb; break; }\n            }\n            cur = nxt;\n        }\n        // Commit path cells as backbone (reverse so that each cell follows its neighbor)\n        vector<int> sources;\n        for (int i = (int)path.size() - 1; i >= 0; i--) {\n            int p = path[i];\n            dist[p] = 0;\n            outB.push_back(p);\n            sources.push_back(p);\n        }\n        // Propagate distance decreases from new backbone cells\n        {\n            vector<int> q = sources;\n            for (size_t h = 0; h < q.size(); h++) {\n                int c0 = q[h];\n                int r = c0 / W, c = c0 % W;\n                for (int k = 0; k < 8; k++) {\n                    int nr = r + dr8[k], nc = c + dc8[k];\n                    if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                    int nb = nr * W + nc;\n                    if (dist[nb] > dist[c0] + 1) {\n                        dist[nb] = dist[c0] + 1;\n                        q.push_back(nb);\n                    }\n                }\n            }\n        }\n\n        // Place router\n        isR[idx] = 1;\n        routers.push_back(idx);\n        remaining -= cost;\n        applyCover(a, b);\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(outB.size()) + \"\\n\";\n    for (int id : outB) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (int id : routers) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    cout << out;\n    return 0;\n}\n```",
