    "text": "This is a greedy heuristic with lazy evaluation, not a proven optimum. It repeatedly picks the router with the best ratio of newly covered targets to cost, where cost includes the backbone cells needed to reach it. Coverage checks use 2D prefix sums of walls, and backbone distances are maintained incrementally. I have not compiled or run it against the official data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint H, W, R;\nlong long Pb, Pr, B;\nvector<string> G;\nvector<int> P;      // 2D prefix sums of walls, (H+1)x(W+1)\nvector<char> covered;\nvector<int> dist_;\nconst int INF = INT_MAX / 2;\n\ninline int rectWalls(int r1, int c1, int r2, int c2) {\n    int W1 = W + 1;\n    return P[(r2 + 1) * W1 + (c2 + 1)] - P[r1 * W1 + (c2 + 1)]\n         - P[(r2 + 1) * W1 + c1] + P[r1 * W1 + c1];\n}\n\ninline bool visible(int a, int b, int x, int y) {\n    return rectWalls(min(a, x), min(b, y), max(a, x), max(b, y)) == 0;\n}\n\nlong long gainOf(int p) {\n    int a = p / W, b = p % W;\n    long long cnt = 0;\n    for (int x = max(0, a - R); x <= min(H - 1, a + R); ++x)\n        for (int y = max(0, b - R); y <= min(W - 1, b + R); ++y) {\n            if (G[x][y] != '.') continue;\n            int id = x * W + y;\n            if (covered[id]) continue;\n            if (visible(a, b, x, y)) ++cnt;\n        }\n    return cnt;\n}\n\nvoid markCovered(int p) {\n    int a = p / W, b = p % W;\n    for (int x = max(0, a - R); x <= min(H - 1, a + R); ++x)\n        for (int y = max(0, b - R); y <= min(W - 1, b + R); ++y) {\n            if (G[x][y] != '.') continue;\n            int id = x * W + y;\n            if (covered[id]) continue;\n            if (visible(a, b, x, y)) covered[id] = 1;\n        }\n}\n\nstatic const int DR[8] = {-1, -1, -1, 0, 0, 1, 1, 1};\nstatic const int DC[8] = {-1, 0, 1, -1, 1, -1, 0, 1};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> H >> W >> R;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    G.resize(H);\n    for (int i = 0; i < H; ++i) cin >> G[i];\n\n    P.assign((H + 1) * (W + 1), 0);\n    for (int r = 0; r < H; ++r)\n        for (int c = 0; c < W; ++c) {\n            int w = (G[r][c] == '#') ? 1 : 0;\n            P[(r + 1) * (W + 1) + (c + 1)] = P[r * (W + 1) + (c + 1)]\n                + P[(r + 1) * (W + 1) + c] - P[r * (W + 1) + c] + w;\n        }\n\n    int N = H * W;\n    covered.assign(N, 0);\n    dist_.assign(N, INF);\n\n    // Initial BFS from the backbone cell (unit cost per non-backbone cell)\n    int init = br * W + bc;\n    dist_[init] = 0;\n    {\n        vector<int> q;\n        q.reserve(N);\n        q.push_back(init);\n        size_t head = 0;\n        while (head < q.size()) {\n            int c = q[head++];\n            int r = c / W, cc = c % W;\n            for (int d = 0; d < 8; ++d) {\n                int nr = r + DR[d], nc = cc + DC[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int n = nr * W + nc;\n                if (dist_[n] > dist_[c] + 1) {\n                    dist_[n] = dist_[c] + 1;\n                    q.push_back(n);\n                }\n            }\n        }\n    }\n\n    vector<int> bbOrder;   // backbone cells added (excluding initial), valid order\n    vector<int> routers;\n    long long rem = B;\n\n    // Initial candidate heap\n    priority_queue<pair<double, int>> pq;\n    for (int p = 0; p < N; ++p) {\n        int r = p / W, c = p % W;\n        if (G[r][c] == '#') continue;\n        if (dist_[p] >= INF) continue;\n        long long cost = (long long)dist_[p] * Pb + Pr;\n        if (cost > rem) continue;\n        long long g = gainOf(p);\n        if (g <= 0) continue;\n        pq.push({(double)g / (double)cost, p});\n    }\n\n    while (!pq.empty()) {\n        auto [key, p] = pq.top();\n        pq.pop();\n        if (dist_[p] >= INF) continue;\n        long long cost = (long long)dist_[p] * Pb + Pr;\n        if (cost > rem) continue;\n        long long g = gainOf(p);\n        if (g <= 0) continue;\n        double nk = (double)g / (double)cost;\n        if (!pq.empty() && nk < pq.top().first) {\n            pq.push({nk, p});\n            continue;\n        }\n\n        // Accept: build path from p back to backbone\n        vector<int> path;\n        int cur = p;\n        while (dist_[cur] > 0) {\n            path.push_back(cur);\n            int r = cur / W, c = cur % W;\n            int nxt = -1;\n            for (int d = 0; d < 8; ++d) {\n                int nr = r + DR[d], nc = c + DC[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int n = nr * W + nc;\n                if (dist_[n] == dist_[cur] - 1) { nxt = n; break; }\n            }\n            cur = nxt;\n        }\n        for (int i = (int)path.size() - 1; i >= 0; --i) {\n            dist_[path[i]] = 0;\n            bbOrder.push_back(path[i]);\n        }\n        // Propagate decreased distances\n        {\n            vector<int> q(path.begin(), path.end());\n            size_t head = 0;\n            while (head < q.size()) {\n                int c = q[head++];\n                int r = c / W, cc = c % W;\n                for (int d = 0; d < 8; ++d) {\n                    int nr = r + DR[d], nc = cc + DC[d];\n                    if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                    int n = nr * W + nc;\n                    if (dist_[n] > dist_[c] + 1) {\n                        dist_[n] = dist_[c] + 1;\n                        q.push_back(n);\n                    }\n                }\n            }\n        }\n\n        rem -= cost;\n        routers.push_back(p);\n        markCovered(p);\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(bbOrder.size()) + \"\\n\";\n    for (int id : bbOrder) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (int id : routers) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    cout << out;\n    return 0;\n}\n```",
