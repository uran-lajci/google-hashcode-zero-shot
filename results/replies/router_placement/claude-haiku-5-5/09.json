    "text": "This is a greedy heuristic, not an optimal solver. Each step picks the uncovered-target gain per unit cost, where the cost includes the backbone cells needed to reach the router. It always keeps the output valid, but it may not reach the best possible score.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint H, W, R;\nlong long Pb, Pr, B;\nvector<string> grid;\nvector<int> ps;\nvector<char> covered;\n\ninline int S(int r, int c) { return ps[r * (W + 1) + c]; }\n\ninline int rectWalls(int r1, int c1, int r2, int c2) {\n    return S(r2 + 1, c2 + 1) - S(r1, c2 + 1) - S(r2 + 1, c1) + S(r1, c1);\n}\n\n// Count uncovered targets covered by a router at (a,b)\nint gainOf(int a, int b) {\n    int cnt = 0;\n    int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n    int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n    for (int x = x0; x <= x1; x++) {\n        for (int y = y0; y <= y1; y++) {\n            if (grid[x][y] != '.') continue;\n            if (covered[x * W + y]) continue;\n            if (rectWalls(min(a, x), min(b, y), max(a, x), max(b, y)) != 0) continue;\n            cnt++;\n        }\n    }\n    return cnt;\n}\n\nvoid markCovered(int a, int b) {\n    int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n    int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n    for (int x = x0; x <= x1; x++) {\n        for (int y = y0; y <= y1; y++) {\n            if (grid[x][y] != '.') continue;\n            if (rectWalls(min(a, x), min(b, y), max(a, x), max(b, y)) != 0) continue;\n            covered[x * W + y] = 1;\n        }\n    }\n}\n\nint main() {\n    auto startTime = chrono::steady_clock::now();\n    cin >> H >> W >> R;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    grid.resize(H);\n    for (int i = 0; i < H; i++) cin >> grid[i];\n\n    ps.assign((H + 1) * (W + 1), 0);\n    for (int r = 0; r < H; r++) {\n        for (int c = 0; c < W; c++) {\n            ps[(r + 1) * (W + 1) + (c + 1)] = ps[r * (W + 1) + (c + 1)] + ps[(r + 1) * (W + 1) + c]\n                - ps[r * (W + 1) + c] + (grid[r][c] == '#' ? 1 : 0);\n        }\n    }\n\n    int HW = H * W;\n    covered.assign(HW, 0);\n    vector<char> conn(HW, 0), isRouter(HW, 0);\n    vector<int> g(HW, -1);\n    vector<int> dist(HW), par(HW);\n    vector<pair<int,int>> backbone;   // cells connected (excluding start)\n    vector<pair<int,int>> routers;\n    long long spent = 0;              // Pb*N + Pr*M\n\n    int startIdx = br * W + bc;\n    conn[startIdx] = 1;\n\n    const int dr[8] = {-1,-1,-1,0,0,1,1,1};\n    const int dc[8] = {-1,0,1,-1,1,-1,0,1};\n\n    bool timeUp = false;\n    while (true) {\n        auto now = chrono::steady_clock::now();\n        if (chrono::duration<double>(now - startTime).count() > 8.5) break;\n\n        // Multi-source BFS from backbone\n        fill(dist.begin(), dist.end(), -1);\n        vector<int> q;\n        q.reserve(HW);\n        for (int v = 0; v < HW; v++) {\n            if (conn[v]) { dist[v] = 0; q.push_back(v); }\n        }\n        for (size_t qi = 0; qi < q.size(); qi++) {\n            int u = q[qi];\n            int ur = u / W, uc = u % W;\n            for (int d = 0; d < 8; d++) {\n                int nr = ur + dr[d], nc = uc + dc[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int w = nr * W + nc;\n                if (dist[w] >= 0) continue;\n                dist[w] = dist[u] + 1;\n                par[w] = u;\n                q.push_back(w);\n            }\n        }\n\n        bool done = false;\n        int bestV = -1;\n        while (true) {\n            bestV = -1;\n            long long bestG = 0, bestC = 1;\n            for (int r = 0; r < H; r++) {\n                for (int c = 0; c < W; c++) {\n                    int v = r * W + c;\n                    if (grid[r][c] == '#') continue;\n                    if (isRouter[v]) continue;\n                    if (dist[v] < 0) continue;\n                    long long cost = Pr + Pb * dist[v];\n                    if (spent + cost > B) continue;\n                    if (g[v] < 0) g[v] = gainOf(r, c);\n                    if (g[v] <= 0) continue;\n                    if (bestV < 0 || (long long)g[v] * bestC > bestG * cost) {\n                        bestV = v;\n                        bestG = g[v];\n                        bestC = cost;\n                    }\n                }\n            }\n            if (bestV < 0) { done = true; break; }\n            int ex = gainOf(bestV / W, bestV % W);\n            if (ex == (int)bestG) break;\n            g[bestV] = ex;\n        }\n        if (done) break;\n\n        // Place router at bestV, connect path\n        int a = bestV / W, b = bestV % W;\n        markCovered(a, b);\n        vector<int> path;\n        int cur = bestV;\n        while (dist[cur] > 0) {\n            path.push_back(cur);\n            cur = par[cur];\n        }\n        reverse(path.begin(), path.end());\n        for (int v : path) {\n            conn[v] = 1;\n            backbone.push_back({v / W, v % W});\n            spent += Pb;\n        }\n        isRouter[bestV] = 1;\n        routers.push_back({a, b});\n        spent += Pr;\n        g[bestV] = 0;\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(backbone.size()) + \"\\n\";\n    for (auto &p : backbone) {\n        out += to_string(p.first) + \" \" + to_string(p.second) + \"\\n\";\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (auto &p : routers) {\n        out += to_string(p.first) + \" \" + to_string(p.second) + \"\\n\";\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
