    "text": "This is a greedy heuristic, not an optimal solver. It repeatedly picks the router with the best ratio of newly covered target cells to connection cost, using lazy priority-queue evaluation. It connects each router to the backbone by a shortest path of new cells, and it only accepts a router if the budget covers it. I haven't compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int H, W, R;\n    cin >> H >> W >> R;\n    long long Pb, Pr, B;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n\n    vector<string> grid(H);\n    for (int i = 0; i < H; i++) cin >> grid[i];\n\n    int N = H * W;\n    vector<char> wall(N, 0), tgt(N, 0);\n    for (int r = 0; r < H; r++)\n        for (int c = 0; c < W; c++) {\n            char ch = grid[r][c];\n            if (ch == '#') wall[r * W + c] = 1;\n            else if (ch == '.') tgt[r * W + c] = 1;\n        }\n\n    // 2D prefix sums of walls\n    int PW = W + 1;\n    vector<int> P((H + 1) * (W + 1), 0);\n    for (int r = 0; r < H; r++)\n        for (int c = 0; c < W; c++)\n            P[(r + 1) * PW + (c + 1)] = P[r * PW + (c + 1)] + P[(r + 1) * PW + c]\n                                        - P[r * PW + c] + wall[r * W + c];\n\n    auto rectWall = [&](int r1, int c1, int r2, int c2) -> bool {\n        int s = P[(r2 + 1) * PW + (c2 + 1)] - P[r1 * PW + (c2 + 1)]\n              - P[(r2 + 1) * PW + c1] + P[r1 * PW + c1];\n        return s > 0;\n    };\n\n    vector<char> covered(N, 0), conn(N, 0), isRouter(N, 0);\n    vector<int> dist(N, -1);\n\n    int dr8[8] = {-1, -1, -1, 0, 0, 1, 1, 1};\n    int dc8[8] = {-1, 0, 1, -1, 1, -1, 0, 1};\n\n    auto gainOf = [&](int a, int b) -> int {\n        int cnt = 0;\n        int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n        int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n        for (int x = x0; x <= x1; x++)\n            for (int y = y0; y <= y1; y++) {\n                int id = x * W + y;\n                if (tgt[id] && !covered[id] &&\n                    !rectWall(min(a, x), min(b, y), max(a, x), max(b, y)))\n                    cnt++;\n            }\n        return cnt;\n    };\n\n    auto applyCover = [&](int a, int b) {\n        int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n        int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n        for (int x = x0; x <= x1; x++)\n            for (int y = y0; y <= y1; y++) {\n                int id = x * W + y;\n                if (tgt[id] && !covered[id] &&\n                    !rectWall(min(a, x), min(b, y), max(a, x), max(b, y)))\n                    covered[id] = 1;\n            }\n    };\n\n    auto recomputeDist = [&]() {\n        fill(dist.begin(), dist.end(), -1);\n        vector<int> q;\n        q.reserve(N);\n        for (int i = 0; i < N; i++)\n            if (conn[i]) { dist[i] = 0; q.push_back(i); }\n        size_t qi = 0;\n        while (qi < q.size()) {\n            int u = q[qi++];\n            int ur = u / W, uc = u % W;\n            for (int d = 0; d < 8; d++) {\n                int nr = ur + dr8[d], nc = uc + dc8[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int v = nr * W + nc;\n                if (dist[v] == -1) {\n                    dist[v] = dist[u] + 1;\n                    q.push_back(v);\n                }\n            }\n        }\n    };\n\n    vector<int> par(N, -1), stamp(N, 0);\n    int curStamp = 0;\n    // Shortest path of unconnected cells from c to the backbone, ordered from the\n    // cell adjacent to the backbone outward to c.\n    auto findPath = [&](int c) -> vector<int> {\n        curStamp++;\n        vector<int> q;\n        q.push_back(c);\n        stamp[c] = curStamp;\n        par[c] = -1;\n        size_t qi = 0;\n        while (qi < q.size()) {\n            int u = q[qi++];\n            int ur = u / W, uc = u % W;\n            bool found = false;\n            for (int d = 0; d < 8 && !found; d++) {\n                int nr = ur + dr8[d], nc = uc + dc8[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                if (conn[nr * W + nc]) found = true;\n            }\n            if (found) {\n                vector<int> path;\n                for (int x = u; x != -1; x = par[x]) path.push_back(x);\n                return path;\n            }\n            for (int d = 0; d < 8; d++) {\n                int nr = ur + dr8[d], nc = uc + dc8[d];\n                if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                int v = nr * W + nc;\n                if (stamp[v] == curStamp) continue;\n                stamp[v] = curStamp;\n                par[v] = u;\n                q.push_back(v);\n            }\n        }\n        return {};\n    };\n\n    int start = br * W + bc;\n    conn[start] = 1;\n    recomputeDist();\n\n    // Initial candidate queue\n    priority_queue<pair<double, int>> pq;\n    for (int id = 0; id < N; id++) {\n        if (wall[id]) continue;\n        if (dist[id] < 0) continue;\n        int g = gainOf(id / W, id % W);\n        if (g <= 0) continue;\n        double key = (double)g / (double)(Pr + Pb * dist[id]);\n        pq.push({key, id});\n    }\n\n    vector<pair<int, int>> outCells;\n    vector<pair<int, int>> routers;\n    long long spent = 0;\n    int accepts = 0;\n\n    while (!pq.empty()) {\n        auto top = pq.top();\n        pq.pop();\n        int c = top.second;\n        if (isRouter[c] || wall[c]) continue;\n        int a = c / W, b = c % W;\n        int g = gainOf(a, b);\n        if (g <= 0) continue;\n        if (dist[c] < 0) continue;\n        double ratio = (double)g / (double)(Pr + Pb * dist[c]);\n        if (!pq.empty() && ratio < pq.top().first) {\n            pq.push({ratio, c});\n            continue;\n        }\n\n        vector<int> path;\n        if (!conn[c]) {\n            path = findPath(c);\n            if (path.empty()) continue;\n        }\n        long long cost = (long long)path.size() * Pb + Pr;\n        if (spent + cost > B) continue;\n\n        spent += cost;\n        for (int x : path) {\n            conn[x] = 1;\n            outCells.push_back({x / W, x % W});\n        }\n        isRouter[c] = 1;\n        routers.push_back({a, b});\n        applyCover(a, b);\n\n        accepts++;\n        if (accepts % 32 == 0) recomputeDist();\n    }\n\n    // Output\n    string out;\n    out.reserve(outCells.size() * 12 + routers.size() * 12 + 32);\n    out += to_string(outCells.size()) + \"\\n\";\n    for (auto& p : outCells) {\n        out += to_string(p.first);\n        out += ' ';\n        out += to_string(p.second);\n        out += '\\n';\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (auto& p : routers) {\n        out += to_string(p.first);\n        out += ' ';\n        out += to_string(p.second);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
