    "text": "This is a greedy heuristic, not an exact solver. It repeatedly picks the router with the best marginal score (1000 \u00d7 newly covered targets minus the cost of the router and the backbone cells needed to reach it). Each candidate is evaluated lazily with a priority queue, and backbone distances are kept up to date incrementally. I have not compiled or run it against any data set, so it is untested.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint H, W, R;\nlong long Pb, Pr, B;\nvector<string> g;\nvector<int> P;          // 2D prefix sums of walls, (H+1)x(W+1)\nvector<char> cov;       // covered target cells\nvector<int> dist_, par_;\nconst int INF = INT_MAX / 4;\nint dr[8] = {-1,-1,-1,0,0,1,1,1};\nint dc[8] = {-1,0,1,-1,1,-1,0,1};\n\ninline int PI(int r, int c) { return r * (W + 1) + c; }\n\ninline int wallsRect(int r1, int c1, int r2, int c2) {\n    // inclusive rectangle\n    return P[PI(r2 + 1, c2 + 1)] - P[PI(r1, c2 + 1)] - P[PI(r2 + 1, c1)] + P[PI(r1, c1)];\n}\n\n// Counts (and optionally marks) newly covered targets for router at (a,b)\nint applyRouter(int a, int b, bool mark) {\n    int cnt = 0;\n    int x0 = max(0, a - R), x1 = min(H - 1, a + R);\n    int y0 = max(0, b - R), y1 = min(W - 1, b + R);\n    for (int x = x0; x <= x1; x++) {\n        for (int y = y0; y <= y1; y++) {\n            int id = x * W + y;\n            if (g[x][y] != '.' || cov[id]) continue;\n            int r1 = min(a, x), r2 = max(a, x);\n            int c1 = min(b, y), c2 = max(b, y);\n            if (wallsRect(r1, c1, r2, c2) != 0) continue;\n            cnt++;\n            if (mark) cov[id] = 1;\n        }\n    }\n    return cnt;\n}\n\nvoid propagate(vector<int>& sources) {\n    deque<int> q(sources.begin(), sources.end());\n    while (!q.empty()) {\n        int u = q.front(); q.pop_front();\n        int ur = u / W, uc = u % W;\n        for (int k = 0; k < 8; k++) {\n            int vr = ur + dr[k], vc = uc + dc[k];\n            if (vr < 0 || vr >= H || vc < 0 || vc >= W) continue;\n            int v = vr * W + vc;\n            if (dist_[v] > dist_[u] + 1) {\n                dist_[v] = dist_[u] + 1;\n                par_[v] = u;\n                q.push_back(v);\n            }\n        }\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> H >> W >> R;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    g.resize(H);\n    for (int i = 0; i < H; i++) cin >> g[i];\n\n    P.assign((H + 1) * (W + 1), 0);\n    for (int r = 0; r < H; r++) {\n        for (int c = 0; c < W; c++) {\n            int w = (g[r][c] == '#') ? 1 : 0;\n            P[PI(r + 1, c + 1)] = P[PI(r, c + 1)] + P[PI(r + 1, c)] - P[PI(r, c)] + w;\n        }\n    }\n\n    cov.assign(H * W, 0);\n    dist_.assign(H * W, INF);\n    par_.assign(H * W, -1);\n\n    int start = br * W + bc;\n    dist_[start] = 0;\n    {\n        vector<int> src = {start};\n        propagate(src);\n    }\n\n    long long spent = 0;\n    vector<int> bbOrder;   // backbone cells in output order (excluding start)\n    vector<int> routers;\n\n    // initial candidates\n    priority_queue<pair<long long, int>> pq;\n    for (int r = 0; r < H; r++) {\n        for (int c = 0; c < W; c++) {\n            if (g[r][c] == '#') continue;\n            int id = r * W + c;\n            int gain = applyRouter(r, c, false);\n            if (gain <= 0) continue;\n            long long cost = Pr + Pb * (long long)dist_[id];\n            long long key = 1000LL * gain - cost;\n            if (key > 0) pq.push({key, id});\n        }\n    }\n\n    while (!pq.empty()) {\n        auto top = pq.top();\n        pq.pop();\n        int id = top.second;\n        int r = id / W, c = id % W;\n        long long cost = Pr + Pb * (long long)dist_[id];\n        if (cost > B - spent) continue;\n        int gain = applyRouter(r, c, false);\n        if (gain <= 0) continue;\n        long long nk = 1000LL * gain - cost;\n        if (nk <= 0) continue;\n        if (!pq.empty() && nk < pq.top().first) {\n            pq.push({nk, id});\n            continue;\n        }\n        // accept: connect path to backbone\n        vector<int> path;\n        int cur = id;\n        while (dist_[cur] > 0) {\n            path.push_back(cur);\n            cur = par_[cur];\n        }\n        // path[0] = id (closest to router), path.back() closest to backbone\n        for (int i = (int)path.size() - 1; i >= 0; i--) {\n            bbOrder.push_back(path[i]);\n        }\n        for (int v : path) {\n            dist_[v] = 0;\n            par_[v] = -1;\n        }\n        spent += cost;\n        applyRouter(r, c, true);\n        routers.push_back(id);\n        propagate(path);\n    }\n\n    // output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(bbOrder.size()) + \"\\n\";\n    for (int id : bbOrder) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (int id : routers) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    cout << out;\n    return 0;\n}\n```",
