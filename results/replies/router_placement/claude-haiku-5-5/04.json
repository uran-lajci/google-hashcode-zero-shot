    "text": "This is a greedy heuristic, not an optimal solver. It repeatedly places the router with the best ratio of newly covered targets to total cost (router price plus the backbone cells needed to reach it). Connection costs come from an incrementally maintained 8-neighbour distance field, and a lazy priority queue avoids recomputing every candidate each round. I have not compiled or run it against the hidden data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int H, W, R;\n    cin >> H >> W >> R;\n    long long Pb, Pr, B;\n    cin >> Pb >> Pr >> B;\n    int br, bc;\n    cin >> br >> bc;\n    vector<string> g(H);\n    for (int i = 0; i < H; ++i) cin >> g[i];\n\n    const int N = H * W;\n    const int INF = 1000000000;\n    vector<char> wall(N, 0), target(N, 0);\n    for (int r = 0; r < H; ++r)\n        for (int c = 0; c < W; ++c) {\n            char ch = g[r][c];\n            int id = r * W + c;\n            if (ch == '#') wall[id] = 1;\n            else if (ch == '.') target[id] = 1;\n        }\n\n    // 2D prefix sums of walls, 1-based\n    vector<int> P((H + 1) * (W + 1), 0);\n    auto PI = [&](int r, int c) -> int& { return P[r * (W + 1) + c]; };\n    for (int r = 0; r < H; ++r)\n        for (int c = 0; c < W; ++c)\n            PI(r + 1, c + 1) = PI(r, c + 1) + PI(r + 1, c) - PI(r, c) + (wall[r * W + c] ? 1 : 0);\n\n    auto rectWalls = [&](int r1, int r2, int c1, int c2) -> int {\n        return PI(r2 + 1, c2 + 1) - PI(r1, c2 + 1) - PI(r2 + 1, c1) + PI(r1, c1);\n    };\n\n    vector<char> covered(N, 0), placed(N, 0);\n    vector<int> dist(N, INF), par(N, -1);\n\n    auto relax = [&](vector<int> q) {\n        size_t head = 0;\n        while (head < q.size()) {\n            int cur = q[head++];\n            int cr = cur / W, cc = cur % W;\n            int nd = dist[cur] + 1;\n            for (int dr = -1; dr <= 1; ++dr)\n                for (int dc = -1; dc <= 1; ++dc) {\n                    if (dr == 0 && dc == 0) continue;\n                    int nr = cr + dr, nc = cc + dc;\n                    if (nr < 0 || nr >= H || nc < 0 || nc >= W) continue;\n                    int n = nr * W + nc;\n                    if (nd < dist[n]) {\n                        dist[n] = nd;\n                        par[n] = cur;\n                        q.push_back(n);\n                    }\n                }\n        }\n    };\n\n    int start = br * W + bc;\n    dist[start] = 0;\n    relax(vector<int>{start});\n\n    auto gainOf = [&](int id) -> int {\n        int a = id / W, b = id % W;\n        int r0 = max(0, a - R), r1 = min(H - 1, a + R);\n        int c0 = max(0, b - R), c1 = min(W - 1, b + R);\n        int cnt = 0;\n        for (int x = r0; x <= r1; ++x)\n            for (int y = c0; y <= c1; ++y) {\n                int t = x * W + y;\n                if (!target[t] || covered[t]) continue;\n                if (rectWalls(min(a, x), max(a, x), min(b, y), max(b, y)) == 0) ++cnt;\n            }\n        return cnt;\n    };\n\n    auto cover = [&](int id) {\n        int a = id / W, b = id % W;\n        int r0 = max(0, a - R), r1 = min(H - 1, a + R);\n        int c0 = max(0, b - R), c1 = min(W - 1, b + R);\n        for (int x = r0; x <= r1; ++x)\n            for (int y = c0; y <= c1; ++y) {\n                int t = x * W + y;\n                if (!target[t] || covered[t]) continue;\n                if (rectWalls(min(a, x), max(a, x), min(b, y), max(b, y)) == 0) covered[t] = 1;\n            }\n    };\n\n    priority_queue<pair<double, int>> pq;\n    for (int id = 0; id < N; ++id) {\n        if (wall[id]) continue;\n        long long cost = (long long)dist[id] * Pb + Pr;\n        if (cost > B) continue;\n        int gn = gainOf(id);\n        if (gn > 0) pq.push({gn * 1000.0 / cost, id});\n    }\n\n    long long spent = 0;\n    vector<int> backbone;   // added cells in order (excluding start)\n    vector<int> routers;\n\n    while (!pq.empty()) {\n        auto [key, id] = pq.top();\n        pq.pop();\n        if (placed[id]) continue;\n        long long d = dist[id];\n        long long cost = d * Pb + Pr;\n        if (spent + cost > B) continue;\n        int gn = gainOf(id);\n        if (gn == 0) continue;\n        double nk = gn * 1000.0 / cost;\n        if (!pq.empty() && nk < pq.top().first) {\n            pq.push({nk, id});\n            continue;\n        }\n        // apply placement\n        vector<int> path;\n        int cur = id;\n        while (dist[cur] > 0) {\n            path.push_back(cur);\n            cur = par[cur];\n        }\n        for (int i = (int)path.size() - 1; i >= 0; --i) backbone.push_back(path[i]);\n        for (int c : path) dist[c] = 0;\n        spent += cost;\n        placed[id] = 1;\n        routers.push_back(id);\n        cover(id);\n        if (!path.empty()) relax(path);\n    }\n\n    // output\n    string out;\n    out.reserve(1 << 22);\n    out += to_string(backbone.size()) + \"\\n\";\n    for (int id : backbone) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    out += to_string(routers.size()) + \"\\n\";\n    for (int id : routers) {\n        out += to_string(id / W) + \" \" + to_string(id % W) + \"\\n\";\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
