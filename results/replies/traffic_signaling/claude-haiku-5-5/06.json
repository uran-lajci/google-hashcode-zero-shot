    "text": "This is a heuristic solver, not a provably optimal one. It builds several candidate schedules from car counts and first-arrival times, scores each by exact simulation, and prints the best. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint D, I, S, V;\nlong long F;\nvector<int> SB, SE, SL;\nvector<string> names;\nunordered_map<string, int> sid;\nvector<vector<int>> paths;\n\n// schedule: for each intersection, list of (street, T)\ntypedef vector<vector<pair<int, int>>> Sched;\n\nlong long simulate(const Sched& sch) {\n    // prepare green lookup\n    vector<int> C(I, 0);\n    vector<vector<int>> pref(I), st(I);\n    for (int v = 0; v < I; v++) {\n        if (sch[v].empty()) continue;\n        int acc = 0;\n        for (auto& pr : sch[v]) {\n            acc += pr.second;\n            pref[v].push_back(acc);\n            st[v].push_back(pr.first);\n        }\n        C[v] = acc;\n    }\n    auto green = [&](int v, int t) -> int {\n        if (C[v] == 0) return -1;\n        int r = t % C[v];\n        int idx = int(upper_bound(pref[v].begin(), pref[v].end(), r) - pref[v].begin());\n        return st[v][idx];\n    };\n\n    vector<deque<int>> q(S);\n    vector<int> qc(I, 0);\n    set<int> act;\n    vector<int> pos(V, 0);\n    vector<vector<int>> bucket(D + 1);\n    for (int c = 0; c < V; c++) {\n        int s = paths[c][0];\n        q[s].push_back(c);\n        int v = SE[s];\n        if (qc[v]++ == 0) act.insert(v);\n    }\n    long long score = 0;\n    vector<int> cur;\n    for (int t = 0; t < D; t++) {\n        auto& b = bucket[t];\n        if (!b.empty()) {\n            sort(b.begin(), b.end());\n            for (int c : b) {\n                int s = paths[c][pos[c]];\n                q[s].push_back(c);\n                int v = SE[s];\n                if (qc[v]++ == 0) act.insert(v);\n            }\n            vector<int>().swap(b);\n        }\n        cur.assign(act.begin(), act.end());\n        for (int v : cur) {\n            int g = green(v, t);\n            if (g < 0) continue;\n            if (q[g].empty()) continue;\n            int c = q[g].front();\n            q[g].pop_front();\n            qc[v]--;\n            if (qc[v] == 0) act.erase(v);\n            pos[c]++;\n            int ns = paths[c][pos[c]];\n            int arr = t + SL[ns];\n            if (pos[c] == (int)paths[c].size() - 1) {\n                if (arr <= D) score += F + (D - arr);\n            } else if (arr < D) {\n                bucket[arr].push_back(c);\n            }\n        }\n    }\n    return score;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    long long Dl, Il, Sl, Vl, Fl;\n    cin >> Dl >> Il >> Sl >> Vl >> Fl;\n    D = (int)Dl; I = (int)Il; S = (int)Sl; V = (int)Vl; F = Fl;\n    SB.resize(S); SE.resize(S); SL.resize(S); names.resize(S);\n    for (int s = 0; s < S; s++) {\n        cin >> SB[s] >> SE[s] >> names[s] >> SL[s];\n        sid[names[s]] = s;\n    }\n    paths.resize(V);\n    for (int c = 0; c < V; c++) {\n        int P;\n        cin >> P;\n        paths[c].resize(P);\n        for (int k = 0; k < P; k++) {\n            string nm;\n            cin >> nm;\n            paths[c][k] = sid[nm];\n        }\n    }\n\n    // statistics\n    const int INF = INT_MAX;\n    vector<int> cnt(S, 0), first(S, INF);\n    for (int c = 0; c < V; c++) {\n        int P = (int)paths[c].size();\n        long long acc = 0;\n        for (int k = 0; k < P; k++) {\n            int s = paths[c][k];\n            if (k > 0) acc += SL[s];\n            if (k < P - 1) {\n                cnt[s]++;\n                if (acc < D && acc < first[s]) first[s] = (int)acc;\n            }\n        }\n    }\n    vector<vector<int>> inc(I);\n    for (int s = 0; s < S; s++) {\n        if (cnt[s] > 0 && first[s] < D) inc[SE[s]].push_back(s);\n    }\n\n    Sched best(I);\n    long long bestScore = -1;\n    bool haveBest = false;\n\n    // variants\n    vector<double> scales = {1.0, 0.5, 2.0, 0.25, 0.0};  // 0.0 => uniform T=1\n    for (int mode = 0; mode < 2; mode++) {\n        for (double scale : scales) {\n            Sched cand(I);\n            for (int v = 0; v < I; v++) {\n                if (inc[v].empty()) continue;\n                vector<int> lst = inc[v];\n                if (mode == 0) {\n                    sort(lst.begin(), lst.end(), [&](int a, int b) {\n                        if (first[a] != first[b]) return first[a] < first[b];\n                        return a < b;\n                    });\n                } else {\n                    sort(lst.begin(), lst.end(), [&](int a, int b) {\n                        if (cnt[a] != cnt[b]) return cnt[a] > cnt[b];\n                        return a < b;\n                    });\n                }\n                for (int s : lst) {\n                    int T;\n                    if (scale == 0.0) T = 1;\n                    else {\n                        long long x = llround(cnt[s] * scale);\n                        if (x < 1) x = 1;\n                        if (x > D) x = D;\n                        T = (int)x;\n                    }\n                    cand[v].push_back({s, T});\n                }\n            }\n            long long sc = simulate(cand);\n            if (!haveBest || sc > bestScore) {\n                haveBest = true;\n                bestScore = sc;\n                best = cand;\n            }\n        }\n    }\n\n    // output\n    int A = 0;\n    for (int v = 0; v < I; v++) if (!best[v].empty()) A++;\n    string out;\n    out += to_string(A) + \"\\n\";\n    for (int v = 0; v < I; v++) {\n        if (best[v].empty()) continue;\n        out += to_string(v) + \"\\n\";\n        out += to_string(best[v].size()) + \"\\n\";\n        for (auto& pr : best[v]) {\n            out += names[pr.first];\n            out += ' ';\n            out += to_string(pr.second);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
