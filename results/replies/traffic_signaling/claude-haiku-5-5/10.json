    "text": "This is a heuristic solver. It does not simulate the traffic. For each intersection it gives every incoming street that is actually used a green phase, ordered by the earliest time a car could reach that light. Each green lasts as long as the number of feasible cars that need it, capped at D. Cars whose no-wait travel time cannot meet the deadline are ignored when counting demand. This is fast and always produces a valid submission, but it is not tuned against the true score.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    long long D;\n    int I, S, V;\n    long long F;\n    cin >> D >> I >> S >> V >> F;\n\n    vector<int> B(S), E(S);\n    vector<long long> Lt(S);\n    vector<string> name(S);\n    unordered_map<string, int> id;\n    id.reserve(S * 2 + 1);\n    for (int s = 0; s < S; ++s) {\n        cin >> B[s] >> E[s] >> name[s] >> Lt[s];\n        id[name[s]] = s;\n    }\n\n    // For each street: number of feasible cars needing its light, and earliest arrival.\n    vector<long long> cnt(S, 0), firstArr(S, LLONG_MAX);\n\n    for (int v = 0; v < V; ++v) {\n        int P;\n        cin >> P;\n        vector<int> path(P);\n        for (int k = 0; k < P; ++k) {\n            string nm;\n            cin >> nm;\n            path[k] = id[nm];\n        }\n        // suffix sums: suf[k] = sum of L[path[j]] for j >= k\n        vector<long long> suf(P + 1, 0);\n        for (int k = P - 1; k >= 0; --k) suf[k] = suf[k + 1] + Lt[path[k]];\n        // arrival at end of path[k]: a_0 = 0, a_k = sum_{j=1..k} L[path[j]]\n        long long a = 0;\n        for (int k = 0; k <= P - 2; ++k) {\n            if (k >= 1) a += Lt[path[k]];\n            // remaining time after end of path[k] = sum_{j>k} L[path[j]] = suf[k+1]\n            if (a + suf[k + 1] <= D) {\n                cnt[path[k]]++;\n                firstArr[path[k]] = min(firstArr[path[k]], a);\n            }\n        }\n    }\n\n    // Group candidate streets by their end intersection.\n    vector<vector<int>> perInter(I);\n    for (int s = 0; s < S; ++s) {\n        if (cnt[s] > 0) perInter[E[s]].push_back(s);\n    }\n\n    int A = 0;\n    string body;\n    for (int i = 0; i < I; ++i) {\n        auto &lst = perInter[i];\n        if (lst.empty()) continue;\n        sort(lst.begin(), lst.end(), [&](int x, int y) {\n            if (firstArr[x] != firstArr[y]) return firstArr[x] < firstArr[y];\n            return x < y;\n        });\n        A++;\n        body += to_string(i) + \"\\n\";\n        body += to_string(lst.size()) + \"\\n\";\n        for (int s : lst) {\n            long long T = min(cnt[s], D);\n            if (T < 1) T = 1;\n            body += name[s] + \" \" + to_string(T) + \"\\n\";\n        }\n    }\n\n    cout << A << \"\\n\" << body;\n    return 0;\n}\n```",
