    "text": "This is a heuristic, not a proven optimum. It builds several candidate schedules and keeps the one with the highest simulated score.\n\n- **Candidate schedules:** each intersection orders its incoming streets either by earliest free-flow arrival or by car count. Green durations are `ceil(count / d)`, capped to [1, D], for several divisors `d`, including all-ones.\n- **Simulation:** a per-second simulation of the rules (FIFO queues, one car per second per green light, arrival-time checks, scoring) evaluates each candidate, and the best one is printed.\n\nI haven't compiled or run this against the sample.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint D, I, S, V;\nlong long F;\nvector<int> Bv, Ev, Lv;\nvector<string> nameV;\nvector<vector<int>> path;\nvector<int> wcnt;\nvector<int> firstArr;\n\n// schedule: for each intersection, list of (street, T)\nusing Sched = vector<vector<pair<int,int>>>;\n\nlong long simulate(const Sched& sch) {\n    vector<vector<int>> cumv(I), sidv(I);\n    vector<int> Cyc(I, 0);\n    for (int X = 0; X < I; X++) {\n        int acc = 0;\n        for (auto& pr : sch[X]) {\n            acc += pr.second;\n            cumv[X].push_back(acc);\n            sidv[X].push_back(pr.first);\n        }\n        Cyc[X] = acc;\n    }\n    auto green = [&](int X, int t) -> int {\n        if (cumv[X].empty()) return -1;\n        int r = t % Cyc[X];\n        int idx = upper_bound(cumv[X].begin(), cumv[X].end(), r) - cumv[X].begin();\n        return sidv[X][idx];\n    };\n\n    vector<deque<pair<int,int>>> q(S);\n    vector<int> pos(V, 0);\n    vector<char> inAct(S, 0);\n    vector<int> active;\n    for (int c = 0; c < V; c++) {\n        int s = path[c][0];\n        q[s].push_back({c, 0});\n        if (!inAct[s]) { inAct[s] = 1; active.push_back(s); }\n    }\n\n    long long score = 0;\n    vector<int> pending;\n    for (int t = 0; t < D; t++) {\n        pending.clear();\n        for (int s : active) {\n            if (q[s].empty()) continue;\n            int X = Ev[s];\n            if (green(X, t) != s) continue;\n            if (q[s].front().second > t) continue;\n            int c = q[s].front().first;\n            q[s].pop_front();\n            int k = pos[c];\n            int nxt = path[c][k + 1];\n            int arr = t + Lv[nxt];\n            if (k + 1 == (int)path[c].size() - 1) {\n                if (arr <= D) score += F + (D - arr);\n            } else {\n                pos[c] = k + 1;\n                q[nxt].push_back({c, arr});\n                if (!inAct[nxt]) {\n                    inAct[nxt] = 1;\n                    pending.push_back(nxt);\n                }\n            }\n        }\n        vector<int> na;\n        na.reserve(active.size() + pending.size());\n        for (int s : active) {\n            if (q[s].empty()) inAct[s] = 0;\n            else na.push_back(s);\n        }\n        for (int s : pending) {\n            if (q[s].empty()) inAct[s] = 0;\n            else na.push_back(s);\n        }\n        active.swap(na);\n    }\n    return score;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> D >> I >> S >> V >> F;\n    Bv.resize(S); Ev.resize(S); Lv.resize(S); nameV.resize(S);\n    unordered_map<string,int> id;\n    id.reserve(S * 2 + 1);\n    for (int s = 0; s < S; s++) {\n        cin >> Bv[s] >> Ev[s] >> nameV[s] >> Lv[s];\n        id[nameV[s]] = s;\n    }\n    path.assign(V, {});\n    for (int c = 0; c < V; c++) {\n        int P;\n        cin >> P;\n        path[c].resize(P);\n        for (int k = 0; k < P; k++) {\n            string nm;\n            cin >> nm;\n            path[c][k] = id[nm];\n        }\n    }\n\n    wcnt.assign(S, 0);\n    firstArr.assign(S, INT_MAX);\n    for (int c = 0; c < V; c++) {\n        long long a = 0;\n        int P = path[c].size();\n        for (int k = 0; k + 1 < P; k++) {\n            int s = path[c][k];\n            wcnt[s]++;\n            if (a < firstArr[s]) firstArr[s] = (int)min<long long>(a, INT_MAX);\n            a += Lv[path[c][k + 1]];\n        }\n    }\n\n    vector<vector<int>> inc(I);\n    for (int s = 0; s < S; s++) {\n        if (wcnt[s] > 0) inc[Ev[s]].push_back(s);\n    }\n\n    auto build = [&](int orderMode, long long div) -> Sched {\n        Sched sch(I);\n        for (int X = 0; X < I; X++) {\n            if (inc[X].empty()) continue;\n            vector<int> v = inc[X];\n            if (orderMode == 0) {\n                sort(v.begin(), v.end(), [&](int a, int b) {\n                    if (firstArr[a] != firstArr[b]) return firstArr[a] < firstArr[b];\n                    return a < b;\n                });\n            } else {\n                sort(v.begin(), v.end(), [&](int a, int b) {\n                    if (wcnt[a] != wcnt[b]) return wcnt[a] > wcnt[b];\n                    return a < b;\n                });\n            }\n            for (int s : v) {\n                long long T;\n                if (div >= 1000000000LL) T = 1;\n                else T = (wcnt[s] + div - 1) / div;\n                if (T < 1) T = 1;\n                if (T > D) T = D;\n                sch[X].push_back({s, (int)T});\n            }\n        }\n        return sch;\n    };\n\n    Sched best;\n    long long bestScore = -1;\n    vector<long long> divs = {1000000000LL, 1, 2, 3, 4, 8, 16, 32};\n    for (int orderMode = 0; orderMode < 2; orderMode++) {\n        for (long long d : divs) {\n            Sched sch = build(orderMode, d);\n            long long sc = simulate(sch);\n            if (sc > bestScore) {\n                bestScore = sc;\n                best = sch;\n            }\n        }\n    }\n\n    int cntSched = 0;\n    for (int X = 0; X < I; X++) if (!best[X].empty()) cntSched++;\n\n    ostringstream out;\n    out << cntSched << \"\\n\";\n    for (int X = 0; X < I; X++) {\n        if (best[X].empty()) continue;\n        out << X << \"\\n\";\n        out << best[X].size() << \"\\n\";\n        for (auto& pr : best[X]) {\n            out << nameV[pr.first] << \" \" << pr.second << \"\\n\";\n        }\n    }\n    cout << out.str();\n    return 0;\n}\n```",
