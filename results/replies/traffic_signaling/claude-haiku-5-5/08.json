    "text": "This is a heuristic solver, not an optimal one. It builds candidate schedules from car demand and free-flow arrival order, scores each by an exact simulation of the statement's rules, and submits the best.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint D, I, S, V;\nlong long F;\nvector<int> sB, sE, sL;\nvector<string> sName;\nvector<vector<int>> paths;\nvector<long long> cnt, firstArr;\nvector<int> off_, dur_, cyc_, endI;\n\n// Exact simulation of the statement's rules with the current off_/dur_/cyc_.\nlong long simulate() {\n    long long score = 0;\n    vector<vector<int>> q(S);\n    vector<int> head(S, 0);\n    vector<char> inAct(S, 0);\n    vector<int> act;\n    vector<int> pos(V, 0);\n    vector<vector<pair<int, int>>> arr(D + 1);  // (car, index k: car at end of paths[c][k])\n\n    for (int c = 0; c < V; c++) {\n        int s = paths[c][0];\n        q[s].push_back(c);\n        if (!inAct[s]) { inAct[s] = 1; act.push_back(s); }\n    }\n\n    for (int t = 0; t <= D; t++) {\n        // 1) arrivals at end of streets at time t\n        for (auto &pr : arr[t]) {\n            int c = pr.first, k = pr.second;\n            pos[c] = k;\n            if (k == (int)paths[c].size() - 1) {\n                score += F + (D - t);\n            } else {\n                int s = paths[c][k];\n                q[s].push_back(c);\n                if (!inAct[s]) { inAct[s] = 1; act.push_back(s); }\n            }\n        }\n        arr[t].clear();\n        arr[t].shrink_to_fit();\n\n        // 2) crossings at green lights\n        for (int s : act) {\n            if (head[s] >= (int)q[s].size()) continue;\n            int E = endI[s];\n            if (cyc_[E] == 0 || dur_[s] == 0) continue;\n            int p = t % cyc_[E];\n            if (p >= off_[s] && p < off_[s] + dur_[s]) {\n                int c = q[s][head[s]++];\n                int k = pos[c] + 1;\n                int ns = paths[c][k];\n                long long ta = (long long)t + sL[ns];\n                if (ta <= D) arr[ta].push_back({c, k});\n            }\n        }\n\n        // 3) compact active list\n        size_t w = 0;\n        for (int s : act) {\n            if (head[s] < (int)q[s].size()) act[w++] = s;\n            else inAct[s] = 0;\n        }\n        act.resize(w);\n    }\n    return score;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> D >> I >> S >> V >> F;\n    sB.resize(S); sE.resize(S); sL.resize(S); sName.resize(S);\n    endI.resize(S);\n    unordered_map<string, int> id;\n    id.reserve(S * 2);\n    for (int s = 0; s < S; s++) {\n        cin >> sB[s] >> sE[s] >> sName[s] >> sL[s];\n        endI[s] = sE[s];\n        id[sName[s]] = s;\n    }\n    paths.resize(V);\n    for (int c = 0; c < V; c++) {\n        int P;\n        cin >> P;\n        paths[c].resize(P);\n        for (int k = 0; k < P; k++) {\n            string nm;\n            cin >> nm;\n            paths[c][k] = id[nm];\n        }\n    }\n\n    cnt.assign(S, 0);\n    firstArr.assign(S, LLONG_MAX / 4);\n    for (int c = 0; c < V; c++) {\n        int P = paths[c].size();\n        long long time = 0;\n        for (int k = 0; k + 1 < P; k++) {\n            int s = paths[c][k];\n            cnt[s]++;\n            firstArr[s] = min(firstArr[s], time);\n            time += sL[paths[c][k + 1]];\n        }\n    }\n\n    vector<vector<int>> byInt(I);\n    for (int s = 0; s < S; s++)\n        if (cnt[s] > 0) byInt[sE[s]].push_back(s);\n\n    off_.assign(S, 0);\n    dur_.assign(S, 0);\n    cyc_.assign(I, 0);\n\n    auto build = [&](int mode, double scale) {\n        fill(dur_.begin(), dur_.end(), 0);\n        fill(off_.begin(), off_.end(), 0);\n        fill(cyc_.begin(), cyc_.end(), 0);\n        vector<vector<int>> orders(I);\n        for (int i = 0; i < I; i++) {\n            vector<int> v = byInt[i];\n            if (v.empty()) continue;\n            if (mode == 0)\n                sort(v.begin(), v.end(), [&](int a, int b) {\n                    if (firstArr[a] != firstArr[b]) return firstArr[a] < firstArr[b];\n                    return a < b;\n                });\n            else\n                sort(v.begin(), v.end(), [&](int a, int b) {\n                    if (cnt[a] != cnt[b]) return cnt[a] > cnt[b];\n                    return a < b;\n                });\n            int cur = 0;\n            for (int s : v) {\n                long long T = llround(scale * (double)cnt[s]);\n                if (T < 1) T = 1;\n                if (T > D) T = D;\n                dur_[s] = (int)T;\n                off_[s] = cur;\n                cur += (int)T;\n            }\n            cyc_[i] = cur;\n            orders[i] = v;\n        }\n        return orders;\n    };\n\n    long long bestScore = -1;\n    vector<vector<int>> bestOrders;\n    vector<int> bestDur;\n\n    const double scales[] = {1.0, 0.5, 0.25, 2.0, 4.0, 0.125};\n    for (int mode = 0; mode < 2; mode++) {\n        for (double sc : scales) {\n            vector<vector<int>> orders = build(mode, sc);\n            long long sc_val = simulate();\n            if (sc_val > bestScore) {\n                bestScore = sc_val;\n                bestOrders = orders;\n                bestDur = dur_;\n            }\n        }\n    }\n\n    // Output best submission\n    int A = 0;\n    for (int i = 0; i < I; i++)\n        if (!bestOrders[i].empty()) A++;\n\n    string out;\n    out += to_string(A) + \"\\n\";\n    for (int i = 0; i < I; i++) {\n        if (bestOrders[i].empty()) continue;\n        out += to_string(i) + \"\\n\";\n        out += to_string(bestOrders[i].size()) + \"\\n\";\n        for (int s : bestOrders[i]) {\n            out += sName[s];\n            out += ' ';\n            out += to_string(bestDur[s]);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
