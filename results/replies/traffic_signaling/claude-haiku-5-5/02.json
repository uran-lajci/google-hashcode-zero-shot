    "text": "This is a heuristic solver, not a proven optimum. It estimates each street's demand from free-flow travel times, builds a cyclic schedule per intersection (streets ordered by first expected arrival, green time proportional to demand), and scores each candidate with an exact per-second simulation of the rules. It then runs a time-bounded local search (about 6.5 s) that tries different green-time scales per intersection and keeps changes that don't lower the simulated score. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint D, I, S, V;\nlong long F;\nvector<int> Eend, Lt;\nvector<string> names;\nvector<vector<int>> paths;\nvector<vector<int>> inc;   // candidate incoming streets sorted by first arrival\nvector<int> wgt;\nvector<long long> firstA;\n\nstruct Sched {\n    vector<int> st;\n    vector<int> dur;\n    vector<long long> start;\n    long long C = 0;\n};\nvector<Sched> sc;\nvector<double> lev;\n\n// simulation buffers\nvector<int> qh, qt, qn, cur, wc;\nvector<vector<int>> arrB;\nvector<int> active;\n\nvoid build(int i) {\n    Sched &s = sc[i];\n    s.st.clear(); s.dur.clear(); s.start.clear(); s.C = 0;\n    if (lev[i] <= 0) return;\n    for (int st : inc[i]) {\n        long long d = llround((double)wgt[st] * lev[i]);\n        if (d < 1) d = 1;\n        if (d > D) d = D;\n        s.st.push_back(st);\n        s.dur.push_back((int)d);\n        s.start.push_back(s.C);\n        s.C += d;\n    }\n}\n\nlong long simulate() {\n    fill(qh.begin(), qh.end(), -1);\n    fill(qt.begin(), qt.end(), -1);\n    fill(wc.begin(), wc.end(), 0);\n    fill(cur.begin(), cur.end(), 0);\n    for (auto &v : arrB) v.clear();\n    active.clear();\n    long long score = 0;\n\n    auto enq = [&](int s, int c) {\n        qn[c] = -1;\n        int i = Eend[s];\n        if (qh[s] < 0) { qh[s] = c; qt[s] = c; }\n        else { qn[qt[s]] = c; qt[s] = c; }\n        if (wc[i]++ == 0) active.push_back(i);\n    };\n\n    for (int c = 0; c < V; c++) enq(paths[c][0], c);\n\n    for (int t = 0; t <= D; t++) {\n        for (int c : arrB[t]) enq(paths[c][cur[c]], c);\n        for (int i : active) {\n            Sched &s = sc[i];\n            if (s.C == 0) continue;\n            long long p = t % s.C;\n            int idx = int(upper_bound(s.start.begin(), s.start.end(), p) - s.start.begin()) - 1;\n            int g = s.st[idx];\n            if (qh[g] < 0) continue;\n            int c = qh[g];\n            qh[g] = qn[c];\n            if (qh[g] < 0) qt[g] = -1;\n            wc[i]--;\n            int k = cur[c];\n            int ns = paths[c][k + 1];\n            long long arr = (long long)t + Lt[ns];\n            if (k + 1 == (int)paths[c].size() - 1) {\n                if (arr <= D) score += F + (D - arr);\n            } else {\n                cur[c] = k + 1;\n                if (arr <= D) arrB[arr].push_back(c);\n            }\n        }\n        // filter active\n        size_t w = 0;\n        for (size_t j = 0; j < active.size(); j++) {\n            if (wc[active[j]] > 0) active[w++] = active[j];\n        }\n        active.resize(w);\n    }\n    return score;\n}\n\nint main() {\n    auto startTime = chrono::steady_clock::now();\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> D >> I >> S >> V >> F;\n    Eend.assign(S, 0);\n    Lt.assign(S, 0);\n    names.resize(S);\n    unordered_map<string, int> id;\n    id.reserve(S * 2);\n    vector<int> Bst(S);\n    for (int s = 0; s < S; s++) {\n        int b, e, l;\n        string nm;\n        cin >> b >> e >> nm >> l;\n        Bst[s] = b;\n        Eend[s] = e;\n        Lt[s] = l;\n        names[s] = nm;\n        id[nm] = s;\n    }\n    paths.assign(V, {});\n    for (int c = 0; c < V; c++) {\n        int p;\n        cin >> p;\n        paths[c].resize(p);\n        for (int k = 0; k < p; k++) {\n            string nm;\n            cin >> nm;\n            paths[c][k] = id[nm];\n        }\n    }\n\n    // free-flow demand estimate\n    wgt.assign(S, 0);\n    firstA.assign(S, LLONG_MAX);\n    for (int c = 0; c < V; c++) {\n        int P = paths[c].size();\n        vector<long long> A(P, 0);\n        for (int k = 1; k < P; k++) A[k] = A[k - 1] + Lt[paths[c][k]];\n        if (A[P - 1] > D) continue;\n        for (int k = 0; k + 1 < P; k++) {\n            int s = paths[c][k];\n            wgt[s]++;\n            firstA[s] = min(firstA[s], A[k]);\n        }\n    }\n    inc.assign(I, {});\n    for (int s = 0; s < S; s++) {\n        if (wgt[s] > 0) inc[Eend[s]].push_back(s);\n    }\n    for (int i = 0; i < I; i++) {\n        sort(inc[i].begin(), inc[i].end(), [&](int a, int b) {\n            if (firstA[a] != firstA[b]) return firstA[a] < firstA[b];\n            return a < b;\n        });\n    }\n\n    sc.assign(I, Sched());\n    lev.assign(I, 0.0);\n    qh.assign(S, -1);\n    qt.assign(S, -1);\n    qn.assign(V, -1);\n    cur.assign(V, 0);\n    wc.assign(I, 0);\n    arrB.assign(D + 1, {});\n\n    vector<double> cand = {0.0, 0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 8.0};\n    vector<int> cands;\n    for (int i = 0; i < I; i++) if (!inc[i].empty()) cands.push_back(i);\n\n    // global initialization\n    long long bestScore = -1;\n    double bestC = 0.0;\n    for (double c : cand) {\n        if (c <= 0) continue;\n        for (int i : cands) lev[i] = c;\n        for (int i : cands) build(i);\n        long long sc0 = simulate();\n        if (sc0 > bestScore) { bestScore = sc0; bestC = c; }\n    }\n    if (bestScore < 0) bestScore = 0;\n    for (int i : cands) lev[i] = bestC;\n    for (int i : cands) build(i);\n    long long curScore = (bestC > 0) ? simulate() : 0;\n    if (bestC <= 0) {\n        for (int i : cands) lev[i] = 0;\n        for (int i : cands) build(i);\n    }\n\n    // local search\n    uint64_t rng = 88172645463325252ULL;\n    auto nextRand = [&]() {\n        rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;\n        return rng;\n    };\n    if (!cands.empty()) {\n        while (true) {\n            auto now = chrono::steady_clock::now();\n            double el = chrono::duration<double>(now - startTime).count();\n            if (el > 6.5) break;\n            int i = cands[nextRand() % cands.size()];\n            double nc = cand[nextRand() % cand.size()];\n            if (nc == lev[i]) continue;\n            double old = lev[i];\n            lev[i] = nc;\n            build(i);\n            long long ns = simulate();\n            if (ns >= curScore) {\n                curScore = ns;\n            } else {\n                lev[i] = old;\n                build(i);\n            }\n        }\n    }\n\n    // output\n    int A = 0;\n    for (int i = 0; i < I; i++) if (!sc[i].st.empty()) A++;\n    string out;\n    out += to_string(A) + \"\\n\";\n    for (int i = 0; i < I; i++) {\n        if (sc[i].st.empty()) continue;\n        out += to_string(i) + \"\\n\";\n        out += to_string(sc[i].st.size()) + \"\\n\";\n        for (size_t j = 0; j < sc[i].st.size(); j++) {\n            out += names[sc[i].st[j]];\n            out += \" \";\n            out += to_string(sc[i].dur[j]);\n            out += \"\\n\";\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
