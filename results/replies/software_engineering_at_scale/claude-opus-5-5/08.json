    "text": "This is a greedy list-scheduling heuristic, not an optimal solver. It never moves services or creates binaries, so the only constraints that matter for validity are on feature implementation.\n\n**Approach**\n\n1. **Per-feature cost.** For each feature, compute two numbers:\n   - the *span*: the longest single-binary task, `max(D + R_b)`;\n   - the *work*: the total over its binaries, `\u03a3(D + R_b)`.\n\n   Features whose span is at least `L` can never launch, so they are dropped.\n2. **Priority order.** Remaining features are sorted by `U\u00b7(L \u2212 span) / work^a`. The run tries several exponents `a`, plus an order that ignores `work`. Each order is simulated and the one with the best simulated score is output.\n3. **Day-by-day simulation.**\n   - On each day, tasks that end that day are processed first.\n   - Then free engineers, in index order, each take the next pending `(feature, binary)` task. Binaries with more services go first.\n   - The duration `D + R + C` uses the live count `C` of engineers on that binary. This matches the judge's rule that among same-day starts, the engineer listed earlier counts toward the next one's `C`.\n   - Engineers are written in index order, so the computed durations match the judge.\n4. **Avoiding wasted work.**\n   - Before a feature is started, the program checks that every one of its binary tasks could finish before `L`.\n   - If any task of a feature would finish at or after `L`, the rest of that feature is abandoned.\n5. **Validity.**\n   - Each `(feature, binary)` pair is assigned at most once, so two engineers never implement the same feature in the same binary.\n   - No moves are ever made, so the move restrictions cannot be broken.\n   - Idle gaps are filled with `wait` commands.\n   - Every task starts before day `L` and lasts at least one day, so each engineer has at most `L` tasks.\n   - Engineers with no tasks are left out of the output.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint L,G,S,B,F,N;\nvector<string> sname, fname;\nvector<int> sbin, Rb, D, U;\nvector<vector<int>> fbins;\nvector<int> spanv, workv;\n\nstruct Result{ long long score; vector<vector<pair<int,int>>> tasks; };\n\nResult sim(const vector<int>& order){\n    Result res; res.score=0;\n    res.tasks.assign(G,{});\n    vector<int> C(B,0), freeSince(G,0);\n    vector<vector<pair<int,int>>> endB(L+1);\n    vector<int> idle(G); iota(idle.begin(),idle.end(),0);\n    size_t pos=0; int cur=-1; size_t idx=0; int curMax=0;\n    bool exhausted=false;\n    for(int t=0;t<L && !exhausted;t++){\n        vector<int> fr; fr.swap(idle);\n        for(auto&pr:endB[t]){ C[pr.second]--; fr.push_back(pr.first);}\n        if(fr.empty()) continue;\n        sort(fr.begin(),fr.end());\n        size_t k=0;\n        for(;k<fr.size();k++){\n            int e=fr[k];\n            int gf=-1,gb=-1,gd=0;\n            while(true){\n                if(cur>=0 && idx<fbins[cur].size()){\n                    int b=fbins[cur][idx];\n                    int dur=D[cur]+Rb[b]+C[b];\n                    if(t+dur>=L){cur=-1;continue;}\n                    idx++;\n                    gf=cur;gb=b;gd=dur;\n                    curMax=max(curMax,t+dur);\n                    if(idx==fbins[cur].size()){\n                        res.score+=(long long)U[cur]*(L-curMax);\n                        cur=-1;\n                    }\n                    break;\n                }\n                if(pos>=order.size()) break;\n                int f=order[pos++];\n                int mx=0;\n                for(int b:fbins[f]) mx=max(mx,D[f]+Rb[b]+C[b]);\n                if(t+mx>=L) continue;\n                cur=f; idx=0; curMax=0;\n            }\n            if(gf<0) break;\n            if(t>freeSince[e]) res.tasks[e].push_back({-1,t-freeSince[e]});\n            res.tasks[e].push_back({gf,gb});\n            C[gb]++;\n            int en=t+gd;\n            freeSince[e]=en;\n            endB[en].push_back({e,gb}); // en < L\n        }\n        if(k<fr.size()){\n            for(;k<fr.size();k++) idle.push_back(fr[k]);\n            if(pos>=order.size() && cur<0) exhausted=true;\n        }\n    }\n    return res;\n}\n\nint main(){\n    ios::sync_with_stdio(false);cin.tie(nullptr);\n    cin>>L>>G>>S>>B>>F>>N;\n    sname.resize(S);sbin.resize(S);Rb.assign(B,0);\n    unordered_map<string,int> smap; smap.reserve(S*2);\n    for(int i=0;i<S;i++){cin>>sname[i]>>sbin[i];smap[sname[i]]=i;Rb[sbin[i]]++;}\n    fname.resize(F);D.resize(F);U.resize(F);fbins.resize(F);\n    spanv.resize(F);workv.resize(F);\n    for(int i=0;i<F;i++){\n        int m;cin>>fname[i]>>m>>D[i]>>U[i];\n        vector<int> bs;\n        for(int j=0;j<m;j++){string s;cin>>s;bs.push_back(sbin[smap[s]]);}\n        sort(bs.begin(),bs.end());bs.erase(unique(bs.begin(),bs.end()),bs.end());\n        sort(bs.begin(),bs.end(),[&](int a,int b){if(Rb[a]!=Rb[b])return Rb[a]>Rb[b];return a<b;});\n        fbins[i]=bs;\n        int sp=0;long long w=0;\n        for(int b:bs){sp=max(sp,D[i]+Rb[b]);w+=D[i]+Rb[b];}\n        spanv[i]=sp;workv[i]=(int)min<long long>(w,INT_MAX);\n    }\n    vector<int> cand;\n    for(int i=0;i<F;i++) if(spanv[i]<L) cand.push_back(i);\n    vector<double> exps={0.0,0.5,1.0,1.5,2.0};\n    Result best; best.score=-1;\n    for(int mode=0;mode<(int)exps.size()+1;mode++){\n        vector<double> pr(F,0);\n        for(int f:cand){\n            if(mode<(int)exps.size())\n                pr[f]=(double)U[f]*(L-spanv[f])/pow((double)workv[f],exps[mode]);\n            else\n                pr[f]=(double)U[f]/workv[f];\n        }\n        vector<int> order=cand;\n        stable_sort(order.begin(),order.end(),[&](int a,int b){if(pr[a]!=pr[b])return pr[a]>pr[b];return a<b;});\n        Result r=sim(order);\n        if(r.score>best.score) best=std::move(r);\n    }\n    string out;\n    int E=0;\n    for(int e=0;e<G;e++) if(!best.tasks[e].empty()) E++;\n    out+=to_string(E)+\"\\n\";\n    for(int e=0;e<G;e++){\n        auto&tk=best.tasks[e];\n        if(tk.empty())continue;\n        out+=to_string(tk.size())+\"\\n\";\n        for(auto&p:tk){\n            if(p.first<0) out+=\"wait \"+to_string(p.second)+\"\\n\";\n            else out+=\"impl \"+fname[p.first]+\" \"+to_string(p.second)+\"\\n\";\n        }\n    }\n    fwrite(out.data(),1,out.size(),stdout);\n}\n```",
