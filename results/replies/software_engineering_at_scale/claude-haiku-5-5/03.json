    "text": "This is a greedy heuristic, not an optimal solution. It never moves services or creates binaries. Each feature is implemented in every binary that holds one of its services, features are prioritised by users per unit of work, and engineers are assigned day by day. The schedule is built by simulating the scoring rules directly, so the per-binary engineer counts used for durations match what the judge will compute.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Eng {\n    int busy = 0;\n    int cur = 0;\n    bool working = false;\n    int bin = -1;\n    vector<string> tasks;\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int L, G, S, B, F, N;\n    cin >> L >> G >> S >> B >> F >> N;\n\n    unordered_map<string, int> svcId;\n    vector<int> svcBin(S);\n    vector<int> R(B, 0);\n    for (int i = 0; i < S; i++) {\n        string name;\n        int b;\n        cin >> name >> b;\n        svcId[name] = i;\n        svcBin[i] = b;\n        R[b]++;\n    }\n\n    vector<string> fname(F);\n    vector<int> D(F), U(F);\n    vector<vector<int>> rem(F);\n    for (int f = 0; f < F; f++) {\n        int M;\n        cin >> fname[f] >> M >> D[f] >> U[f];\n        vector<int> bs;\n        for (int k = 0; k < M; k++) {\n            string sn;\n            cin >> sn;\n            bs.push_back(svcBin[svcId[sn]]);\n        }\n        sort(bs.begin(), bs.end());\n        bs.erase(unique(bs.begin(), bs.end()), bs.end());\n        rem[f] = bs;\n    }\n\n    // Priority: users per unit of total work.\n    vector<double> key(F);\n    for (int f = 0; f < F; f++) {\n        double work = 0;\n        for (int b : rem[f]) work += D[f] + R[b];\n        key[f] = work > 0 ? (double)U[f] / work : 0.0;\n    }\n    vector<int> order(F);\n    iota(order.begin(), order.end(), 0);\n    stable_sort(order.begin(), order.end(), [&](int a, int b) {\n        if (key[a] != key[b]) return key[a] > key[b];\n        return a < b;\n    });\n\n    vector<Eng> eng;\n    vector<int> cnt(B, 0);\n\n    // Find a feasible (feature, binary) starting at day t.\n    auto pick = [&](int t, int &pf, int &pb) -> bool {\n        for (int f : order) {\n            if (rem[f].empty()) continue;\n            int best = -1;\n            long long bestVal = LLONG_MAX;\n            for (int b : rem[f]) {\n                long long end = (long long)t + D[f] + R[b] + cnt[b];\n                if (end <= L) {\n                    long long v = R[b] + cnt[b];\n                    if (v < bestVal) {\n                        bestVal = v;\n                        best = b;\n                    }\n                }\n            }\n            if (best != -1) {\n                pf = f;\n                pb = best;\n                return true;\n            }\n        }\n        return false;\n    };\n\n    auto assign = [&](int e, int t, int f, int b) {\n        Eng &g = eng[e];\n        if (t > g.cur) g.tasks.push_back(\"wait \" + to_string(t - g.cur));\n        int end = t + D[f] + R[b] + cnt[b];\n        g.tasks.push_back(\"impl \" + fname[f] + \" \" + to_string(b));\n        g.cur = end;\n        g.busy = end;\n        g.working = true;\n        g.bin = b;\n        cnt[b]++;\n        auto it = find(rem[f].begin(), rem[f].end(), b);\n        if (it != rem[f].end()) rem[f].erase(it);\n    };\n\n    for (int t = 0; t < L; t++) {\n        // Release finished tasks.\n        for (auto &g : eng) {\n            if (g.working && g.busy <= t) {\n                g.working = false;\n                cnt[g.bin]--;\n                g.bin = -1;\n            }\n        }\n        // Compact the feature order.\n        {\n            vector<int> nord;\n            nord.reserve(order.size());\n            for (int f : order)\n                if (!rem[f].empty()) nord.push_back(f);\n            order.swap(nord);\n        }\n        // Assign free existing engineers in index order.\n        for (int e = 0; e < (int)eng.size(); e++) {\n            if (eng[e].working || eng[e].busy > t) continue;\n            int pf, pb;\n            if (!pick(t, pf, pb)) break;\n            assign(e, t, pf, pb);\n        }\n        // Create new engineers while useful.\n        while ((int)eng.size() < G) {\n            int pf, pb;\n            if (!pick(t, pf, pb)) break;\n            eng.push_back(Eng());\n            int e = (int)eng.size() - 1;\n            assign(e, t, pf, pb);\n        }\n    }\n\n    // Output.\n    ostringstream out;\n    out << eng.size() << \"\\n\";\n    for (auto &g : eng) {\n        out << g.tasks.size() << \"\\n\";\n        for (auto &line : g.tasks) out << line << \"\\n\";\n    }\n    cout << out.str();\n    return 0;\n}\n```",
