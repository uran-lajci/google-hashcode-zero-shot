    "text": "This is a heuristic, not an optimal scheduler, and I have not compiled or run it against any data set. It makes three simplifications:\n\n- **No moves or new binaries.** Services stay in their initial binaries, so each binary's size is fixed.\n- **Exclusive binaries.** A binary is never worked on by two engineers at once, so the concurrency term `C_B` is always 0. This avoids the ambiguity around how overlapping work is counted.\n- **Greedy list scheduling.** Engineers are processed in time order. Each takes the highest-ranked feature (ranked by users per total work) that has a free binary and can finish before the time limit. Idle engineers wait until the next binary frees up.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Feat {\n    string name;\n    long long D = 0;\n    long long U = 0;\n    vector<int> bins;\n    vector<long long> dur;\n    vector<char> asg;\n    int rem = 0;\n    double ratio = 0.0;\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    long long L, G, S, B, F, N;\n    cin >> L >> G >> S >> B >> F >> N;\n\n    unordered_map<string, int> sid;\n    vector<int> binOf(S);\n    vector<long long> R(B, 0);\n    for (int i = 0; i < S; ++i) {\n        string nm;\n        int b;\n        cin >> nm >> b;\n        sid[nm] = i;\n        binOf[i] = b;\n        R[b]++;\n    }\n\n    vector<Feat> fs(F);\n    for (int f = 0; f < F; ++f) {\n        string name;\n        int M;\n        long long D, U;\n        cin >> name >> M >> D >> U;\n        vector<int> bs;\n        for (int m = 0; m < M; ++m) {\n            string s;\n            cin >> s;\n            bs.push_back(binOf[sid[s]]);\n        }\n        sort(bs.begin(), bs.end());\n        bs.erase(unique(bs.begin(), bs.end()), bs.end());\n        Feat& ft = fs[f];\n        ft.name = name;\n        ft.D = D;\n        ft.U = U;\n        ft.bins = bs;\n        double W = 0;\n        for (int b : bs) {\n            long long d = D + R[b];\n            ft.dur.push_back(d);\n            W += (double)d;\n        }\n        ft.asg.assign(bs.size(), 0);\n        ft.rem = (int)bs.size();\n        ft.ratio = (W > 0) ? (double)U / W : 0.0;\n    }\n\n    vector<int> order(F);\n    iota(order.begin(), order.end(), 0);\n    sort(order.begin(), order.end(), [&](int a, int b) {\n        if (fs[a].ratio != fs[b].ratio) return fs[a].ratio > fs[b].ratio;\n        return a < b;\n    });\n\n    vector<long long> busy(B, 0);\n    multiset<long long> releases;\n    vector<vector<string>> tasks(G);\n    vector<long long> last(G, 0);\n\n    // min-heap of (time, engineer)\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                   greater<pair<long long, int>>> pq;\n    for (int e = 0; e < G; ++e) pq.push({0, e});\n\n    long long noneAt = -1;\n\n    while (!pq.empty()) {\n        auto [t, e] = pq.top();\n        pq.pop();\n        if (t >= L) break;\n\n        // Remove releases that are not in the future.\n        while (!releases.empty() && *releases.begin() <= t) releases.erase(releases.begin());\n\n        int fsel = -1, ksel = -1;\n        if (noneAt != t) {\n            for (int fi : order) {\n                Feat& ft = fs[fi];\n                if (ft.rem == 0) continue;\n                for (size_t k = 0; k < ft.bins.size(); ++k) {\n                    if (ft.asg[k]) continue;\n                    int b = ft.bins[k];\n                    if (busy[b] > t) continue;\n                    if (t + ft.dur[k] > L) continue;\n                    fsel = fi;\n                    ksel = (int)k;\n                    break;\n                }\n                if (fsel >= 0) break;\n            }\n            if (fsel < 0) noneAt = t;\n        }\n\n        if (fsel >= 0) {\n            Feat& ft = fs[fsel];\n            int b = ft.bins[ksel];\n            long long d = ft.dur[ksel];\n            if (t > last[e]) {\n                tasks[e].push_back(\"wait \" + to_string(t - last[e]));\n            }\n            tasks[e].push_back(\"impl \" + ft.name + \" \" + to_string(b));\n            ft.asg[ksel] = 1;\n            ft.rem--;\n            busy[b] = t + d;\n            releases.insert(t + d);\n            last[e] = t + d;\n            pq.push({t + d, e});\n        } else {\n            // Idle: wait until the next binary becomes free, if any.\n            if (!releases.empty()) {\n                pq.push({*releases.begin(), e});\n            }\n            // Otherwise the engineer retires.\n        }\n    }\n\n    int used = 0;\n    for (int e = 0; e < G; ++e)\n        if (!tasks[e].empty()) ++used;\n\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(used) + \"\\n\";\n    for (int e = 0; e < G; ++e) {\n        if (tasks[e].empty()) continue;\n        out += to_string(tasks[e].size()) + \"\\n\";\n        for (const string& s : tasks[e]) {\n            out += s;\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
