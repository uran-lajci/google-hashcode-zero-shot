    "text": "This is a heuristic, not an optimal solver. It never moves services and never creates binaries, so it's valid by construction but likely leaves score on the table. It orders all (feature, binary) work items by value per unit of work, then greedily assigns each item to the engineer who becomes free earliest. Each task's duration is computed from the live count of engineers in that binary at its start time.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    long long L;\n    int G, S, B, F, N;\n    cin >> L >> G >> S >> B >> F >> N;\n\n    map<string, int> sid;\n    vector<int> sbin(S);\n    vector<long long> R(B, 0);\n    for (int i = 0; i < S; i++) {\n        string nm;\n        int b;\n        cin >> nm >> b;\n        sid[nm] = i;\n        sbin[i] = b;\n        R[b]++;\n    }\n\n    struct Feat {\n        string name;\n        long long D, U;\n        vector<int> bins;\n        long long work;\n    };\n    vector<Feat> fs(F);\n    for (int i = 0; i < F; i++) {\n        string nm;\n        int M;\n        long long D, U;\n        cin >> nm >> M >> D >> U;\n        vector<int> bins;\n        for (int j = 0; j < M; j++) {\n            string sn;\n            cin >> sn;\n            bins.push_back(sbin[sid[sn]]);\n        }\n        sort(bins.begin(), bins.end());\n        bins.erase(unique(bins.begin(), bins.end()), bins.end());\n        long long work = 0;\n        for (int b : bins) work += D + R[b];\n        fs[i] = {nm, D, U, bins, work};\n    }\n\n    // Priority: value per unit of work, descending.\n    vector<int> order(F);\n    iota(order.begin(), order.end(), 0);\n    sort(order.begin(), order.end(), [&](int a, int b) {\n        // U_a / work_a > U_b / work_b\n        long long lhs = fs[a].U * fs[b].work;\n        long long rhs = fs[b].U * fs[a].work;\n        if (lhs != rhs) return lhs > rhs;\n        return a < b;\n    });\n\n    // Work items: (feature, binary) pairs in priority order.\n    vector<pair<int, int>> items;\n    for (int f : order)\n        for (int b : fs[f].bins)\n            items.push_back({f, b});\n\n    // Engineers: min-heap by (free time, index).\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                   greater<pair<long long, int>>> pq;\n    for (int e = 0; e < G; e++) pq.push({0LL, e});\n\n    // Per-binary end times of ongoing feature tasks.\n    vector<priority_queue<long long, vector<long long>, greater<long long>>> ends(B);\n\n    vector<vector<string>> tasks(G);\n    size_t head = 0;\n\n    while (!pq.empty() && head < items.size()) {\n        auto [t, e] = pq.top();\n        pq.pop();\n        if (t >= L) break;\n\n        while (head < items.size()) {\n            auto [f, b] = items[head];\n            head++;\n            auto &q = ends[b];\n            while (!q.empty() && q.top() <= t) q.pop();\n            long long cost = fs[f].D + R[b] + (long long)q.size();\n            if (t + cost >= L) continue; // cannot complete in time; drop\n            q.push(t + cost);\n            tasks[e].push_back(\"impl \" + fs[f].name + \" \" + to_string(b));\n            pq.push({t + cost, e});\n            break;\n        }\n    }\n\n    int E = 0;\n    for (int e = 0; e < G; e++)\n        if (!tasks[e].empty()) E++;\n\n    string out;\n    out += to_string(E) + \"\\n\";\n    for (int e = 0; e < G; e++) {\n        if (tasks[e].empty()) continue;\n        out += to_string(tasks[e].size()) + \"\\n\";\n        for (const auto &s : tasks[e]) {\n            out += s;\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
