    "text": "This is a greedy heuristic, not an optimal solver. It never moves services or creates binaries, so every schedule it outputs is valid. Features are ranked by value per unit of work. Each free engineer takes the highest-ranked feature task that can still finish by the time limit, choosing the least-crowded binary for it.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    ll L;\n    int G, S, B, F, N;\n    cin >> L >> G >> S >> B >> F >> N;\n\n    unordered_map<string, int> sid;\n    vector<int> sbin(S);\n    for (int i = 0; i < S; i++) {\n        string name;\n        int bi;\n        cin >> name >> bi;\n        sid[name] = i;\n        sbin[i] = bi;\n    }\n    vector<ll> R(B, 0);\n    for (int s = 0; s < S; s++) R[sbin[s]]++;\n\n    struct Feat {\n        string name;\n        ll D, U;\n        vector<int> bins;\n    };\n    vector<Feat> fs(F);\n    for (int f = 0; f < F; f++) {\n        int M;\n        cin >> fs[f].name >> M >> fs[f].D >> fs[f].U;\n        set<int> bs;\n        for (int m = 0; m < M; m++) {\n            string sn;\n            cin >> sn;\n            auto it = sid.find(sn);\n            if (it != sid.end()) bs.insert(sbin[it->second]);\n        }\n        fs[f].bins.assign(bs.begin(), bs.end());\n    }\n\n    // Priority: value per unit of static work.\n    vector<double> key(F, 0.0);\n    vector<ll> minStatic(F, LLONG_MAX / 4);\n    for (int f = 0; f < F; f++) {\n        ll work = 0;\n        for (int b : fs[f].bins) {\n            work += fs[f].D + R[b];\n            minStatic[f] = min(minStatic[f], fs[f].D + R[b]);\n        }\n        if (work <= 0) work = 1;\n        key[f] = (double)fs[f].U / (double)work;\n    }\n    vector<int> order(F);\n    for (int f = 0; f < F; f++) order[f] = f;\n    sort(order.begin(), order.end(), [&](int a, int c) {\n        if (key[a] != key[c]) return key[a] > key[c];\n        return a < c;\n    });\n\n    // Started flags and remaining counts.\n    vector<vector<char>> started(F);\n    vector<int> remaining(F);\n    for (int f = 0; f < F; f++) {\n        started[f].assign(fs[f].bins.size(), 0);\n        remaining[f] = (int)fs[f].bins.size();\n    }\n\n    // Ongoing task end times per binary, and globally not needed.\n    vector<priority_queue<ll, vector<ll>, greater<ll>>> bend(B);\n\n    // Engineer events: (free time, engineer index).\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> ev;\n    for (int e = 0; e < G; e++) ev.push({0, e});\n\n    vector<vector<string>> tasks(G);\n    vector<int> alive = order;\n\n    while (!ev.empty()) {\n        auto [t, e] = ev.top();\n        ev.pop();\n        if (t >= L) continue;\n\n        // Remove permanently infeasible / exhausted features.\n        {\n            size_t w = 0;\n            for (size_t i = 0; i < alive.size(); i++) {\n                int f = alive[i];\n                if (remaining[f] > 0 && t + minStatic[f] <= L) {\n                    alive[w++] = f;\n                }\n            }\n            alive.resize(w);\n        }\n\n        bool done = false;\n        for (size_t i = 0; i < alive.size() && !done; i++) {\n            int f = alive[i];\n            if (remaining[f] <= 0) continue;\n            int best = -1;\n            ll bestC = 0;\n            ll bestDur = 0;\n            for (size_t k = 0; k < fs[f].bins.size(); k++) {\n                if (started[f][k]) continue;\n                int b = fs[f].bins[k];\n                while (!bend[b].empty() && bend[b].top() <= t) bend[b].pop();\n                ll C = (ll)bend[b].size();\n                ll dur = fs[f].D + R[b] + C;\n                if (t + dur > L) continue;\n                if (best < 0 || C < bestC) {\n                    best = (int)k;\n                    bestC = C;\n                    bestDur = dur;\n                }\n            }\n            if (best >= 0) {\n                int b = fs[f].bins[best];\n                started[f][best] = 1;\n                remaining[f]--;\n                ll end = t + bestDur;\n                bend[b].push(end);\n                tasks[e].push_back(\"impl \" + fs[f].name + \" \" + to_string(b));\n                ev.push({end, e});\n                done = true;\n            }\n        }\n        // If nothing feasible, this engineer stays idle.\n    }\n\n    int E = 0;\n    for (int e = 0; e < G; e++)\n        if (!tasks[e].empty()) E++;\n\n    string out;\n    out += to_string(E) + \"\\n\";\n    for (int e = 0; e < G; e++) {\n        if (tasks[e].empty()) continue;\n        out += to_string(tasks[e].size()) + \"\\n\";\n        for (auto &s : tasks[e]) {\n            out += s;\n            out += \"\\n\";\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
