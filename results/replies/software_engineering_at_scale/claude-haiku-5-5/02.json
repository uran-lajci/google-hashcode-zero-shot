    "text": "This is a heuristic, not an optimal solver. It builds a valid schedule with a greedy list-scheduling pass, runs it with three feature orderings, and outputs the best one. Each feature is implemented in each binary that holds one of its services, and no service is moved. Engineers never wait, and the schedule is deterministic. I haven't compiled or run it against the judge's data, so the exact scoring interpretation (for example, whether an engineer finishing exactly on day t counts toward C) is an assumption.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Feat {\n    string name;\n    int D;\n    long long U;\n    vector<int> bins;\n};\n\nint L, G, S, B, F, N;\nvector<int> R;\nvector<Feat> fs;\n\n// Range-add / point-query Fenwick per binary (diff-array BIT).\nstruct Fen {\n    vector<int> a;\n    void init(int n) { a.assign(n + 1, 0); }\n    void add(int i, int v) {\n        for (; i < (int)a.size(); i += i & -i) a[i] += v;\n    }\n    int sum(int i) const {\n        int s = 0;\n        for (; i > 0; i -= i & -i) s += a[i];\n        return s;\n    }\n};\n\nstruct Job {\n    int b, t, end, e;\n};\n\npair<long long, vector<vector<string>>> runSchedule(const vector<int>& order) {\n    set<pair<int, int>> pq;  // (free time, engineer)\n    for (int e = 0; e < G; e++) pq.insert({0, e});\n\n    vector<Fen> fen(B);\n    for (int b = 0; b < B; b++) fen[b].init(L + 3);\n\n    vector<vector<string>> tasks(G);\n    long long score = 0;\n\n    for (int f : order) {\n        const Feat& ft = fs[f];\n        vector<Job> jobs;\n        bool ok = true;\n        int maxEnd = 0;\n\n        for (int b : ft.bins) {\n            if (pq.empty()) { ok = false; break; }\n            auto it = pq.begin();\n            int t = it->first, e = it->second;\n            pq.erase(it);\n            if (t >= L) {\n                pq.insert({t, e});\n                ok = false;\n                break;\n            }\n            // Engineers working on binary b at day t (committed intervals).\n            int C = fen[b].sum(t + 1);\n            int dur = ft.D + R[b] + C;\n            int end = t + dur;\n            pq.insert({end, e});\n            jobs.push_back({b, t, end, e});\n            maxEnd = max(maxEnd, end);\n            if (end >= L) { ok = false; break; }\n        }\n\n        if (!ok || maxEnd >= L) {\n            // Rollback in reverse order.\n            for (int i = (int)jobs.size() - 1; i >= 0; i--) {\n                pq.erase({jobs[i].end, jobs[i].e});\n                pq.insert({jobs[i].t, jobs[i].e});\n            }\n            continue;\n        }\n\n        // Commit.\n        for (const Job& j : jobs) {\n            // Interval [t, end-1] is active for binary j.b.\n            fen[j.b].add(j.t + 1, 1);\n            fen[j.b].add(j.end - 1 + 2, -1);\n            tasks[j.e].push_back(\"impl \" + ft.name + \" \" + to_string(j.b));\n        }\n        score += ft.U * (long long)(L - maxEnd);\n    }\n    return {score, tasks};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> L >> G >> S >> B >> F >> N;\n    R.assign(B, 0);\n    unordered_map<string, int> serviceBin;\n    serviceBin.reserve(S * 2 + 1);\n    for (int i = 0; i < S; i++) {\n        string name;\n        int b;\n        cin >> name >> b;\n        serviceBin[name] = b;\n        R[b]++;\n    }\n\n    fs.resize(F);\n    for (int i = 0; i < F; i++) {\n        int M;\n        cin >> fs[i].name >> M >> fs[i].D >> fs[i].U;\n        vector<int> bs;\n        for (int k = 0; k < M; k++) {\n            string s;\n            cin >> s;\n            auto it = serviceBin.find(s);\n            if (it != serviceBin.end()) bs.push_back(it->second);\n        }\n        sort(bs.begin(), bs.end());\n        bs.erase(unique(bs.begin(), bs.end()), bs.end());\n        fs[i].bins = bs;\n    }\n\n    // Candidate orderings.\n    vector<double> base(F, 0.0);\n    for (int i = 0; i < F; i++) {\n        double s = 0;\n        for (int b : fs[i].bins) s += fs[i].D + R[b];\n        base[i] = s;\n    }\n\n    vector<vector<int>> orders;\n    {\n        vector<int> o(F);\n        iota(o.begin(), o.end(), 0);\n        // Density: U / total base work.\n        sort(o.begin(), o.end(), [&](int a, int b) {\n            double ka = fs[a].U / max(1.0, base[a]);\n            double kb = fs[b].U / max(1.0, base[b]);\n            if (ka != kb) return ka > kb;\n            return a < b;\n        });\n        orders.push_back(o);\n    }\n    {\n        vector<int> o(F);\n        iota(o.begin(), o.end(), 0);\n        sort(o.begin(), o.end(), [&](int a, int b) {\n            if (fs[a].U != fs[b].U) return fs[a].U > fs[b].U;\n            return a < b;\n        });\n        orders.push_back(o);\n    }\n    {\n        vector<int> o(F);\n        iota(o.begin(), o.end(), 0);\n        sort(o.begin(), o.end(), [&](int a, int b) {\n            double ka = (double)fs[a].U / (fs[a].D + 1.0);\n            double kb = (double)fs[b].U / (fs[b].D + 1.0);\n            if (ka != kb) return ka > kb;\n            return a < b;\n        });\n        orders.push_back(o);\n    }\n\n    long long bestScore = -1;\n    vector<vector<string>> bestTasks;\n    for (const auto& o : orders) {\n        auto res = runSchedule(o);\n        if (res.first > bestScore) {\n            bestScore = res.first;\n            bestTasks = move(res.second);\n        }\n    }\n\n    int E = 0;\n    for (int e = 0; e < G; e++)\n        if (!bestTasks[e].empty()) E++;\n\n    string out;\n    out += to_string(E) + \"\\n\";\n    for (int e = 0; e < G; e++) {\n        if (bestTasks[e].empty()) continue;\n        out += to_string(bestTasks[e].size()) + \"\\n\";\n        for (const string& s : bestTasks[e]) {\n            out += s;\n            out += \"\\n\";\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
