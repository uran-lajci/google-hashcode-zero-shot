    "text": "This is a greedy list scheduler. It compiles each needed file once, on the server that finishes it earliest. Files are ordered by latest-start slack, and any file that would miss its latest allowed finish is dropped. I haven't compiled or run it against the official data sets, so treat it as a solid heuristic rather than a tuned solution.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int C, T, S;\n    cin >> C >> T >> S;\n\n    vector<string> name(C);\n    vector<ll> c(C), r(C);\n    vector<vector<int>> deps(C);\n    unordered_map<string, int> id;\n    id.reserve(C * 2 + 1);\n\n    for (int i = 0; i < C; i++) {\n        cin >> name[i] >> c[i] >> r[i];\n        id[name[i]] = i;\n        int n;\n        cin >> n;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string s;\n            cin >> s;\n            deps[i][k] = id.at(s);\n        }\n    }\n\n    vector<char> isT(C, 0);\n    vector<ll> D(C, 0);\n    for (int t = 0; t < T; t++) {\n        string s;\n        ll d, g;\n        cin >> s >> d >> g;\n        int k = id.at(s);\n        isT[k] = 1;\n        D[k] = d;\n    }\n\n    const ll INF = (ll)1e18;\n\n    // needed: targets and all their ancestors (deps have smaller indices)\n    vector<char> need(C, 0);\n    for (int i = 0; i < C; i++)\n        if (isT[i]) need[i] = 1;\n    for (int i = C - 1; i >= 0; i--)\n        if (need[i])\n            for (int p : deps[i]) need[p] = 1;\n\n    // latest finish time allowed for each file (same-server, no replication delay)\n    vector<ll> LF(C, INF);\n    for (int i = 0; i < C; i++)\n        if (isT[i]) LF[i] = D[i];\n    for (int i = C - 1; i >= 0; i--) {\n        if (!need[i]) continue;\n        for (int p : deps[i])\n            LF[p] = min(LF[p], LF[i] - c[i]);\n    }\n\n    vector<vector<int>> ch(C);\n    vector<int> indeg(C, 0);\n    for (int i = 0; i < C; i++) {\n        indeg[i] = (int)deps[i].size();\n        for (int p : deps[i]) ch[p].push_back(i);\n    }\n\n    vector<ll> fin(C, 0);\n    vector<int> srv(C, -1);\n    vector<char> dead(C, 0);\n    vector<ll> freeT(S, 0);\n    vector<pair<int, int>> steps;\n\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n    for (int i = 0; i < C; i++)\n        if (need[i] && indeg[i] == 0)\n            pq.push({LF[i] - c[i], i});\n\n    while (!pq.empty()) {\n        int f = pq.top().second;\n        pq.pop();\n\n        bool bad = false;\n        for (int p : deps[f])\n            if (dead[p]) { bad = true; break; }\n\n        if (!bad) {\n            ll best = INF;\n            int bs = -1;\n            for (int s = 0; s < S; s++) {\n                ll st = freeT[s];\n                for (int p : deps[f]) {\n                    ll av = (srv[p] == s) ? fin[p] : fin[p] + r[p];\n                    if (av > st) st = av;\n                }\n                ll fn = st + c[f];\n                if (fn < best) {\n                    best = fn;\n                    bs = s;\n                }\n            }\n            if (best > LF[f]) {\n                bad = true;\n            } else {\n                fin[f] = best;\n                srv[f] = bs;\n                freeT[bs] = best;\n                steps.push_back({f, bs});\n            }\n        }\n        if (bad) dead[f] = 1;\n\n        for (int j : ch[f]) {\n            if (!need[j]) continue;\n            if (--indeg[j] == 0)\n                pq.push({LF[j] - c[j], j});\n        }\n    }\n\n    if (steps.empty()) {\n        // Fallback: a valid (zero-score) submission.\n        steps.push_back({0, 0});\n    }\n\n    string out;\n    out.reserve(steps.size() * 16 + 16);\n    out += to_string(steps.size());\n    out += '\\n';\n    for (auto &st : steps) {\n        out += name[st.first];\n        out += ' ';\n        out += to_string(st.second);\n        out += '\\n';\n    }\n    cout << out;\n    