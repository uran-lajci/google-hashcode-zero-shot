    "text": "This is a greedy list-scheduling heuristic. It compiles only the ancestors of the targets, places each file on the server that gives it the earliest finish time, and tries two topological orders, keeping the better score. It is not guaranteed optimal.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\nconst ll INF = (ll)4e18;\n\nint C, T, S;\nvector<string> names;\nvector<ll> cT, rT, dl, gp;\nvector<vector<int>> deps;\nvector<char> needed;\nvector<ll> pr;\n\nstruct Result {\n    vector<ll> fin, start;\n    vector<int> place;\n    ll score;\n};\n\nResult schedule(const vector<int>& order) {\n    Result R;\n    R.fin.assign(C, 0);\n    R.start.assign(C, 0);\n    R.place.assign(C, -1);\n    vector<ll> freeT(S, 0);\n    vector<ll> own(S, 0);\n    for (int f : order) {\n        // reset own\n        fill(own.begin(), own.end(), 0);\n        ll best1 = 0;\n        int p1 = -1;\n        for (int d : deps[f]) {\n            int pd = R.place[d];\n            own[pd] = max(own[pd], R.fin[d]);\n            ll A = R.fin[d] + rT[d];\n            if (A > best1 || p1 == -1) {\n                if (A > best1) { best1 = A; p1 = pd; }\n            }\n        }\n        ll bestExcl = 0;\n        for (int d : deps[f]) {\n            int pd = R.place[d];\n            if (pd != p1) {\n                bestExcl = max(bestExcl, R.fin[d] + rT[d]);\n            }\n        }\n        ll bestFin = INF;\n        int bestS = 0;\n        ll bestStart = 0;\n        for (int s = 0; s < S; s++) {\n            ll ready = own[s];\n            ll other = (s == p1) ? bestExcl : best1;\n            ready = max(ready, other);\n            ll st = max(freeT[s], ready);\n            ll fn = st + cT[f];\n            if (fn < bestFin) {\n                bestFin = fn;\n                bestS = s;\n                bestStart = st;\n            }\n        }\n        R.place[f] = bestS;\n        R.fin[f] = bestFin;\n        R.start[f] = bestStart;\n        freeT[bestS] = bestFin;\n    }\n    R.score = 0;\n    for (int i = 0; i < C; i++) {\n        if (dl[i] >= 0 && needed[i] && R.fin[i] <= dl[i]) {\n            R.score += dl[i] - R.fin[i] + gp[i];\n        }\n    }\n    return R;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> C >> T >> S;\n    names.resize(C);\n    cT.resize(C);\n    rT.resize(C);\n    deps.resize(C);\n    dl.assign(C, -1);\n    gp.assign(C, 0);\n    unordered_map<string, int> idx;\n    idx.reserve(C * 2 + 10);\n    for (int i = 0; i < C; i++) {\n        cin >> names[i] >> cT[i] >> rT[i];\n        idx[names[i]] = i;\n        int n;\n        cin >> n;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string dn;\n            cin >> dn;\n            deps[i][k] = idx[dn];\n        }\n    }\n    for (int t = 0; t < T; t++) {\n        string tn;\n        ll d, g;\n        cin >> tn >> d >> g;\n        int id = idx[tn];\n        dl[id] = d;\n        gp[id] = g;\n    }\n\n    // needed: ancestors of targets (including targets)\n    needed.assign(C, 0);\n    vector<int> st;\n    for (int i = 0; i < C; i++) {\n        if (dl[i] >= 0) {\n            if (!needed[i]) {\n                needed[i] = 1;\n                st.push_back(i);\n            }\n        }\n    }\n    while (!st.empty()) {\n        int x = st.back();\n        st.pop_back();\n        for (int d : deps[x]) {\n            if (!needed[d]) {\n                needed[d] = 1;\n                st.push_back(d);\n            }\n        }\n    }\n\n    // priority: min deadline of targets depending on file (propagated backward)\n    pr.assign(C, INF);\n    for (int i = 0; i < C; i++) {\n        if (dl[i] >= 0) pr[i] = min(pr[i], dl[i]);\n    }\n    for (int i = C - 1; i >= 0; i--) {\n        if (!needed[i]) continue;\n        for (int d : deps[i]) {\n            pr[d] = min(pr[d], pr[i]);\n        }\n    }\n\n    // order 1: index order (topological since deps come earlier)\n    vector<int> order1;\n    for (int i = 0; i < C; i++) if (needed[i]) order1.push_back(i);\n\n    // order 2: Kahn with priority by deadline\n    vector<vector<int>> children(C);\n    vector<int> indeg(C, 0);\n    for (int i = 0; i < C; i++) {\n        if (!needed[i]) continue;\n        indeg[i] = deps[i].size();\n        for (int d : deps[i]) children[d].push_back(i);\n    }\n    vector<int> order2;\n    {\n        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n        for (int i = 0; i < C; i++) {\n            if (needed[i] && indeg[i] == 0) pq.push({pr[i], i});\n        }\n        while (!pq.empty()) {\n            auto [p, x] = pq.top();\n            pq.pop();\n            order2.push_back(x);\n            for (int ch : children[x]) {\n                indeg[ch]--;\n                if (indeg[ch] == 0) pq.push({pr[ch], ch});\n            }\n        }\n    }\n\n    Result R1 = schedule(order1);\n    Result R2 = schedule(order2);\n    Result& best = (R2.score > R1.score) ? R2 : R1;\n\n    // collect steps, sort by start time (stable with index)\n    vector<int> steps;\n    for (int i = 0; i < C; i++) if (needed[i]) steps.push_back(i);\n    sort(steps.begin(), steps.end(), [&](int a, int b) {\n        if (best.start[a] != best.start[b]) return best.start[a] < best.start[b];\n        return a < b;\n    });\n\n    string out;\n    out.reserve(steps.size() * 16 + 16);\n    out += to_string(steps.size());\n    out += '\\n';\n    for (int f : steps) {\n        out += names[f];\n        out += ' ';\n        out += to_string(best.place[f]);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
