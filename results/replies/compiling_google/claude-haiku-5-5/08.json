    "text": "This is a greedy heuristic, not an optimal solver. It processes targets in deadline order and, for each target, tries every server. On each server it compiles the missing ancestors (replicating from existing copies where possible), then keeps the server that gives the best net score gain. Trials are rolled back with an undo log. Recursion is iterative to avoid stack overflow on deep dependency chains, and a deterministic work counter (not the clock) bounds the runtime. I have not compiled or run it against the sample, so treat it as untested.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst ll INF = LLONG_MAX / 4;\nconst ll WORK_LIMIT = 300000000LL;\n\nint C, T, S;\nvector<string> nm;\nvector<ll> cc, rr;\nvector<vector<int>> dep;\nvector<vector<pair<int, ll>>> cop;   // copies: (server, finish time)\nvector<ll> F;                        // per-server free time\nstruct LogEntry { int f, s; ll oldF; };\nvector<LogEntry> lg;                 // compile log (== submission steps)\nll work = 0;\n\nll avail(int f, int s) {\n    ll best = INF;\n    for (auto &p : cop[f]) {\n        ll v = p.second + (p.first == s ? 0 : rr[f]);\n        if (v < best) best = v;\n    }\n    work += cop[f].size() + 1;\n    return best;\n}\n\nvoid undoTo(size_t mark) {\n    while (lg.size() > mark) {\n        LogEntry e = lg.back();\n        lg.pop_back();\n        F[e.s] = e.oldF;\n        cop[e.f].pop_back();\n    }\n}\n\nstruct Fr { int f; size_t idx; ll mx; };\n\n// Returns time when file `root` is available on server s.\n// If forceRoot, root is compiled on s regardless of existing copies.\nll compileTree(int root, int s, bool forceRoot) {\n    if (!forceRoot) {\n        ll a = avail(root, s);\n        if (a < INF) return a;\n    }\n    vector<Fr> st;\n    st.push_back({root, 0, 0});\n    ll ret = 0;\n    bool haveRet = false;\n    while (!st.empty()) {\n        size_t top = st.size() - 1;\n        if (haveRet) {\n            st[top].mx = max(st[top].mx, ret);\n            st[top].idx++;\n            haveRet = false;\n        }\n        bool pushed = false;\n        int f = st[top].f;\n        while (st[top].idx < dep[f].size()) {\n            int d = dep[f][st[top].idx];\n            ll a = avail(d, s);\n            work++;\n            if (a < INF) {\n                st[top].mx = max(st[top].mx, a);\n                st[top].idx++;\n            } else {\n                st.push_back({d, 0, 0});\n                pushed = true;\n                break;\n            }\n        }\n        if (pushed) continue;\n        ll start = max(F[s], st[top].mx);\n        ll fin = start + cc[f];\n        lg.push_back({f, s, F[s]});\n        F[s] = fin;\n        cop[f].push_back({s, fin});\n        work++;\n        ret = fin;\n        haveRet = true;\n        st.pop_back();\n        if (st.empty()) return fin;\n    }\n    return ret;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    cin >> C >> T >> S;\n    nm.resize(C);\n    cc.resize(C);\n    rr.resize(C);\n    dep.assign(C, {});\n    cop.assign(C, {});\n    F.assign(S, 0);\n    unordered_map<string, int> id;\n    id.reserve(C * 2 + 1);\n    for (int i = 0; i < C; i++) {\n        string name;\n        cin >> name >> cc[i] >> rr[i];\n        int n;\n        cin >> n;\n        nm[i] = name;\n        id[name] = i;\n        dep[i].resize(n);\n        for (int j = 0; j < n; j++) {\n            string dn;\n            cin >> dn;\n            dep[i][j] = id[dn];\n        }\n    }\n    vector<int> tg(T);\n    vector<ll> dl(T), gp(T);\n    for (int i = 0; i < T; i++) {\n        string name;\n        cin >> name >> dl[i] >> gp[i];\n        tg[i] = id[name];\n    }\n\n    vector<int> order(T);\n    for (int i = 0; i < T; i++) order[i] = i;\n    stable_sort(order.begin(), order.end(), [&](int a, int b) { return dl[a] < dl[b]; });\n\n    for (int oi = 0; oi < T; oi++) {\n        if (work > WORK_LIMIT) break;\n        int ti = order[oi];\n        int t = tg[ti];\n        ll d = dl[ti], g = gp[ti];\n        ll bestVal = 0;\n        int bestS = -1;\n        for (int s = 0; s < S; s++) {\n            ll A = avail(t, s);\n            ll oldScore = (A < INF && A <= d) ? d - A + g : 0;\n            size_t mark = lg.size();\n            ll fin = compileTree(t, s, true);\n            undoTo(mark);\n            if (fin < A && fin <= d) {\n                ll val = (d - fin + g) - oldScore;\n                if (val > bestVal) {\n                    bestVal = val;\n                    bestS = s;\n                }\n            }\n            if (work > WORK_LIMIT) break;\n        }\n        if (bestS >= 0) {\n            compileTree(t, bestS, true);\n        }\n    }\n\n    if (lg.empty()) {\n        // Fallback: produce a valid (zero-score) submission with one target.\n        compileTree(tg[order[0]], 0, true);\n    }\n\n    string out;\n    out.reserve(lg.size() * 16 + 16);\n    out += to_string(lg.size());\n    out += '\\n';\n    for (auto &e : lg) {\n        out += nm[e.f];\n        out += ' ';\n        out += to_string(e.s);\n        out += '\\n';\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
