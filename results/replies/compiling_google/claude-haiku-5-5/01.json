    "text": "This is a greedy heuristic, not an optimal solver. It compiles each target's missing ancestors in dependency order, placing each file on the server that finishes it earliest. A target is kept only if it meets its deadline, and otherwise its tentative work is rolled back. It runs two target orderings and outputs the better schedule. I have not compiled or run it against real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint C, T, S;\nvector<string> names;\nvector<ll> cc, rr;\nvector<vector<int>> deps;\nvector<ll> dl, gp;          // deadline / goal points, valid for targets\nvector<int> isTarget;\nvector<int> targets;\n\nconst ll WORK_LIMIT = 1500000000LL;\n\nstruct Result {\n    ll score = 0;\n    vector<pair<int,int>> steps;\n};\n\nResult runSchedule(const vector<int>& order) {\n    vector<ll> freeT(S, 0);\n    vector<int> srv(C, -1);\n    vector<ll> fin(C, 0);\n    vector<pair<int,int>> steps;\n    vector<ll> oldFree;\n    ll score = 0;\n    ll work = 0;\n    vector<int> stamp(C, 0);\n    int cur = 0;\n    vector<ll> loc(S, 0);\n\n    auto placeFile = [&](int f) -> pair<int,ll> {\n        // returns (server, finish)\n        const auto& ds = deps[f];\n        ll best1 = 0; int srv1 = -1;\n        for (int d : ds) {\n            ll v = fin[d] + rr[d];\n            if (v > best1) { best1 = v; srv1 = srv[d]; }\n        }\n        ll best2 = 0;\n        for (int d : ds) {\n            if (srv[d] != srv1) best2 = max(best2, fin[d] + rr[d]);\n        }\n        fill(loc.begin(), loc.end(), 0LL);\n        for (int d : ds) loc[srv[d]] = max(loc[srv[d]], fin[d]);\n        int bestS = 0; ll bestF = LLONG_MAX;\n        for (int s = 0; s < S; s++) {\n            ll avail = max(loc[s], (s == srv1) ? best2 : best1);\n            ll start = max(freeT[s], avail);\n            ll f2 = start + cc[f];\n            if (f2 < bestF) { bestF = f2; bestS = s; }\n        }\n        work += S + 2LL * (ll)ds.size();\n        return {bestS, bestF};\n    };\n\n    auto commit = [&](int f, int s, ll finish) {\n        oldFree.push_back(freeT[s]);\n        freeT[s] = finish;\n        srv[f] = s;\n        fin[f] = finish;\n        steps.push_back({f, s});\n    };\n\n    auto rollbackTo = [&](size_t pos) {\n        while (steps.size() > pos) {\n            auto [f, s] = steps.back();\n            freeT[s] = oldFree.back();\n            oldFree.pop_back();\n            srv[f] = -1;\n            steps.pop_back();\n        }\n    };\n\n    for (int t : order) {\n        if (srv[t] >= 0) {\n            if (fin[t] <= dl[t]) score += dl[t] - fin[t] + gp[t];\n            continue;\n        }\n        if (work > WORK_LIMIT) break;\n\n        // collect unscheduled ancestors (including t) in postorder\n        cur++;\n        vector<int> ord;\n        vector<pair<int,int>> st;\n        stamp[t] = cur;\n        st.push_back({t, 0});\n        while (!st.empty()) {\n            int v = st.back().first;\n            int &idx = st.back().second;\n            if (idx < (int)deps[v].size()) {\n                int d = deps[v][idx];\n                idx++;\n                if (srv[d] < 0 && stamp[d] != cur) {\n                    stamp[d] = cur;\n                    st.push_back({d, 0});\n                }\n            } else {\n                ord.push_back(v);\n                st.pop_back();\n            }\n        }\n        work += (ll)ord.size() * 4;\n\n        size_t startPos = steps.size();\n        for (int f : ord) {\n            auto [s, fi] = placeFile(f);\n            commit(f, s, fi);\n        }\n        if (fin[t] <= dl[t]) {\n            score += dl[t] - fin[t] + gp[t];\n        } else {\n            rollbackTo(startPos);\n        }\n    }\n\n    Result res;\n    res.score = score;\n    res.steps = steps;\n    return res;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> C >> T >> S;\n    names.resize(C);\n    cc.resize(C);\n    rr.resize(C);\n    deps.assign(C, {});\n    dl.assign(C, 0);\n    gp.assign(C, 0);\n    isTarget.assign(C, 0);\n    unordered_map<string,int> id;\n    id.reserve(C * 2 + 1);\n    for (int i = 0; i < C; i++) {\n        string nm; ll c, r; int n;\n        cin >> nm >> c >> r >> n;\n        names[i] = nm;\n        cc[i] = c;\n        rr[i] = r;\n        id[nm] = i;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string dn;\n            cin >> dn;\n            deps[i][k] = id[dn];\n        }\n    }\n    for (int k = 0; k < T; k++) {\n        string nm; ll d, g;\n        cin >> nm >> d >> g;\n        int i = id[nm];\n        isTarget[i] = 1;\n        dl[i] = d;\n        gp[i] = g;\n        targets.push_back(i);\n    }\n\n    vector<int> ordA = targets;\n    sort(ordA.begin(), ordA.end(), [&](int a, int b) {\n        if (dl[a] != dl[b]) return dl[a] < dl[b];\n        if (gp[a] != gp[b]) return gp[a] > gp[b];\n        return a < b;\n    });\n    vector<int> ordB = targets;\n    sort(ordB.begin(), ordB.end(), [&](int a, int b) {\n        if (gp[a] != gp[b]) return gp[a] > gp[b];\n        if (dl[a] != dl[b]) return dl[a] < dl[b];\n        return a < b;\n    });\n\n    Result best = runSchedule(ordA);\n    Result other = runSchedule(ordB);\n    if (other.score > best.score) best = other;\n\n    string out;\n    if (best.steps.empty()) {\n        // Must output at least one step; file 0 has no dependencies.\n        out += \"1\\n\" + names[0] + \" 0\\n\";\n    } else {\n        out += to_string(best.steps.size()) + \"\\n\";\n        for (auto& [f, s] : best.steps) {\n            out += names[f];\n            out += ' ';\n            out += to_string(s);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
