    "text": "This is a heuristic list scheduler, not an optimal solver. It schedules only the files needed by targets, in order of latest finish time, and places each compile on the server that finishes it earliest. It has not been run against real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int C, T, S;\n    cin >> C >> T >> S;\n\n    vector<string> name(C);\n    vector<ll> c(C), r(C);\n    vector<vector<int>> deps(C);\n    unordered_map<string, int> id;\n    id.reserve(C * 2 + 10);\n\n    for (int i = 0; i < C; i++) {\n        cin >> name[i] >> c[i] >> r[i];\n        int n;\n        cin >> n;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string s;\n            cin >> s;\n            deps[i][k] = id[s];\n        }\n        id[name[i]] = i;\n    }\n\n    const ll INF = LLONG_MAX / 4;\n    vector<ll> dl(C, -1);\n    vector<char> isT(C, 0);\n    for (int t = 0; t < T; t++) {\n        string s;\n        ll d, g;\n        cin >> s >> d >> g;\n        int i = id[s];\n        isT[i] = 1;\n        dl[i] = d;\n    }\n\n    // Needed files: ancestors of targets (including targets).\n    vector<char> need(C, 0);\n    for (int i = 0; i < C; i++) need[i] = isT[i];\n    for (int i = C - 1; i >= 0; i--) {\n        if (!need[i]) continue;\n        for (int p : deps[i]) need[p] = 1;\n    }\n\n    // Latest finish time to still meet some target deadline through descendants.\n    vector<ll> lf(C, INF);\n    for (int i = 0; i < C; i++) if (isT[i]) lf[i] = dl[i];\n    for (int i = C - 1; i >= 0; i--) {\n        if (!need[i]) continue;\n        for (int p : deps[i]) lf[p] = min(lf[p], lf[i] - c[i]);\n    }\n\n    // Build children lists and indegrees among needed files.\n    vector<vector<int>> children(C);\n    vector<int> indeg(C, 0);\n    for (int i = 0; i < C; i++) {\n        if (!need[i]) continue;\n        for (int p : deps[i]) {\n            children[p].push_back(i);\n            indeg[i]++;\n        }\n    }\n\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n    for (int i = 0; i < C; i++) {\n        if (need[i] && indeg[i] == 0) pq.push({lf[i], i});\n    }\n\n    vector<ll> avail((size_t)C * S, INF);\n    vector<ll> freeAt(S, 0);\n    vector<ll> tmp(S);\n    vector<pair<int, int>> steps;\n    steps.reserve(1024);\n\n    while (!pq.empty()) {\n        int f = pq.top().second;\n        pq.pop();\n\n        for (int s = 0; s < S; s++) tmp[s] = freeAt[s];\n        for (int p : deps[f]) {\n            const ll* av = &avail[(size_t)p * S];\n            for (int s = 0; s < S; s++) tmp[s] = max(tmp[s], av[s]);\n        }\n\n        int best = 0;\n        for (int s = 1; s < S; s++) {\n            if (tmp[s] < tmp[best]) best = s;\n        }\n        ll fin = tmp[best] + c[f];\n        freeAt[best] = fin;\n\n        ll* af = &avail[(size_t)f * S];\n        for (int s = 0; s < S; s++) {\n            ll v = fin + (s == best ? 0 : r[f]);\n            if (v < af[s]) af[s] = v;\n        }\n\n        steps.push_back({f, best});\n\n        for (int j : children[f]) {\n            if (--indeg[j] == 0) pq.push({lf[j], j});\n        }\n    }\n\n    string out;\n    out.reserve(steps.size() * 16 + 16);\n    out += to_string(steps.size());\n    out += '\\n';\n    for (auto& st : steps) {\n        out += name[st.first];\n        out += ' ';\n        out += to_string(st.second);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
