s++) {\n            long long start = freeT[s];\n            for (int u : dep[f]) {\n                long long a = (srv[u] == s) ? fin[u] : fin[u] + r[u];\n                if (a > start) start = a;\n            }\n            long long fe = start + c[f];\n            if (fe < bestFin) {\n                bestFin = fe;\n                bestS = s;\n            }\n        }\n        steps.push_back({f, bestS, freeT[bestS]});\n        freeT[bestS] = bestFin;\n        sched[f] = 1;\n        srv[f] = bestS;\n        fin[f] = bestFin;\n    };\n\n    vector<int> order;\n    vector<pair<int, int>> stk;\n\n    for (int idx = 0; idx < T; idx++) {\n        int k = torder[idx];\n        int t = tf[k];\n        if (sched[t]) continue;\n\n        double elapsed = chrono::duration<double>(chrono::steady_clock::now() - startTime).count();\n        if (elapsed > 8.5) break;\n\n        size_t save = steps.size();\n\n        // Gather unscheduled dependency closure of t in topological order.\n        stamp++;\n        order.clear();\n        stk.clear();\n        stk.push_back({t, 0});\n        vis[t] = stamp;\n        while (!stk.empty()) {\n            int v = stk.back().first;\n            int kk = stk.back().second;\n            if (kk < (int)dep[v].size()) {\n                stk.back().second++;\n                int u = dep[v][kk];\n                if (!sched[u] && vis[u] != stamp) {\n                    vis[u] = stamp;\n                    stk.push_back({u, 0});\n                }\n            } else {\n                order.push_back(v);\n                stk.pop_back();\n            }\n        }\n\n        for (int f : order) scheduleFile(f);\n\n        if (fin[t] <= td[k]) {\n            // keep\n        } else {\n            while (steps.size() > save) {\n                Step st = steps.back();\n                steps.pop_back();\n                sched[st.f] = 0;\n                srv[st.f] = -1;\n                freeT[st.s] = st.prevFree;\n            }\n        }\n    }\n\n    