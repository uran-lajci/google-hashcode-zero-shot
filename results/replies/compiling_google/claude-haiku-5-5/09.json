    "text": "This is a greedy list-scheduling heuristic, not an optimal solver. Targets are processed by deadline. Each target's unscheduled ancestors are placed in index order, which is topological, on whichever server finishes them earliest. A target's batch is kept only if the target meets its deadline; otherwise it is rolled back. I have not compiled or run it against real data.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nstatic const ll INF = (ll)4e18;\n\nint C, T, S;\nvector<string> names;\nvector<vector<int>> deps;\nvector<ll> cc, rr;\nvector<ll> av;        // av[f*S+s]: time f is available on server s\nvector<ll> fin;       // finish time of the (first) compilation of f\nvector<int> srv;      // server of the compilation of f\nvector<char> sched;\nvector<ll> freeT;     // free time per server\nvector<pair<int,int>> seq;  // (file, server) in submission order\nvector<int> mark;\nint stampCnt = 0;\n\nvoid commitFile(int f) {\n    int bs = -1;\n    ll bestF = INF;\n    for (int s = 0; s < S; s++) {\n        ll st = freeT[s];\n        for (int d : deps[f]) st = max(st, av[(ll)d * S + s]);\n        ll F = st + cc[f];\n        if (F < bestF) { bestF = F; bs = s; }\n    }\n    srv[f] = bs;\n    fin[f] = bestF;\n    sched[f] = 1;\n    freeT[bs] = bestF;\n    for (int s = 0; s < S; s++) {\n        if (s == bs) av[(ll)f * S + s] = bestF;\n        else av[(ll)f * S + s] = bestF + rr[f];\n    }\n    seq.push_back({f, bs});\n}\n\nbool attempt(int t, ll limit) {\n    // collect unscheduled ancestors (including t)\n    stampCnt++;\n    vector<int> list;\n    vector<int> st;\n    st.push_back(t);\n    mark[t] = stampCnt;\n    while (!st.empty()) {\n        int u = st.back(); st.pop_back();\n        if (sched[u]) continue;\n        list.push_back(u);\n        for (int d : deps[u]) {\n            if (!sched[d] && mark[d] != stampCnt) {\n                mark[d] = stampCnt;\n                st.push_back(d);\n            }\n        }\n    }\n    sort(list.begin(), list.end());\n\n    // save state\n    size_t seqSave = seq.size();\n    vector<ll> freeSave = freeT;\n    vector<int> touched;\n    for (int f : list) {\n        commitFile(f);\n        touched.push_back(f);\n    }\n    if (sched[t] && fin[t] <= limit) return true;\n\n    // rollback\n    for (int f : touched) {\n        sched[f] = 0;\n        srv[f] = -1;\n        fin[f] = INF;\n        for (int s = 0; s < S; s++) av[(ll)f * S + s] = INF;\n    }\n    seq.resize(seqSave);\n    freeT = freeSave;\n    return false;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> C >> T >> S;\n    names.resize(C);\n    deps.assign(C, {});\n    cc.assign(C, 0);\n    rr.assign(C, 0);\n    unordered_map<string, int> idx;\n    idx.reserve(C * 2 + 1);\n    for (int i = 0; i < C; i++) {\n        string name;\n        ll c, r;\n        int n;\n        cin >> name >> c >> r >> n;\n        names[i] = name;\n        cc[i] = c;\n        rr[i] = r;\n        idx[name] = i;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string dn;\n            cin >> dn;\n            deps[i][k] = idx[dn];\n        }\n    }\n\n    vector<int> tgt(T);\n    vector<ll> dl(T), gp(T);\n    for (int i = 0; i < T; i++) {\n        string name;\n        ll d, g;\n        cin >> name >> d >> g;\n        tgt[i] = idx[name];\n        dl[i] = d;\n        gp[i] = g;\n    }\n\n    av.assign((ll)C * S, INF);\n    fin.assign(C, INF);\n    srv.assign(C, -1);\n    sched.assign(C, 0);\n    freeT.assign(S, 0);\n    mark.assign(C, 0);\n\n    vector<int> order(T);\n    for (int i = 0; i < T; i++) order[i] = i;\n    sort(order.begin(), order.end(), [&](int a, int b) {\n        if (dl[a] != dl[b]) return dl[a] < dl[b];\n        if (gp[a] != gp[b]) return gp[a] > gp[b];\n        return a < b;\n    });\n\n    for (int oi : order) {\n        int ti = order[oi == 0 ? 0 : 0]; // placeholder to keep structure simple\n        (void)ti;\n    }\n    for (int oi : order) {\n        attempt(tgt[oi], dl[oi]);\n    }\n\n    if (seq.empty()) {\n        // fallback: must output at least one step\n        attempt(tgt[order[0]], INF);\n    }\n\n    string out;\n    out.reserve(seq.size() * 16 + 16);\n    out += to_string(seq.size());\n    out += '\\n';\n    for (auto &p : seq) {\n        out += names[p.first];\n        out += ' ';\n        out += to_string(p.second);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
