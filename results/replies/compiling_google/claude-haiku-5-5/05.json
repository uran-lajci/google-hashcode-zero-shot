    "text": "This is a greedy list-scheduling heuristic. Targets are processed in deadline order. For each target that can't already score, the program tries every server and simulates compiling the target there, along with any ancestors that exist nowhere yet. It commits the best placement only if the target meets its deadline. Steps are written in commit order, so every dependency is listed before its dependents. I have not compiled or run this against the data sets, so treat it as a tested-by-reasoning baseline rather than a verified one.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\nconst ll INF = LLONG_MAX / 4;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    auto startTime = chrono::steady_clock::now();\n\n    int C, T, S;\n    cin >> C >> T >> S;\n    vector<string> name(C);\n    vector<ll> cc(C), rr(C);\n    vector<vector<int>> dep(C);\n    unordered_map<string, int> id;\n    id.reserve(C * 2 + 10);\n    for (int i = 0; i < C; i++) {\n        string nm;\n        ll c, r;\n        int n;\n        cin >> nm >> c >> r >> n;\n        name[i] = nm;\n        id[nm] = i;\n        cc[i] = c;\n        rr[i] = r;\n        dep[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string dn;\n            cin >> dn;\n            dep[i][k] = id[dn];\n        }\n    }\n    vector<int> tg(T);\n    vector<ll> dl(T), gp(T);\n    for (int j = 0; j < T; j++) {\n        string nm;\n        ll d, g;\n        cin >> nm >> d >> g;\n        tg[j] = id[nm];\n        dl[j] = d;\n        gp[j] = g;\n    }\n    vector<int> ord(T);\n    for (int j = 0; j < T; j++) ord[j] = j;\n    sort(ord.begin(), ord.end(), [&](int a, int b) {\n        if (dl[a] != dl[b]) return dl[a] < dl[b];\n        if (gp[a] != gp[b]) return gp[a] > gp[b];\n        return a < b;\n    });\n\n    vector<ll> bestF(C, INF);\n    vector<vector<pair<int, ll>>> inst(C);\n    vector<ll> freeT(S, 0);\n    vector<int> vis(C, 0);\n    int stamp = 0;\n    vector<ll> tmpFin(C, 0);\n    vector<pair<int, int>> out;\n\n    auto localFin = [&](int v, int s) -> ll {\n        for (auto &p : inst[v])\n            if (p.first == s) return p.second;\n        return INF;\n    };\n\n    // Simulate compiling order (closure nodes) then root on server s.\n    // Returns root finish time; fills tmpFin.\n    auto sim = [&](const vector<int> &order, int root, int s) -> ll {\n        ll fs = freeT[s];\n        auto proc = [&](int u) {\n            ll st = fs;\n            for (int v : dep[u]) {\n                ll a;\n                if (bestF[v] >= INF) {\n                    a = tmpFin[v];\n                } else {\n                    a = bestF[v] + rr[v];\n                    ll lf = localFin(v, s);\n                    if (lf < a) a = lf;\n                }\n                if (a > st) st = a;\n            }\n            ll fin = st + cc[u];\n            tmpFin[u] = fin;\n            fs = fin;\n        };\n        for (int u : order) proc(u);\n        proc(root);\n        return fs;\n    };\n\n    const size_t LIMIT = 4000;\n    for (int oi = 0; oi < T; oi++) {\n        double el = chrono::duration<double>(chrono::steady_clock::now() - startTime).count();\n        if (el > 8.0) break;\n\n        int idx = ord[oi];\n        int t = tg[idx];\n        ll d = dl[idx];\n        if (bestF[t] <= d) continue;\n\n        stamp++;\n        vector<int> order;\n        bool bad = false;\n        vis[t] = stamp;\n        vector<pair<int, int>> stk;\n        stk.push_back({t, 0});\n        while (!stk.empty() && !bad) {\n            int u = stk.back().first;\n            int k = stk.back().second;\n            if (k < (int)dep[u].size()) {\n                stk.back().second++;\n                int v = dep[u][k];\n                if (bestF[v] >= INF && vis[v] != stamp) {\n                    vis[v] = stamp;\n                    stk.push_back({v, 0});\n                    if (order.size() + stk.size() > LIMIT) bad = true;\n                }\n            } else {\n                if (u != t) order.push_back(u);\n                stk.pop_back();\n            }\n        }\n        if (bad) continue;\n\n        int bestS = -1;\n        ll bestFin = INF;\n        for (int s = 0; s < S; s++) {\n            if (localFin(t, s) < INF) continue;\n            ll f = sim(order, t, s);\n            if (f < bestFin) {\n                bestFin = f;\n                bestS = s;\n            }\n        }\n        if (bestS < 0 || bestFin > d) continue;\n\n        sim(order, t, bestS);\n        for (int u : order) {\n            ll fin = tmpFin[u];\n            out.push_back({u, bestS});\n            inst[u].push_back({bestS, fin});\n            if (fin < bestF[u]) bestF[u] = fin;\n        }\n        {\n            ll fin = tmpFin[t];\n            out.push_back({t, bestS});\n            inst[t].push_back({bestS, fin});\n            if (fin < bestF[t]) bestF[t] = fin;\n        }\n        freeT[bestS] = bestFin;\n    }\n\n    string buf;\n    buf.reserve(out.size() * 16 + 16);\n    buf += to_string(out.size());\n    buf += '\\n';\n    for (auto &p : out) {\n        buf += name[p.first];\n        buf += ' ';\n        buf += to_string(p.second);\n        buf += '\\n';\n    }\n    fwrite(buf.data(), 1, buf.size(), stdout);\n    return 0;\n}\n```",
