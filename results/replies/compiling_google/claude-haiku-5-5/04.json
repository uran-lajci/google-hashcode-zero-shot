    "text": "This is a list-scheduling heuristic. It compiles only the dependency closure of the targets, in input order (which is already topological). Each file goes to the server that finishes it earliest, using the replication-aware availability times. Every step is written in scheduling order, so dependencies always appear before their dependents and each server's simulated start times match the ones computed here. I have not run it against the hidden data sets, so the score is unverified.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int C, T, S;\n    cin >> C >> T >> S;\n\n    vector<string> name(C);\n    vector<long long> ctime(C), rtime(C);\n    vector<vector<int>> deps(C);\n    unordered_map<string, int> idx;\n    idx.reserve(C * 2 + 1);\n\n    for (int i = 0; i < C; i++) {\n        cin >> name[i] >> ctime[i] >> rtime[i];\n        int n;\n        cin >> n;\n        deps[i].resize(n);\n        for (int k = 0; k < n; k++) {\n            string dn;\n            cin >> dn;\n            deps[i][k] = idx[dn];\n        }\n        idx[name[i]] = i;\n    }\n\n    vector<int> targets(T);\n    for (int t = 0; t < T; t++) {\n        string tn;\n        long long d, g;\n        cin >> tn >> d >> g;\n        targets[t] = idx[tn];\n    }\n\n    // Mark needed files: closure of targets. Deps have smaller indices.\n    vector<char> need(C, 0);\n    for (int t : targets) need[t] = 1;\n    for (int i = C - 1; i >= 0; i--) {\n        if (need[i]) {\n            for (int d : deps[i]) need[d] = 1;\n        }\n    }\n\n    const long long INF = (long long)1e18;\n    // avail[d*S + s] = earliest time file d is usable on server s\n    vector<long long> avail((size_t)C * S, INF);\n    vector<long long> freeAt(S, 0);\n    vector<long long> ready(S);\n\n    vector<pair<int, int>> steps; // (file, server)\n    steps.reserve((size_t)C);\n\n    for (int f = 0; f < C; f++) {\n        if (!need[f]) continue;\n\n        fill(ready.begin(), ready.end(), 0LL);\n        for (int d : deps[f]) {\n            const long long* av = &avail[(size_t)d * S];\n            for (int s = 0; s < S; s++) {\n                if (av[s] > ready[s]) ready[s] = av[s];\n            }\n        }\n\n        int best = 0;\n        long long bestFin = INF;\n        for (int s = 0; s < S; s++) {\n            long long start = max(ready[s], freeAt[s]);\n            long long fin = start + ctime[f];\n            if (fin < bestFin) {\n                bestFin = fin;\n                best = s;\n            }\n        }\n\n        freeAt[best] = bestFin;\n        steps.push_back({f, best});\n\n        size_t base = (size_t)f * S;\n        for (int s = 0; s < S; s++) {\n            if (s == best) avail[base + s] = bestFin;\n            else avail[base + s] = bestFin + rtime[f];\n        }\n    }\n\n    string out;\n    out.reserve(steps.size() * 16 + 16);\n    out += to_string(steps.size());\n    out += '\\n';\n    for (auto& st : steps) {\n        out += name[st.first];\n        out += ' ';\n        out += to_string(st.second);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
