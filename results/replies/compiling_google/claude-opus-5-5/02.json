    "text": "Approach: greedy list scheduling that tries several target orderings and outputs the best one.\n\n**Per target**\n1. Targets whose critical path (the longest chain of compile times through their dependencies) is longer than their deadline are skipped. They can never score.\n2. Otherwise, collect the target's not-yet-compiled dependency files.\n3. Schedule them in topological order. Input order already is one, since dependencies are always listed earlier.\n4. Each file goes to the server where it would finish earliest. That depends on when the server is free and when each dependency is available there: immediately if it was compiled on that server, otherwise after its replication time.\n5. If the target would miss its deadline, everything scheduled for it is undone. No server time is wasted on targets that score nothing.\n\n**Orderings tried:** value per unit of work, earliest deadline, and largest value. Each run is scored by its own schedule, and the best one is printed.\n\n**Why the output is valid:** steps are printed sorted by planned start time.\n- Every compile takes at least 1 second, so any copy of a dependency used in the plan started strictly earlier than the step that needs it. It therefore appears earlier in the file.\n- Each server's steps keep their planned order.\n- The judge starts every step as soon as possible, so its actual times can only be equal to or earlier than the planned ones. The real score is at least the computed score.\n- No file is compiled twice, so E \u2264 C \u00d7 S.\n- If nothing can be scheduled at all, one file with no dependencies is output so that E \u2265 1.\n\n**Determinism:** runs are capped by counting work operations, not by the clock, so the same input always gives the same output.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint C,T,S;\nvector<ll> cc, rr;\nvector<vector<int>> deps;\nvector<int> tIdx; vector<ll> tD, tG;\nvector<ll> cp;\n\nstruct Result{ ll score; vector<array<ll,3>> steps; };\n\nResult run(const vector<int>& order, ll budget){\n    vector<int> srv(C,-1); vector<ll> fin(C,0);\n    vector<ll> freeT(S,0);\n    vector<int> stamp(C,0); int st=0;\n    vector<array<ll,3>> steps;\n    ll work=0;\n    vector<int> clos, stk, cand;\n    for(int ti: order){\n        if(work>budget) break;\n        int t=tIdx[ti]; ll d=tD[ti];\n        if(cp[t]>d) continue;\n        if(srv[t]!=-1) continue;\n        st++; clos.clear(); stk.clear();\n        stk.push_back(t); stamp[t]=st;\n        while(!stk.empty()){\n            int f=stk.back(); stk.pop_back(); clos.push_back(f); work++;\n            for(int x: deps[f]){ work++; if(srv[x]==-1 && stamp[x]!=st){stamp[x]=st; stk.push_back(x);} }\n        }\n        sort(clos.begin(),clos.end());\n        vector<ll> saved=freeT;\n        size_t stepBase=steps.size();\n        bool ok=true; size_t done=0;\n        for(int f: clos){\n            ll R=0; cand.clear();\n            for(int x: deps[f]){ R=max(R,fin[x]+rr[x]); cand.push_back(srv[x]); }\n            work+=deps[f].size()+S;\n            int bs=-1; ll bf=LLONG_MAX;\n            for(int s=0;s<S;s++){\n                ll fn=max(freeT[s],R)+cc[f];\n                if(fn<bf){bf=fn;bs=s;}\n            }\n            for(int s: cand){\n                ll rd=0;\n                for(int x: deps[f]){ ll a=(srv[x]==s)?fin[x]:fin[x]+rr[x]; rd=max(rd,a);}\n                work+=deps[f].size();\n                ll fn=max(freeT[s],rd)+cc[f];\n                if(fn<bf){bf=fn;bs=s;}\n            }\n            srv[f]=bs; fin[f]=bf; freeT[bs]=bf;\n            steps.push_back({bf-cc[f],(ll)f,(ll)bs});\n            done++;\n            ll lim = d - (f!=t?cc[t]:0);\n            if(bf>lim){ok=false;break;}\n        }\n        if(!ok){\n            for(size_t i=0;i<done;i++){ srv[clos[i]]=-1; fin[clos[i]]=0; }\n            freeT=saved; steps.resize(stepBase);\n        }\n    }\n    ll score=0;\n    for(int i=0;i<T;i++){\n        int t=tIdx[i];\n        if(srv[t]!=-1 && fin[t]<=tD[i]) score+=tD[i]-fin[t]+tG[i];\n    }\n    return {score,steps};\n}\n\nint main(){\n    ios::sync_with_stdio(false); cin.tie(nullptr);\n    cin>>C>>T>>S;\n    cc.resize(C); rr.resize(C); deps.resize(C);\n    vector<string> names(C);\n    unordered_map<string,int> id; id.reserve(C*2);\n    for(int i=0;i<C;i++){\n        cin>>names[i]>>cc[i]>>rr[i]; id[names[i]]=i;\n        int n; cin>>n; deps[i].resize(n);\n        for(int j=0;j<n;j++){string s; cin>>s; deps[i][j]=id[s];}\n    }\n    tIdx.resize(T); tD.resize(T); tG.resize(T);\n    for(int i=0;i<T;i++){string s; cin>>s>>tD[i]>>tG[i]; tIdx[i]=id[s];}\n    cp.assign(C,0);\n    for(int i=0;i<C;i++){ ll m=0; for(int x:deps[i]) m=max(m,cp[x]); cp[i]=m+cc[i]; }\n    // work estimates\n    vector<double> wk(T);\n    {\n        vector<int> stamp(C,0); int st=0; ll visits=0; const ll CAP=30000000;\n        vector<int> stk;\n        for(int i=0;i<T;i++){\n            if(visits>CAP){ wk[i]=(double)cp[tIdx[i]]; continue; }\n            st++; stk.clear(); stk.push_back(tIdx[i]); stamp[tIdx[i]]=st; double sum=0;\n            while(!stk.empty()){\n                int f=stk.back(); stk.pop_back(); sum+=cc[f]; visits++;\n                for(int x:deps[f]){ visits++; if(stamp[x]!=st){stamp[x]=st; stk.push_back(x);} }\n            }\n            wk[i]=sum;\n        }\n    }\n    vector<vector<int>> orders;\n    vector<int> base(T); iota(base.begin(),base.end(),0);\n    {\n        vector<int> o=base;\n        stable_sort(o.begin(),o.end(),[&](int a,int b){\n            double va=(double)(tG[a]+max(0LL,tD[a]-cp[tIdx[a]]))/max(1.0,wk[a]);\n            double vb=(double)(tG[b]+max(0LL,tD[b]-cp[tIdx[b]]))/max(1.0,wk[b]);\n            return va>vb;});\n        orders.push_back(o);\n    }\n    {\n        vector<int> o=base;\n        stable_sort(o.begin(),o.end(),[&](int a,int b){return tD[a]<tD[b];});\n        orders.push_back(o);\n    }\n    {\n        vector<int> o=base;\n        stable_sort(o.begin(),o.end(),[&](int a,int b){\n            return tG[a]+max(0LL,tD[a]-cp[tIdx[a]]) > tG[b]+max(0LL,tD[b]-cp[tIdx[b]]);});\n        orders.push_back(o);\n    }\n    Result best{-1,{}};\n    for(auto& o: orders){\n        Result r=run(o,150000000LL);\n        if(r.score>best.score) best=move(r);\n    }\n    auto& steps=best.steps;\n    if(steps.empty()){\n        int f=0; for(int i=0;i<C;i++) if(deps[i].empty()){f=i;break;}\n        cout<<1<<\"\\n\"<<names[f]<<\" 0\\n\";\n        return 0;\n    }\n    stable_sort(steps.begin(),steps.end(),[](const array<ll,3>&a,const array<ll,3>&b){return a[0]<b[0];});\n    string out; out.reserve(steps.size()*16);\n    out+=to_string(steps.size()); out+='\\n';\n    for(auto& s: steps){ out+=names[s[1]]; out+=' '; out+=to_string(s[2]); out+='\\n'; }\n    cout<<out;\n    return 0;\n}\n```",
