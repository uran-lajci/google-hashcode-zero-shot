    "text": "This is a greedy heuristic, not an exact solver. It repeatedly picks the library with the best estimated score per signup day. The estimate is the sum of the top unscanned books the library can ship before the deadline, divided by its signup time. A lazy max-heap avoids recomputing every library at each step. I haven't compiled or run it against the judge data.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int B, L;\n    long long D;\n    cin >> B >> L >> D;\n    vector<long long> S(B);\n    for (int i = 0; i < B; i++) cin >> S[i];\n\n    vector<int> N(L), T(L), M(L);\n    vector<vector<int>> books(L);\n    for (int j = 0; j < L; j++) {\n        cin >> N[j] >> T[j] >> M[j];\n        books[j].resize(N[j]);\n        for (int k = 0; k < N[j]; k++) cin >> books[j][k];\n        sort(books[j].begin(), books[j].end(), [&](int a, int b) {\n            if (S[a] != S[b]) return S[a] > S[b];\n            return a < b;\n        });\n    }\n\n    vector<char> scanned(B, 0);\n\n    // Evaluate library j if its signup starts at day t.\n    // Returns -1 if signup finishes at or after D, otherwise total value.\n    // If out != nullptr, appends the selected books (in scan order).\n    auto eval = [&](int j, long long t, vector<int>* out) -> long long {\n        long long f = t + T[j];\n        if (f >= D) return -1;\n        long long R = D - f;\n        long long k = min((long long)M[j] * R, (long long)N[j]);\n        long long val = 0;\n        long long cnt = 0;\n        for (int id : books[j]) {\n            if (cnt >= k) break;\n            if (scanned[id]) continue;\n            val += S[id];\n            cnt++;\n            if (out) out->push_back(id);\n        }\n        return val;\n    };\n\n    priority_queue<pair<double, int>> pq;\n    for (int j = 0; j < L; j++) {\n        long long v = eval(j, 0, nullptr);\n        if (v > 0) {\n            pq.push({(double)v / T[j], j});\n        }\n    }\n\n    vector<pair<int, vector<int>>> chosen;\n    long long t = 0;\n    while (!pq.empty()) {\n        auto top = pq.top();\n        pq.pop();\n        int j = top.second;\n        long long v = eval(j, t, nullptr);\n        if (v <= 0) continue;  // -1: too late, 0: nothing useful\n        double nr = (double)v / T[j];\n        if (pq.empty() || nr >= pq.top().first) {\n            vector<int> sel;\n            eval(j, t, &sel);\n            for (int id : sel) scanned[id] = 1;\n            chosen.push_back({j, sel});\n            t += T[j];\n        } else {\n            pq.push({nr, j});\n        }\n    }\n\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(chosen.size());\n    out += '\\n';\n    for (auto& c : chosen) {\n        out += to_string(c.first);\n        out += ' ';\n        out += to_string(c.second.size());\n        out += '\\n';\n        for (size_t i = 0; i < c.second.size(); i++) {\n            if (i) out += ' ';\n            out += to_string(c.second[i]);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
