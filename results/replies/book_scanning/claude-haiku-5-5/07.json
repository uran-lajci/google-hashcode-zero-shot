    "text": "This is a greedy heuristic, not a provably optimal solver. It repeatedly signs up the library with the best estimated score per signup day, using lazy re-evaluation of a priority queue, since a library's value only decreases as the plan grows. For each chosen library, it scans its highest-scoring books that no earlier library has already covered, up to its daily capacity for the remaining days. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint B, L, D;\nvector<int> score_;\nvector<int> Nn, Tt, Mm;\nvector<vector<int>> lists; // sorted by score desc\nvector<int> ptrIdx;\nvector<char> scanned;\nll curDay = 0;\n\ndouble evalLib(int j) {\n    ll start = curDay + Tt[j];\n    if (start >= D) return 0.0;\n    ll avail = D - start;\n    ll need = min(avail * (ll)Mm[j], (ll)Nn[j]);\n    int &p = ptrIdx[j];\n    while (p < (int)lists[j].size() && scanned[lists[j][p]]) p++;\n    ll sum = 0, cnt = 0;\n    for (int idx = p; idx < (int)lists[j].size() && cnt < need; idx++) {\n        int b = lists[j][idx];\n        if (!scanned[b]) {\n            sum += score_[b];\n            cnt++;\n        }\n    }\n    if (cnt == 0) return 0.0;\n    return (double)sum / (double)Tt[j];\n}\n\nstruct Entry {\n    double val;\n    int j;\n    int stamp;\n    bool operator<(const Entry &o) const {\n        if (val != o.val) return val < o.val;\n        return j > o.j;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> B >> L >> D;\n    score_.resize(B);\n    for (int i = 0; i < B; i++) cin >> score_[i];\n\n    Nn.resize(L); Tt.resize(L); Mm.resize(L);\n    lists.resize(L);\n    for (int j = 0; j < L; j++) {\n        cin >> Nn[j] >> Tt[j] >> Mm[j];\n        lists[j].resize(Nn[j]);\n        for (int k = 0; k < Nn[j]; k++) cin >> lists[j][k];\n        sort(lists[j].begin(), lists[j].end(), [&](int a, int b) {\n            if (score_[a] != score_[b]) return score_[a] > score_[b];\n            return a < b;\n        });\n    }\n\n    ptrIdx.assign(L, 0);\n    scanned.assign(B, 0);\n\n    priority_queue<Entry> pq;\n    for (int j = 0; j < L; j++) {\n        double v = evalLib(j);\n        if (v > 0) pq.push({v, j, 0});\n    }\n\n    int sel = 0;\n    vector<pair<int, vector<int>>> result;\n\n    while (!pq.empty()) {\n        if (curDay >= D) break;\n        Entry e = pq.top();\n        pq.pop();\n        if (e.stamp != sel) {\n            double v = evalLib(e.j);\n            if (v > 0) pq.push({v, e.j, sel});\n            continue;\n        }\n        if (e.val <= 0) break;\n\n        int j = e.j;\n        ll start = curDay + Tt[j];\n        ll avail = D - start;\n        ll need = min(avail * (ll)Mm[j], (ll)Nn[j]);\n        vector<int> books;\n        for (int idx = ptrIdx[j]; idx < (int)lists[j].size() && (ll)books.size() < need; idx++) {\n            int b = lists[j][idx];\n            if (!scanned[b]) {\n                scanned[b] = 1;\n                books.push_back(b);\n            }\n        }\n        if (!books.empty()) result.push_back({j, books});\n        curDay += Tt[j];\n        sel++;\n    }\n\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(result.size());\n    out += '\\n';\n    for (auto &r : result) {\n        out += to_string(r.first);\n        out += ' ';\n        out += to_string(r.second.size());\n        out += '\\n';\n        for (size_t i = 0; i < r.second.size(); i++) {\n            if (i) out += ' ';\n            out += to_string(r.second[i]);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
