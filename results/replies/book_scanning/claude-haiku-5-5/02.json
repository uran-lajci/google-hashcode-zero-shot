    "text": "This is a greedy heuristic, not a provably optimal solver. It repeatedly signs up the library with the best estimated scan value per signup day, using a lazy priority queue. A library's value only decreases as time passes and books get scanned, so stale queue entries are valid upper bounds. I have not compiled or run it against the judge's data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint B, L, D;\nvector<int> S;\nvector<long long> Nn, Tt, Mm;\nvector<vector<int>> lib;   // books of each library, sorted by score desc\nvector<char> scanned;\nvector<int> ptrs;          // skip pointer: prefix of scanned books\n\n// Value of library j when signup starts at day t: sum of top-k unscanned\n// scores divided by signup time. Optionally collects the chosen books.\ndouble evalLib(int j, long long t, vector<int>* out) {\n    long long rem = (long long)D - t - Tt[j];\n    if (rem <= 0) return 0.0;\n    long long kmax = min(Mm[j] * rem, Nn[j]);\n    const vector<int>& bk = lib[j];\n    int n = (int)bk.size();\n    while (ptrs[j] < n && scanned[bk[ptrs[j]]]) ptrs[j]++;\n    double sum = 0;\n    long long cnt = 0;\n    for (int idx = ptrs[j]; idx < n && cnt < kmax; idx++) {\n        int b = bk[idx];\n        if (!scanned[b]) {\n            sum += S[b];\n            cnt++;\n            if (out) out->push_back(b);\n        }\n    }\n    if (cnt == 0) return 0.0;\n    return sum / (double)Tt[j];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> B >> L >> D;\n    S.assign(B, 0);\n    for (int i = 0; i < B; i++) cin >> S[i];\n\n    Nn.assign(L, 0);\n    Tt.assign(L, 0);\n    Mm.assign(L, 0);\n    lib.assign(L, {});\n    for (int j = 0; j < L; j++) {\n        cin >> Nn[j] >> Tt[j] >> Mm[j];\n        lib[j].resize((size_t)Nn[j]);\n        for (int k = 0; k < Nn[j]; k++) cin >> lib[j][k];\n        sort(lib[j].begin(), lib[j].end(), [&](int a, int b) {\n            if (S[a] != S[b]) return S[a] > S[b];\n            return a < b;\n        });\n    }\n\n    scanned.assign(B, 0);\n    ptrs.assign(L, 0);\n\n    priority_queue<pair<double, int>> pq;\n    for (int j = 0; j < L; j++) {\n        double v = evalLib(j, 0, nullptr);\n        if (v > 0) pq.push({v, j});\n    }\n\n    long long t = 0;\n    vector<pair<int, vector<int>>> chosen;\n\n    while (!pq.empty()) {\n        auto top = pq.top();\n        pq.pop();\n        int j = top.second;\n        if ((long long)D - t - Tt[j] <= 0) continue;\n\n        double v = evalLib(j, t, nullptr);\n        if (v <= 0) continue;\n\n        if (pq.empty() || v >= pq.top().first) {\n            vector<int> books;\n            evalLib(j, t, &books);\n            for (int b : books) scanned[b] = 1;\n            t += Tt[j];\n            chosen.push_back({j, books});\n        } else {\n            pq.push({v, j});\n        }\n    }\n\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(chosen.size());\n    out += '\\n';\n    for (auto& c : chosen) {\n        out += to_string(c.first);\n        out += ' ';\n        out += to_string(c.second.size());\n        out += '\\n';\n        for (size_t i = 0; i < c.second.size(); i++) {\n            if (i) out += ' ';\n            out += to_string(c.second[i]);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
