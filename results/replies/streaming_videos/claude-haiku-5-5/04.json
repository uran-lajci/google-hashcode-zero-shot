    "text": "This is a lazy greedy heuristic, not a proven optimum. It repeatedly adds the (video, cache) pair with the highest time saved per megabyte, using a max-heap. Marginal gains only shrink as caches fill, so stale heap entries are recomputed on pop and reinserted if their key has dropped. I haven't compiled or run it against real data.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Entry {\n    double key;\n    long long gain;\n    int v, c;\n    bool operator<(const Entry& o) const {\n        if (key != o.key) return key < o.key;\n        if (gain != o.gain) return gain < o.gain;\n        if (v != o.v) return v > o.v;\n        return c > o.c;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int V, E, R, C;\n    long long X;\n    cin >> V >> E >> R >> C >> X;\n\n    vector<int> S(V);\n    for (int i = 0; i < V; i++) cin >> S[i];\n\n    vector<int> LD(E);\n    vector<vector<pair<int,int>>> conn(E);          // (cache, latency)\n    vector<int> lat((size_t)E * C, -1);             // lat[e*C + c]\n    for (int e = 0; e < E; e++) {\n        int K;\n        cin >> LD[e] >> K;\n        conn[e].resize(K);\n        for (int k = 0; k < K; k++) {\n            int c, Lc;\n            cin >> c >> Lc;\n            conn[e][k] = {c, Lc};\n            lat[(size_t)e * C + c] = Lc;\n        }\n    }\n\n    // requests per video: (endpoint, count), merged\n    vector<vector<pair<int,int>>> rq(V);\n    for (int r = 0; r < R; r++) {\n        int v, e, n;\n        cin >> v >> e >> n;\n        rq[v].push_back({e, n});\n    }\n    for (int v = 0; v < V; v++) {\n        auto& a = rq[v];\n        sort(a.begin(), a.end());\n        vector<pair<int,int>> m;\n        for (auto& p : a) {\n            if (!m.empty() && m.back().first == p.first) m.back().second += p.second;\n            else m.push_back(p);\n        }\n        a.swap(m);\n    }\n\n    // initial marginal gains: everything served from data center\n    vector<long long> g((size_t)V * C, 0);\n    for (int v = 0; v < V; v++) {\n        for (auto& [e, n] : rq[v]) {\n            for (auto& [c, Lc] : conn[e]) {\n                g[(size_t)v * C + c] += (long long)n * (LD[e] - Lc);\n            }\n        }\n    }\n\n    vector<Entry> init;\n    for (int v = 0; v < V; v++) {\n        for (int c = 0; c < C; c++) {\n            long long gv = g[(size_t)v * C + c];\n            if (gv > 0) {\n                init.push_back({(double)gv / S[v], gv, v, c});\n            }\n        }\n    }\n    vector<long long>().swap(g);\n    priority_queue<Entry> pq(less<Entry>(), move(init));\n\n    // current best latency per (video, endpoint)\n    vector<int> best((size_t)V * E);\n    for (int v = 0; v < V; v++)\n        for (int e = 0; e < E; e++)\n            best[(size_t)v * E + e] = LD[e];\n\n    vector<long long> used(C, 0);\n    vector<vector<int>> chosen(C);\n\n    auto recompute = [&](int v, int c) -> long long {\n        long long gain = 0;\n        for (auto& [e, n] : rq[v]) {\n            int L = lat[(size_t)e * C + c];\n            if (L < 0) continue;\n            int cur = best[(size_t)v * E + e];\n            if (cur > L) gain += (long long)n * (cur - L);\n        }\n        return gain;\n    };\n\n    while (!pq.empty()) {\n        Entry top = pq.top();\n        pq.pop();\n        int v = top.v, c = top.c;\n        if (used[c] + S[v] > X) continue;\n        long long gn = recompute(v, c);\n        if (gn <= 0) continue;\n        if (gn != top.gain) {\n            pq.push({(double)gn / S[v], gn, v, c});\n            continue;\n        }\n        // accept\n        used[c] += S[v];\n        chosen[c].push_back(v);\n        for (auto& [e, n] : rq[v]) {\n            int L = lat[(size_t)e * C + c];\n            if (L < 0) continue;\n            int& cur = best[(size_t)v * E + e];\n            if (cur > L) cur = L;\n        }\n    }\n\n    int N = 0;\n    for (int c = 0; c < C; c++) if (!chosen[c].empty()) N++;\n\n    string out;\n    out += to_string(N) + \"\\n\";\n    for (int c = 0; c < C; c++) {\n        if (chosen[c].empty()) continue;\n        out += to_string(c);\n        for (int v : chosen[c]) {\n            out += ' ';\n            out += to_string(v);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
