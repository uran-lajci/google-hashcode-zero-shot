    "text": "This is a lazy greedy. Each (video, cache) pair is scored by its benefit (total milliseconds saved across endpoints) divided by the video's size. Pairs sit in a max-heap, and a pair's true benefit is recomputed only when it reaches the top. Benefits only shrink as videos get placed, so stale keys are always upper bounds and this lazy evaluation is safe. I have not compiled or run it against the official data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Item {\n    double key;\n    int v, c;\n    bool operator<(const Item& o) const {\n        if (key != o.key) return key < o.key;\n        if (v != o.v) return v > o.v;\n        return c > o.c;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int V, E, R, C;\n    long long X;\n    cin >> V >> E >> R >> C >> X;\n\n    vector<int> S(V);\n    for (int i = 0; i < V; i++) cin >> S[i];\n\n    vector<int> LD(E);\n    vector<vector<pair<int, int>>> conn(E);  // (cache, latency)\n    vector<int> connLat((size_t)E * C, -1);\n    for (int e = 0; e < E; e++) {\n        int K;\n        cin >> LD[e] >> K;\n        for (int k = 0; k < K; k++) {\n            int c, lc;\n            cin >> c >> lc;\n            connLat[(size_t)e * C + c] = lc;\n            conn[e].push_back({c, lc});\n        }\n    }\n\n    // benefit[v*C + c] = total time saved if video v is cached in c (with current state)\n    vector<long long> benefit((size_t)V * C, 0);\n    vector<vector<pair<int, int>>> reqs(V);  // (endpoint, count)\n    vector<vector<int>> cur(V);              // current best latency per request entry\n\n    for (int r = 0; r < R; r++) {\n        int v, e, n;\n        cin >> v >> e >> n;\n        reqs[v].push_back({e, n});\n        cur[v].push_back(LD[e]);\n        long long base = (long long)n;\n        for (auto& pr : conn[e]) {\n            benefit[(size_t)v * C + pr.first] += base * (LD[e] - pr.second);\n        }\n    }\n\n    vector<long long> rem(C, X);\n    vector<vector<int>> chosen(C);\n\n    // Build initial heap\n    vector<Item> init;\n    init.reserve(1 << 16);\n    for (int v = 0; v < V; v++) {\n        for (int c = 0; c < C; c++) {\n            long long b = benefit[(size_t)v * C + c];\n            if (b > 0) {\n                init.push_back({(double)b / S[v], v, c});\n            }\n        }\n    }\n    priority_queue<Item> pq(less<Item>(), move(init));\n\n    auto evalBenefit = [&](int v, int c) -> long long {\n        long long sum = 0;\n        const auto& rv = reqs[v];\n        const auto& cv = cur[v];\n        for (size_t j = 0; j < rv.size(); j++) {\n            int e = rv[j].first;\n            int lc = connLat[(size_t)e * C + c];\n            if (lc >= 0 && cv[j] > lc) {\n                sum += (long long)rv[j].second * (cv[j] - lc);\n            }\n        }\n        return sum;\n    };\n\n    while (!pq.empty()) {\n        Item it = pq.top();\n        pq.pop();\n        int v = it.v, c = it.c;\n        if (rem[c] < S[v]) continue;  // capacity only shrinks; never fits later\n        long long b = evalBenefit(v, c);\n        if (b <= 0) continue;\n        double nk = (double)b / S[v];\n        if (!pq.empty() && nk < pq.top().key) {\n            pq.push({nk, v, c});\n            continue;\n        }\n        // accept\n        rem[c] -= S[v];\n        chosen[c].push_back(v);\n        const auto& rv = reqs[v];\n        auto& cv = cur[v];\n        for (size_t j = 0; j < rv.size(); j++) {\n            int e = rv[j].first;\n            int lc = connLat[(size_t)e * C + c];\n            if (lc >= 0 && lc < cv[j]) cv[j] = lc;\n        }\n    }\n\n    int N = 0;\n    for (int c = 0; c < C; c++)\n        if (!chosen[c].empty()) N++;\n\n    string out;\n    out += to_string(N) + \"\\n\";\n    for (int c = 0; c < C; c++) {\n        if (chosen[c].empty()) continue;\n        out += to_string(c);\n        for (int v : chosen[c]) {\n            out += ' ';\n            out += to_string(v);\n        }\n       