    "text": "This is a lazy greedy. It repeatedly takes the (video, cache) pair with the highest marginal time saved per MB, re-checking each candidate's current gain before accepting it. Stale keys are upper bounds because a video's marginal gain can only shrink as other videos are placed, so the lazy re-check is valid. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int V, E, R, C, X;\n    cin >> V >> E >> R >> C >> X;\n\n    vector<int> S(V);\n    for (int i = 0; i < V; i++) cin >> S[i];\n\n    vector<int> LD(E);\n    // lat[c*E + e] = latency from cache c to endpoint e, -1 if not connected\n    vector<int> lat((size_t)C * E, -1);\n    vector<vector<int>> cacheEnds(C);\n    for (int e = 0; e < E; e++) {\n        int K;\n        cin >> LD[e] >> K;\n        for (int k = 0; k < K; k++) {\n            int c, Lc;\n            cin >> c >> Lc;\n            lat[(size_t)c * E + e] = Lc;\n            cacheEnds[c].push_back(e);\n        }\n    }\n\n    vector<vector<pair<int,int>>> reqs(V);   // per video: (endpoint, count)\n    vector<vector<pair<int,int>>> ereq(E);   // per endpoint: (video, count)\n    for (int r = 0; r < R; r++) {\n        int v, e, n;\n        cin >> v >> e >> n;\n        reqs[v].push_back({e, n});\n        ereq[e].push_back({v, n});\n    }\n\n    // best[v*E + e] = current best latency for video v at endpoint e\n    vector<int> best((size_t)V * E);\n    for (int v = 0; v < V; v++)\n        for (int e = 0; e < E; e++)\n            best[(size_t)v * E + e] = LD[e];\n\n    // Initial marginal gains gain[v*C + c]\n    vector<long long> gain((size_t)V * C, 0);\n    for (int c = 0; c < C; c++) {\n        for (int e : cacheEnds[c]) {\n            long long d = LD[e] - lat[(size_t)c * E + e];\n            if (d <= 0) continue;\n            for (auto [v, n] : ereq[e]) {\n                gain[(size_t)v * C + c] += (long long)n * d;\n            }\n        }\n    }\n\n    priority_queue<tuple<double, int, int>> pq;\n    for (int v = 0; v < V; v++)\n        for (int c = 0; c < C; c++) {\n            long long g = gain[(size_t)v * C + c];\n            if (g > 0) pq.emplace((double)g / S[v], v, c);\n        }\n    vector<long long>().swap(gain);\n\n    vector<long long> used(C, 0);\n    vector<vector<int>> chosen(C);\n\n    while (!pq.empty()) {\n        auto [k, v, c] = pq.top();\n        pq.pop();\n        (void)k;\n        if (used[c] + S[v] > X) continue;\n\n        // Recompute current marginal gain\n        long long g = 0;\n        for (auto [e, n] : reqs[v]) {\n            int l = lat[(size_t)c * E + e];\n            if (l < 0) continue;\n            int cur = best[(size_t)v * E + e];\n            if (cur > l) g += (long long)n * (cur - l);\n        }\n        if (g <= 0) continue;\n\n        double nk = (double)g / S[v];\n        if (!pq.empty()) {\n            auto top = pq.top();\n            if (make_tuple(nk, v, c) < top) {\n                pq.emplace(nk, v, c);\n                continue;\n            }\n        }\n\n        // Accept placement\n        used[c] += S[v];\n        chosen[c].push_back(v);\n        for (auto [e, n] : reqs[v]) {\n            int l = lat[(size_t)c * E + e];\n            if (l < 0) continue;\n            int &cur = best[(size_t)v * E + e];\n            if (l < cur) cur = l;\n        }\n    }\n\n    int cnt = 0;\n    for (int c = 0; c < C; c++)\n        if (!chosen[c].empty()) cnt++;\n\n    string out;\n    out += to_string(cnt) + \"\\n\";\n    for (int c = 0; c < C; c++) {\n        if (chosen[c].empty()) continue;\n        out += to_string(c);\n        for (int v : chosen[c]) {\n            out += ' ';\n            out += to_string(v);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
