    "text": "This is a greedy solver based on lazy evaluation. It repeatedly picks the (video, cache) pair with the highest latency saving per MB. Benefits only decrease as videos are placed, so stale heap entries are upper bounds and can be re-checked on pop. The run is single-threaded and deterministic. I haven't compiled or run it against the sample, so treat it as untested.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Item {\n    double d;\n    int v;\n    int c;\n    bool operator<(const Item& o) const {\n        if (d != o.d) return d < o.d;\n        if (v != o.v) return v > o.v;\n        return c > o.c;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int V, E, R, C, X;\n    cin >> V >> E >> R >> C >> X;\n\n    vector<int> S(V);\n    for (int i = 0; i < V; ++i) cin >> S[i];\n\n    vector<int> LD(E);\n    vector<vector<pair<int, int>>> conn(E);         // (cache, latency)\n    vector<int> Lm((size_t)E * C, -1);              // Lm[e*C+c] = latency or -1\n    for (int e = 0; e < E; ++e) {\n        int K;\n        cin >> LD[e] >> K;\n        conn[e].reserve(K);\n        for (int k = 0; k < K; ++k) {\n            int c, L;\n            cin >> c >> L;\n            conn[e].push_back({c, L});\n            Lm[(size_t)e * C + c] = L;\n        }\n    }\n\n    // rq[v] = list of (endpoint, count)\n    vector<vector<pair<int, int>>> rq(V);\n    for (int i = 0; i < R; ++i) {\n        int v, e, n;\n        cin >> v >> e >> n;\n        rq[v].push_back({e, n});\n    }\n\n    // best[v*E+e] = current best latency for video v at endpoint e\n    vector<int> best((size_t)V * E);\n    for (int v = 0; v < V; ++v)\n        for (int e = 0; e < E; ++e)\n            best[(size_t)v * E + e] = LD[e];\n\n    // benefit[v*C+c] = total time saved if video v is added to cache c\n    vector<long long> benefit((size_t)V * C, 0);\n    for (int v = 0; v < V; ++v) {\n        for (auto [e, n] : rq[v]) {\n            for (auto [c, L] : conn[e]) {\n                long long gain = (long long)n * (LD[e] - L);\n                if (gain > 0) benefit[(size_t)v * C + c] += gain;\n            }\n        }\n    }\n\n    priority_queue<Item> pq;\n    for (int v = 0; v < V; ++v) {\n        for (int c = 0; c < C; ++c) {\n            long long b = benefit[(size_t)v * C + c];\n            if (b > 0) pq.push({b / (double)S[v], v, c});\n        }\n    }\n\n    vector<long long> used(C, 0);\n    vector<vector<int>> cacheVideos(C);\n\n    while (!pq.empty()) {\n        Item t = pq.top();\n        pq.pop();\n        int v = t.v, c = t.c;\n        long long b = benefit[(size_t)v * C + c];\n        if (b <= 0) continue;\n        if (used[c] + S[v] > X) continue;\n        double cur = b / (double)S[v];\n        if (cur != t.d) {\n            pq.push({cur, v, c});\n            continue;\n        }\n\n        // Accept (v, c)\n        used[c] += S[v];\n        cacheVideos[c].push_back(v);\n\n        for (auto [e, n] : rq[v]) {\n            int Lc = Lm[(size_t)e * C + c];\n            if (Lc < 0) continue;\n            int oldB = best[(size_t)v * E + e];\n            if (Lc >= oldB) continue;\n            int newB = Lc;\n            best[(size_t)v * E + e] = newB;\n            for (auto [c2, L2] : conn[e]) {\n                long long before = max(0, oldB - L2);\n                long long after = max(0, newB - L2);\n                benefit[(size_t)v * C + c2] += (long long)n * (after - before);\n            }\n        }\n    }\n\n    int cnt = 0;\n    for (int c = 0; c < C; ++c)\n        if (!cacheVideos[c].empty()) ++cnt;\n\n    string out;\n    out += to_string(cnt) + \"\\n\";\n    for (int c = 0; c < C; ++c) {\n        if (cacheVideos[c].empty()) continue;\n        out += to_string(c);\n        for (int v : cacheVideos[c]) {\n            out += ' ';\n            out += to_string(v);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
