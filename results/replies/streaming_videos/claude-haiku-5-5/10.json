    "text": "This is a greedy heuristic with lazy re-evaluation. It repeatedly places the (video, cache) pair with the highest latency-saving gain per MB that still fits. Gains only shrink as videos are placed, so stale heap keys are upper bounds and can be re-checked lazily. I have not compiled or run it against the official data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstruct Item {\n    double key;\n    int v, c;\n    bool operator<(const Item& o) const {\n        if (key != o.key) return key < o.key;\n        if (v != o.v) return v > o.v;\n        return c > o.c;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int V, E, R, C;\n    long long X;\n    cin >> V >> E >> R >> C >> X;\n\n    vector<int> S(V);\n    for (int i = 0; i < V; ++i) cin >> S[i];\n\n    vector<int> LD(E);\n    vector<vector<pair<int, int>>> conn(E);   // (cache, latency)\n    vector<int> lat((size_t)E * C, 0);         // 0 = not connected\n    for (int e = 0; e < E; ++e) {\n        int K;\n        cin >> LD[e] >> K;\n        for (int k = 0; k < K; ++k) {\n            int c, Lc;\n            cin >> c >> Lc;\n            conn[e].push_back({c, Lc});\n            lat[(size_t)e * C + c] = Lc;\n        }\n    }\n\n    vector<vector<pair<int, int>>> dem(V);     // (endpoint, count)\n    for (int i = 0; i < R; ++i) {\n        int v, e, n;\n        cin >> v >> e >> n;\n        dem[v].push_back({e, n});\n    }\n    for (int v = 0; v < V; ++v) {\n        auto& d = dem[v];\n        sort(d.begin(), d.end());\n        vector<pair<int, int>> m;\n        for (auto& p : d) {\n            if (!m.empty() && m.back().first == p.first) m.back().second += p.second;\n            else m.push_back(p);\n        }\n        d.swap(m);\n    }\n\n    // best[v*E+e] = current best latency for endpoint e serving video v\n    vector<int> best((size_t)V * E);\n    for (int v = 0; v < V; ++v)\n        for (int e = 0; e < E; ++e)\n            best[(size_t)v * E + e] = LD[e];\n\n    // initial gains\n    vector<long long> gain((size_t)V * C, 0);\n    for (int v = 0; v < V; ++v) {\n        for (auto& [e, cnt] : dem[v]) {\n            for (auto& [c, Lc] : conn[e]) {\n                gain[(size_t)v * C + c] += (long long)cnt * (LD[e] - Lc);\n            }\n        }\n    }\n\n    priority_queue<Item> pq;\n    for (int v = 0; v < V; ++v) {\n        for (int c = 0; c < C; ++c) {\n            long long g = gain[(size_t)v * C + c];\n            if (g > 0) {\n                pq.push({(double)g / S[v], v, c});\n            }\n        }\n    }\n\n    vector<long long> rem(C, X);\n    vector<vector<int>> stored(C);\n\n    while (!pq.empty()) {\n        Item t = pq.top();\n        pq.pop();\n        int v = t.v, c = t.c;\n        if (S[v] > rem[c]) continue;\n\n        // recompute actual gain\n        long long g = 0;\n        for (auto& [e, cnt] : dem[v]) {\n            int l = lat[(size_t)e * C + c];\n            if (l > 0) {\n                int b = best[(size_t)v * E + e];\n                if (b > l) g += (long long)cnt * (b - l);\n            }\n        }\n        if (g == 0) continue;\n        double key = (double)g / S[v];\n        if (!pq.empty() && key < pq.top().key) {\n            pq.push({key, v, c});\n            continue;\n        }\n\n        // accept\n        stored[c].push_back(v);\n        rem[c] -= S[v];\n        for (auto& [e, cnt] : dem[v]) {\n            int l = lat[(size_t)e * C + c];\n            if (l > 0) {\n                int& b = best[(size_t)v * E + e];\n                if (l < b) b = l;\n            }\n        }\n    }\n\n    // output\n    int N = 0;\n    for (int c = 0; c < C; ++c)\n        if (!stored[c].empty()) ++N;\n\n    string out;\n    out += to_string(N) + \"\\n\";\n    for (int c = 0; c < C; ++c) {\n        if (stored[c].empty()) continue;\n        out += to_string(c);\n        for (int v : stored[c]) {\n            out += ' ';\n            out += to_string(v);\n        }\n        out += '\\n