    "text": "This is a greedy event-driven heuristic. It repeatedly takes the vehicle that becomes free earliest and gives it the unassigned ride with the best net value that it can still finish by its latest finish. A vehicle with no feasible ride is dropped, since its free time only increases. The solver does roughly (N + F) \u00d7 N simple operations, well within the limits. I haven't run it against the real data sets, so the score is unverified.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    long long R, C, F, N, B, T;\n    cin >> R >> C >> F >> N >> B >> T;\n\n    vector<long long> A(N), Bc(N), X(N), Y(N), S(N), Fi(N), D(N);\n    for (int i = 0; i < N; ++i) {\n        cin >> A[i] >> Bc[i] >> X[i] >> Y[i] >> S[i] >> Fi[i];\n        D[i] = llabs(A[i] - X[i]) + llabs(Bc[i] - Y[i]);\n    }\n\n    struct Vehicle {\n        long long time;\n        long long r, c;\n        vector<int> rides;\n    };\n    vector<Vehicle> veh(F);\n    for (auto& v : veh) {\n        v.time = 0;\n        v.r = 0;\n        v.c = 0;\n    }\n\n    // Min-heap by (time, id)\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                   greater<pair<long long, int>>> pq;\n    for (int i = 0; i < F; ++i) pq.push({0, i});\n\n    // Remaining unassigned rides\n    vector<int> remaining(N);\n    for (int i = 0; i < N; ++i) remaining[i] = i;\n\n    while (!pq.empty() && !remaining.empty()) {\n        auto [t, id] = pq.top();\n        pq.pop();\n        Vehicle& v = veh[id];\n\n        long long bestKey = LLONG_MIN;\n        long long bestFinish = LLONG_MAX;\n        int bestPos = -1;\n        long long bestStart = 0;\n\n        for (int k = 0; k < (int)remaining.size(); ++k) {\n            int ri = remaining[k];\n            long long d1 = llabs(v.r - A[ri]) + llabs(v.c - Bc[ri]);\n            long long arrive = t + d1;\n            long long start = max(arrive, S[ri]);\n            long long finish = start + D[ri];\n            if (finish > Fi[ri]) continue;\n            long long gain = D[ri] + (start == S[ri] ? B : 0);\n            long long key = gain - (start - t);\n            if (key > bestKey || (key == bestKey && finish < bestFinish)) {\n                bestKey = key;\n                bestFinish = finish;\n                bestPos = k;\n                bestStart = start;\n            }\n        }\n        (void)bestStart;\n\n        if (bestPos < 0) {\n            // No feasible ride for this vehicle now; its time only grows, so drop it.\n            continue;\n        }\n\n        int ri = remaining[bestPos];\n        v.rides.push_back(ri);\n        v.time = bestFinish;\n        v.r = X[ri];\n        v.c = Y[ri];\n        pq.push({v.time, id});\n\n        remaining[bestPos] = remaining.back();\n        remaining.pop_back();\n    }\n\n    string out;\n    out.reserve(1 << 20);\n    for (int i = 0; i < F; ++i) {\n        out += to_string(veh[i].rides.size());\n        for (int r : veh[i].rides) {\n            out += ' ';\n            out += to_string(r);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
