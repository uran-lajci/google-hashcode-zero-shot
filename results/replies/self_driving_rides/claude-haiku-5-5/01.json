    "text": "This is a greedy heuristic, not an optimal solver. It repeatedly takes the vehicle that becomes free earliest and gives it the unassigned ride with the best points-per-time-consumed ratio among rides it can still finish before their deadline. Rides are never reassigned, so the score is not guaranteed to be maximal. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef long long ll;\n\nstruct Ride {\n    int a, b, x, y;\n    ll s, f;\n    ll d;\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int R, C, F, N;\n    ll B, T;\n    cin >> R >> C >> F >> N >> B >> T;\n\n    vector<Ride> rides(N);\n    for (int i = 0; i < N; ++i) {\n        Ride& r = rides[i];\n        cin >> r.a >> r.b >> r.x >> r.y >> r.s >> r.f;\n        r.d = llabs((ll)r.a - r.x) + llabs((ll)r.b - r.y);\n    }\n\n    vector<bool> used(N, false);\n    vector<vector<int>> routes(F);\n    vector<int> px(F, 0), py(F, 0);\n\n    // min-heap of (free time, vehicle)\n    priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n    for (int v = 0; v < F; ++v) pq.push({0LL, v});\n\n    while (!pq.empty()) {\n        auto [t, v] = pq.top();\n        pq.pop();\n\n        int cx = px[v], cy = py[v];\n        int best = -1;\n        double bestVal = -1.0;\n        ll bestFinish = 0;\n\n        for (int i = 0; i < N; ++i) {\n            if (used[i]) continue;\n            const Ride& r = rides[i];\n            ll dToStart = llabs((ll)cx - r.a) + llabs((ll)cy - r.b);\n            ll start = max(t + dToStart, r.s);\n            ll finish = start + r.d;\n            if (finish > r.f || finish > T) continue;\n\n            ll score = r.d + (start == r.s ? B : 0);\n            ll cost = finish - t; // >= 1 since r.d >= 1\n            double val = (double)score / (double)cost;\n            if (val > bestVal) {\n                bestVal = val;\n                best = i;\n                bestFinish = finish;\n            }\n        }\n\n        if (best == -1) continue; // vehicle retires\n\n        used[best] = true;\n        routes[v].push_back(best);\n        px[v] = rides[best].x;\n        py[v] = rides[best].y;\n        pq.push({bestFinish, v});\n    }\n\n    string out;\n    out.reserve(1 << 20);\n    for (int v = 0; v < F; ++v) {\n        out += to_string(routes[v].size());\n        for (int r : routes[v]) {\n            out += ' ';\n            out += to_string(r);\n        }\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
