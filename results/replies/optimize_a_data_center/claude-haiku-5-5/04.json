    "text": "This is a greedy heuristic, not an optimal solver. It assigns servers to pools by balancing capacity, then places each server in the row where its pool currently has the least capacity, using leftmost first fit. It is deterministic and valid by construction, but the score is not guaranteed to be maximal.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint R, S, U, P, M;\nvector<vector<char>> occ;\nvector<int> rowMax;\n\nint maxRun(int r) {\n    int best = 0, cur = 0;\n    for (int s = 0; s < S; ++s) {\n        if (!occ[r][s]) { ++cur; if (cur > best) best = cur; }\n        else cur = 0;\n    }\n    return best;\n}\n\n// leftmost start of a free run of length z in row r, or -1\nint findFit(int r, int z) {\n    int cur = 0;\n    for (int s = 0; s < S; ++s) {\n        if (!occ[r][s]) {\n            ++cur;\n            if (cur == z) return s - z + 1;\n        } else cur = 0;\n    }\n    return -1;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    cin >> R >> S >> U >> P >> M;\n    occ.assign(R, vector<char>(S, 0));\n    for (int i = 0; i < U; ++i) {\n        int r, s;\n        cin >> r >> s;\n        occ[r][s] = 1;\n    }\n    rowMax.assign(R, 0);\n    for (int r = 0; r < R; ++r) rowMax[r] = maxRun(r);\n\n    vector<int> z(M), c(M);\n    for (int i = 0; i < M; ++i) cin >> z[i] >> c[i];\n\n    vector<int> order(M);\n    for (int i = 0; i < M; ++i) order[i] = i;\n    sort(order.begin(), order.end(), [&](int a, int b) {\n        if (c[a] != c[b]) return c[a] > c[b];\n        return a < b;\n    });\n\n    vector<long long> poolTot(P, 0);\n    vector<vector<long long>> poolRow(P, vector<long long>(R, 0));\n    vector<int> ansR(M, -1), ansS(M, -1), ansP(M, -1);\n    int failSize = INT_MAX;\n\n    for (int idx : order) {\n        int zz = z[idx];\n        if (zz >= failSize) continue;\n\n        // pool with smallest total capacity so far\n        int p = 0;\n        for (int q = 1; q < P; ++q)\n            if (poolTot[q] < poolTot[p]) p = q;\n\n        // row with fitting space where this pool has least capacity\n        int best = -1;\n        for (int r = 0; r < R; ++r) {\n            if (rowMax[r] >= zz) {\n                if (best == -1 || poolRow[p][r] < poolRow[p][best]) best = r;\n            }\n        }\n        if (best == -1) {\n            failSize = min(failSize, zz);\n            continue;\n        }\n        int st = findFit(best, zz);\n        if (st < 0) { // should not happen\n            failSize = min(failSize, zz);\n            continue;\n        }\n        for (int s = st; s < st + zz; ++s) occ[best][s] = 1;\n        rowMax[best] = maxRun(best);\n\n        poolTot[p] += c[idx];\n        poolRow[p][best] += c[idx];\n        ansR[idx] = best;\n        ansS[idx] = st;\n        ansP[idx] = p;\n    }\n\n    string out;\n    out.reserve((size_t)M * 12);\n    for (int i = 0; i < M; ++i) {\n        if (ansR[i] < 0) {\n            out += \"x\\n\";\n        } else {\n            out += to_string(ansR[i]);\n            out += ' ';\n            out += to_string(ansS[i]);\n            out += ' ';\n            out += to_string(ansP[i]);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
