tPool(k2, a);\n                double nf = F();\n                double d = nf - oldf;\n                if (d >= 0 || u01() < exp(d / temp)) {\n                    ll m = gcv[mt[1]];\n                    if (m > bestMin) { bestMin = m; bestPool = pool; }\n                } else {\n                    setPool(k2, b);\n                    setPool(k, a);\n                }\n            }\n        }\n    }\n\n    // output\n    string out;\n    out.reserve((size_t)M * 16);\n    for (int k = 0; k < M; k++) {\n        if (pr[k] < 0) {\n            out += \"x\\n\";\n        } else {\n            out += to_string(pr[k]);\n            out += ' ';\n            out += to_string(psl[k]);\n            out += ' ';\n            out += to_string(bestPool[k]);\n            out += '\\n';\n        }\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
