    "text": "This is a heuristic, not an exact solver. It places servers greedily by capacity density, balances the pools with an LPT-style assignment, then runs a bounded local search that moves servers between pools to raise the lowest guaranteed capacity. The search uses a fixed evaluation budget rather than a clock, so the output is deterministic. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int R, S, U, P, M;\n    cin >> R >> S >> U >> P >> M;\n    vector<vector<char>> blocked(R, vector<char>(S, 0));\n    for (int i = 0; i < U; i++) {\n        int r, s;\n        cin >> r >> s;\n        blocked[r][s] = 1;\n    }\n    vector<int> z(M), c(M);\n    for (int i = 0; i < M; i++) cin >> z[i] >> c[i];\n\n    // ---------- Placement ----------\n    vector<vector<pair<int, int>>> seg(R); // (start, len) of free runs\n    vector<int> freeCnt(R, 0), maxSeg(R, 0);\n    for (int r = 0; r < R; r++) {\n        int s = 0;\n        while (s < S) {\n            if (blocked[r][s]) { s++; continue; }\n            int st = s;\n            while (s < S && !blocked[r][s]) s++;\n            seg[r].push_back({st, s - st});\n            freeCnt[r] += s - st;\n            maxSeg[r] = max(maxSeg[r], s - st);\n        }\n    }\n\n    vector<int> ord(M);\n    iota(ord.begin(), ord.end(), 0);\n    sort(ord.begin(), ord.end(), [&](int a, int b) {\n        ll lhs = (ll)c[a] * z[b], rhs = (ll)c[b] * z[a];\n        if (lhs != rhs) return lhs > rhs;\n        return a < b;\n    });\n\n    vector<int> rowOf(M, -1), slotOf(M, -1);\n    for (int idx : ord) {\n        int best = -1;\n        for (int r = 0; r < R; r++) {\n            if (maxSeg[r] >= z[idx] && (best < 0 || freeCnt[r] > freeCnt[best])) best = r;\n        }\n        if (best < 0) continue;\n        // best fit segment\n        int bi = -1;\n        for (int j = 0; j < (int)seg[best].size(); j++) {\n            if (seg[best][j].second >= z[idx]) {\n                if (bi < 0 || seg[best][j].second < seg[best][bi].second) bi = j;\n            }\n        }\n        auto &sg = seg[best][bi];\n        rowOf[idx] = best;\n        slotOf[idx] = sg.first;\n        sg.first += z[idx];\n        sg.second -= z[idx];\n        if (sg.second == 0) seg[best].erase(seg[best].begin() + bi);\n        freeCnt[best] -= z[idx];\n        int ms = 0;\n        for (auto &q : seg[best]) ms = max(ms, q.second);\n        maxSeg[best] = ms;\n    }\n\n    // ---------- Compact placed servers ----------\n    vector<int> pl;\n    for (int i = 0; i < M; i++) if (rowOf[i] >= 0) pl.push_back(i);\n    sort(pl.begin(), pl.end(), [&](int a, int b) {\n        if (c[a] != c[b]) return c[a] > c[b];\n        return a < b;\n    });\n    int K = pl.size();\n    vector<int> srow(K), spool(K, 0);\n    vector<ll> scap(K);\n    vector<int> cidx(M, -1);\n    for (int k = 0; k < K; k++) {\n        cidx[pl[k]] = k;\n        srow[k] = rowOf[pl[k]];\n        scap[k] = c[pl[k]];\n    }\n\n    // ---------- Initial pool assignment (LPT) ----------\n    vector<ll> T(P, 0), L((size_t)P * R, 0);\n    {\n        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n        for (int p = 0; p < P; p++) pq.push({0, p});\n        for (int k = 0; k < K; k++) {\n            auto [t, p] = pq.top();\n            pq.pop();\n            spool[k] = p;\n            T[p] += scap[k];\n            L[(size_t)p * R + srow[k]] += scap[k];\n            pq.push({T[p], p});\n        }\n    }\n\n    vector<ll> top1(P), top2(P);\n    vector<int> top1row(P);\n    auto recompute = [&](int p) {\n        ll best = -1;\n        int bi = 0;\n        for (int r = 0; r < R; r++) {\n            ll v = L[(size_t)p * R + r];\n            if (v > best) { best = v; bi = r; }\n        }\n        ll sec = 0;\n        for (int r = 0; r < R; r++) {\n            if (r == bi) continue;\n            sec = max(sec, L[(size_t)p * R + r]);\n        }\n        top1[p] = max(best, 0LL);\n        top1row[p] = bi;\n        top2[p] = sec;\n    };\n    for (int p = 0; p < P; p++) recompute(p);\n\n    // ---------- Local search on pool assignment ----------\n    const ll LIMIT = 400000000LL;\n    ll evals = 0;\n    while (evals < LIMIT) {\n        // find pool with minimum guaranteed capacity\n        int q = 0;\n        ll gcq = T[0] - top1[0];\n        for (int p = 1; p < P; p++) {\n            ll g = T[p] - top1[p];\n            if (g < gcq) { gcq = g; q = p; }\n        }\n        bool found = false;\n        for (int k = 0; k < K; k++) {\n            int p = spool[k];\n            if (p == q) continue;\n            int r = srow[k];\n            ll cc = scap[k];\n            ll newGcQ = (T[q] + cc) - max(top1[q], L[(size_t)q * R + r] + cc);\n            ll newMaxP = (r == top1row[p]) ? max(top2[p], L[(size_t)p * R + r] - cc) : top1[p];\n            ll newGcP = (T[p] - cc) - newMaxP;\n            if (newGcQ > gcq && newGcP > gcq) {\n                // apply move k: p -> q\n                L[(size_t)p * R + r] -= cc;\n                L[(size_t)q * R + r] += cc;\n                T[p] -= cc;\n                T[q] += cc;\n                spool[k] = q;\n                recompute(p);\n                recompute(q);\n                found = true;\n                break;\n            }\n        }\n        evals += K + 1;\n        if (!found) break;\n    }\n\n    // ---------- Output ----------\n    string out;\n    out.reserve((size_t)M * 16);\n    for (int i = 0; i < M; i++) {\n        if (rowOf[i] < 0) {\n            out += \"x\\n\";\n        } else {\n            int k = cidx[i];\n            out += to_string(rowOf[i]);\n            out += ' ';\n            out += to_string(slotOf[i]);\n            out += ' ';\n            out += to_string(spool[k]);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
