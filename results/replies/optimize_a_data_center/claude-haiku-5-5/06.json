    "text": "This is a greedy heuristic, not an exact optimizer. It always produces a valid submission, but I have not run it against the hidden data sets, so I can't say how close its score is to the best possible.\n\nThe approach: servers are processed by descending capacity. Each goes to the pool with the lowest total so far, placed in the feasible row where that pool has the least load, using best-fit within the row. Servers with no feasible row are left unallocated.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int R, S, U, P, M;\n    cin >> R >> S >> U >> P >> M;\n\n    vector<vector<char>> blocked(R, vector<char>(S, 0));\n    for (int i = 0; i < U; i++) {\n        int r, s;\n        cin >> r >> s;\n        blocked[r][s] = 1;\n    }\n\n    // Free segments per row: (start, length)\n    vector<vector<pair<int, int>>> segs(R);\n    vector<int> maxseg(R, 0), freeCnt(R, 0);\n    for (int r = 0; r < R; r++) {\n        int s = 0;\n        while (s < S) {\n            if (blocked[r][s]) { s++; continue; }\n            int st = s;\n            while (s < S && !blocked[r][s]) s++;\n            segs[r].push_back({st, s - st});\n        }\n        for (auto &sg : segs[r]) {\n            maxseg[r] = max(maxseg[r], sg.second);\n            freeCnt[r] += sg.second;\n        }\n    }\n\n    vector<int> z(M), c(M);\n    for (int i = 0; i < M; i++) cin >> z[i] >> c[i];\n\n    vector<int> order(M);\n    for (int i = 0; i < M; i++) order[i] = i;\n    stable_sort(order.begin(), order.end(), [&](int a, int b) {\n        if (c[a] != c[b]) return c[a] > c[b];\n        return a < b;\n    });\n\n    vector<long long> load((size_t)P * R, 0), total(P, 0);\n    // min-heap of (total, pool)\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                   greater<pair<long long, int>>> heap;\n    for (int p = 0; p < P; p++) heap.push({0, p});\n\n    vector<int> ar(M, -1), as(M, -1), ap(M, -1);\n\n    for (int idx : order) {\n        int zz = z[idx], cc = c[idx];\n        int p = heap.top().second;\n\n        int best = -1;\n        for (int r = 0; r < R; r++) {\n            if (maxseg[r] < zz) continue;\n            if (best == -1) { best = r; continue; }\n            long long lr = load[(size_t)p * R + r];\n            long long lb = load[(size_t)p * R + best];\n            if (lr < lb || (lr == lb && freeCnt[r] > freeCnt[best]))\n                best = r;\n        }\n        if (best == -1) continue; // unallocated\n\n        heap.pop();\n        total[p] += cc;\n        heap.push({total[p], p});\n\n        // best-fit segment in row best\n        auto &sv = segs[best];\n        int bi = -1;\n        for (int k = 0; k < (int)sv.size(); k++) {\n            if (sv[k].second >= zz) {\n                if (bi == -1 || sv[k].second < sv[bi].second) bi = k;\n            }\n        }\n        int start = sv[bi].first;\n        int len = sv[bi].second;\n        if (len == zz) {\n            sv.erase(sv.begin() + bi);\n        } else {\n            sv[bi] = {start + zz, len - zz};\n        }\n        freeCnt[best] -= zz;\n        int mx = 0;\n        for (auto &sg : sv) mx = max(mx, sg.second);\n        maxseg[best] = mx;\n\n        load[(size_t)p * R + best] += cc;\n        ar[idx] = best;\n        as[idx] = start;\n        ap[idx] = p;\n    }\n\n    string out;\n    out.reserve((size_t)M * 12);\n    for (int i = 0; i < M; i++) {\n        if (ar[i] < 0) {\n            out += \"x\\n\";\n        } else {\n            out += to_string(ar[i]);\n            out += ' ';\n            out += to_string(as[i]);\n            out += ' ';\n            out += to_string(ap[i]);\n            out += '\\n';\n        }\n    }\n    cout << out;\n    return 0;\n}\n```",
