    "text": "This is a heuristic, not an exact solver. Each turn, every balloon picks its altitude change by looking ahead a few turns over the wind field, scoring positions by static target coverage, with a penalty for balloons already sharing a cell that turn. A balloon launches only when its launched position has positive value. I haven't compiled or run it against the data sets, so treat the scoring behaviour as untested.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstatic char buf[1 << 25];\nsize_t bufLen = 0, bufPos = 0;\n\ninline int readChar() {\n    if (bufPos == bufLen) {\n        bufLen = fread(buf, 1, sizeof(buf), stdin);\n        bufPos = 0;\n        if (bufLen == 0) return -1;\n    }\n    return buf[bufPos++];\n}\n\ninline int readInt() {\n    int ch = readChar();\n    while (ch != '-' && (ch < '0' || ch > '9')) {\n        if (ch == -1) return 0;\n        ch = readChar();\n    }\n    bool neg = false;\n    if (ch == '-') { neg = true; ch = readChar(); }\n    int x = 0;\n    while (ch >= '0' && ch <= '9') {\n        x = x * 10 + (ch - '0');\n        ch = readChar();\n    }\n    return neg ? -x : x;\n}\n\nint R, C, A, L, V, B, T, RS, CS;\nvector<int8_t> W;   // index: (((alt-1)*R + r)*C + c)*2 -> dr, dc\nvector<int> cov;    // static coverage count per cell\nconst int D = 4;\nconst double G = 0.9;\n\ninline int wIdx(int a, int r, int c) {\n    return ((a - 1) * R + r) * C + c;\n}\n\ndouble f(int a, int r, int c, int depth) {\n    if (depth == 0) return 0.0;\n    double best = 0.0;\n    for (int d = -1; d <= 1; d++) {\n        int na = a + d;\n        if (na < 1 || na > A) continue;\n        int idx = wIdx(na, r, c) * 2;\n        int nr = r + W[idx];\n        if (nr < 0 || nr >= R) continue;\n        int nc = ((c + W[idx + 1]) % C + C) % C;\n        double v = cov[nr * C + nc] + G * f(na, nr, nc, depth - 1);\n        if (v > best) best = v;\n    }\n    return best;\n}\n\nint main() {\n    R = readInt(); C = readInt(); A = readInt();\n    L = readInt(); V = readInt(); B = readInt(); T = readInt();\n    RS = readInt(); CS = readInt();\n\n    vector<int> tr(L), tc(L);\n    for (int i = 0; i < L; i++) {\n        tr[i] = readInt();\n        tc[i] = readInt();\n    }\n\n    // Read wind\n    W.assign((size_t)A * R * C * 2, 0);\n    for (int a = 1; a <= A; a++) {\n        for (int r = 0; r < R; r++) {\n            for (int c = 0; c < C; c++) {\n                size_t idx = (size_t)wIdx(a, r, c) * 2;\n                W[idx] = (int8_t)readInt();\n                W[idx + 1] = (int8_t)readInt();\n            }\n        }\n    }\n\n    // Static coverage\n    cov.assign((size_t)R * C, 0);\n    int V2 = V * V;\n    for (int i = 0; i < L; i++) {\n        int u = tr[i], v = tc[i];\n        for (int dr = -V; dr <= V; dr++) {\n            int r = u + dr;\n            if (r < 0 || r >= R) continue;\n            int w = (int)floor(sqrt((double)(V2 - dr * dr)) + 1e-9);\n            while (w > 0 && w * w > V2 - dr * dr) w--;\n            while ((w + 1) * (w + 1) <= V2 - dr * dr) w++;\n            if (2 * w + 1 >= C) {\n                for (int c = 0; c < C; c++) cov[r * C + c]++;\n            } else {\n                for (int dc = -w; dc <= w; dc++) {\n                    int c = ((v + dc) % C + C) % C;\n                    cov[r * C + c]++;\n                }\n            }\n        }\n    }\n\n    // Simulation state\n    vector<int> alt(B, 0), pr(B, 0), pc(B, 0);\n    vector<int> state(B, 0); // 0 unlaunched, 1 active, 2 lost\n    vector<int> occ((size_t)R * C, 0);\n    vector<int> touched;\n\n    string out;\n    out.reserve((size_t)T * B * 3 + 16);\n\n    for (int t = 0; t < T; t++) {\n        for (int idx : touched) occ[idx] = 0;\n        touched.clear();\n\n        for (int b = 0; b < B; b++) {\n            int delta = 0;\n            if (state[b] == 0) {\n                int idx = wIdx(1, RS, CS) * 2;\n                int nr = RS + W[idx];\n                if (nr >= 0 && nr < R) {\n                    int nc = ((CS + W[idx + 1]) % C + C) % C;\n                    int p = nr * C + nc;\n                    double val = cov[p] / (1.0 + occ[p]) + G * f(1, nr, nc, D - 1);\n                    if (val > 0) {\n                        delta = 1;\n                        state[b] = 1;\n                        alt[b] = 1;\n                        pr[b] = nr;\n                        pc[b] = nc;\n                        if (occ[p] == 0) touched.push_back(p);\n                        occ[p]++;\n                    }\n                } else {\n                    // launching would immediately lose it; do not launch\n                }\n            } else if (state[b] == 1) {\n                double bestVal = -1e18;\n                int bestD = 0;\n                int bestNr = -1, bestNc = -1, bestNa = alt[b];\n                bool bestLost = false;\n                int order[3] = {0, 1, -1};\n                for (int k = 0; k < 3; k++) {\n                    int d = order[k];\n                    int na = alt[b] + d;\n                    if (na < 1 || na > A) continue;\n                    int idx = wIdx(na, pr[b], pc[b]) * 2;\n                    int nr = pr[b] + W[idx];\n                    if (nr < 0 || nr >= R) {\n                        // lost option, value 0 (only chosen if nothing better)\n                        if (0.0 > bestVal) {\n                            bestVal = 0.0; bestD = d; bestLost = true;\n                            bestNa = na;\n                        }\n                        continue;\n                    }\n                    int nc = ((pc[b] + W[idx + 1]) % C + C) % C;\n                    int p = nr * C + nc;\n                    double val = cov[p] / (1.0 + occ[p]) + G * f(na, nr, nc, D - 1);\n                    if (val > bestVal) {\n                        bestVal = val; bestD = d;\n                        bestNr = nr; bestNc = nc; bestNa = na;\n                        bestLost = false;\n                    }\n                }\n                delta = bestD;\n                alt[b] = bestNa;\n                if (bestLost) {\n                    state[b] = 2;\n                } else {\n                    pr[b] = bestNr;\n                    pc[b] = bestNc;\n                    int p = bestNr * C + bestNc;\n                    if (occ[p] == 0) touched.push_back(p);\n                    occ[p]++;\n                }\n            } else {\n                delta = 0;\n            }\n\n            if (b) out.push_back(' ');\n            if (delta == 1) out += \"1\";\n            else if (delta == -1) out += \"-1\";\n            else out += \"0\";\n        }\n        out.push_back('\\n');\n    }\n\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
