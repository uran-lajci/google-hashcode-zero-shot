    "text": "This is a greedy heuristic, not an optimal planner. Each turn, balloons are processed in index order. A launched balloon picks the altitude change that maximizes (newly covered targets this turn) plus a discounted lookahead of target density along the path it would follow if it kept that altitude. An unlaunched balloon launches only if launching from the start cell scores positive. I have not compiled or run this against any data set, and the worst-case running time is not bounded tightly.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstatic char ibuf[1 << 16];\nstatic size_t ipos = 0, ilen = 0;\nstatic inline int gc() {\n    if (ipos == ilen) {\n        ilen = fread(ibuf, 1, sizeof(ibuf), stdin);\n        ipos = 0;\n        if (ilen == 0) return -1;\n    }\n    return ibuf[ipos++];\n}\nstatic inline int readInt() {\n    int c = gc();\n    while (c != '-' && (c < '0' || c > '9')) {\n        if (c == -1) return 0;\n        c = gc();\n    }\n    bool neg = false;\n    if (c == '-') { neg = true; c = gc(); }\n    int x = 0;\n    while (c >= '0' && c <= '9') {\n        x = x * 10 + (c - '0');\n        c = gc();\n    }\n    return neg ? -x : x;\n}\n\nint main() {\n    int R = readInt(), C = readInt(), A = readInt();\n    int L = readInt(), V = readInt(), B = readInt(), T = readInt();\n    int rs = readInt(), cs = readInt();\n    vector<int> tr(L), tc(L);\n    for (int j = 0; j < L; j++) {\n        tr[j] = readInt();\n        tc[j] = readInt();\n    }\n    size_t total = (size_t)A * R * C;\n    vector<int8_t> WD(total), WC(total);\n    for (size_t k = 0; k < total; k++) {\n        WD[k] = (int8_t)readInt();\n        WC[k] = (int8_t)readInt();\n    }\n\n    // Coverage lists: for each cell, the targets whose disk covers it.\n    vector<vector<int>> cover((size_t)R * C);\n    for (int j = 0; j < L; j++) {\n        int r = tr[j], c = tc[j];\n        for (int v = 0; v < C; v++) {\n            int d = abs(v - c);\n            int cd = min(d, C - d);\n            if (cd > V) continue;\n            for (int dr = -V; dr <= V; dr++) {\n                if (dr * dr + cd * cd > V * V) continue;\n                int rr = r + dr;\n                if (rr < 0 || rr >= R) continue;\n                cover[(size_t)rr * C + v].push_back(j);\n            }\n        }\n    }\n\n    auto mv = [&](int r, int c, int h, int &nr, int &nc) -> bool {\n        size_t idx = ((size_t)(h - 1) * R + r) * C + c;\n        int a = r + WD[idx];\n        if (a < 0 || a >= R) return false;\n        int b = ((c + WC[idx]) % C + C) % C;\n        nr = a;\n        nc = b;\n        return true;\n    };\n\n    const double gamma = 0.6;\n    const int H = 6;\n\n    auto gainNow = [&](int cell, int t) -> int {\n        int cnt = 0;\n        for (int j : cover[cell])\n            if (stamp_check: true) {}\n        return cnt;\n    };\n    (void)gainNow;\n\n    vector<int> stampArr(L, 0);\n    auto gainNow2 = [&](int cell, int t) -> double {\n        int cnt = 0;\n        for (int j : cover[cell])\n            if (stampArr[j] != t + 1) cnt++;\n        return cnt;\n    };\n    auto future = [&](int r, int c, int h) -> double {\n        double f = 0, g = 1;\n        int pr = r, pc = c;\n        for (int k = 1; k <= H; k++) {\n            g *= gamma;\n            int nr, nc;\n            if (!mv(pr, pc, h, nr, nc)) break;\n            pr = nr;\n            pc = nc;\n            f += g * (double)cover[(size_t)pr * C + pc].size();\n        }\n        return f;\n    };\n    auto markCover = [&](int cell, int t) {\n        for (int j : cover[cell]) stampArr[j] = t + 1;\n    };\n\n    vector<int> st(B, 0), pr(B, 0), pc(B, 0), ph(B, 0);\n    vector<vector<int>> out(T, vector<int>(B, 0));\n\n    for (int t = 0; t < T; t++) {\n        for (int i = 0; i < B; i++) {\n            if (st[i] == 2) { out[t][i] = 0; continue; }\n            if (st[i] == 0) {\n                int nr, nc;\n                if (!mv(rs, cs, 1, nr, nc)) { out[t][i] = 0; continue; }\n                int cell = nr * C + nc;\n                double sc = gainNow2(cell, t) + future(nr, nc, 1);\n                if (sc > 0) {\n                    st[i] = 1;\n                    pr[i] = nr;\n                    pc[i] = nc;\n                    ph[i] = 1;\n                    out[t][i] = 1;\n                    markCover(cell, t);\n                } else {\n                    out[t][i] = 0;\n                }\n                continue;\n            }\n            // launched and alive\n            double best = -1e18;\n            int bestd = 0, bnr = -1, bnc = -1, bnh = -1;\n            const int ds[3] = {0, -1, 1};\n            for (int d : ds) {\n                int nh = ph[i] + d;\n                if (nh < 1 || nh > A) continue;\n                int nr, nc;\n                if (!mv(pr[i], pc[i], nh, nr, nc)) continue;\n                double sc = gainNow2(nr * C + nc, t) + future(nr, nc, nh);\n                if (sc > best) {\n                    best = sc;\n                    bestd = d;\n                    bnr = nr;\n                    bnc = nc;\n                    bnh = nh;\n                }\n            }\n            if (bnr < 0) {\n                // every option loses the balloon\n                st[i] = 2;\n                out[t][i] = 0;\n                continue;\n            }\n            out[t][i] = bestd;\n            ph[i] = bnh;\n            pr[i] = bnr;\n            pc[i] = bnc;\n            markCover(bnr * C + bnc, t);\n        }\n    }\n\n    string s;\n    s.reserve((size_t)T * B * 3 + 16);\n    for (int t = 0; t < T; t++) {\n        for (int i = 0; i < B; i++) {\n            if (i) s += ' ';\n            s += to_string(out[t][i]);\n        }\n        s += '\\n';\n    }\n    fwrite(s.data(), 1, s.size(), stdout);\n    return 0;\n}\n```",
