    "text": "This is a greedy heuristic, not an optimal solver. Every balloon is launched in turn 0. In each later turn, each balloon picks the altitude change that covers the most still-uncovered targets at its new position, with ties broken by a BFS distance to the nearest target. A time guard drops the coverage term after 7 seconds. I have not compiled or run it against the real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nstatic char ibuf[1 << 16];\nsize_t ipos = 0, ilen = 0;\ninline int gc() {\n    if (ipos == ilen) {\n        ilen = fread(ibuf, 1, sizeof(ibuf), stdin);\n        ipos = 0;\n        if (ilen == 0) return -1;\n    }\n    return ibuf[ipos++];\n}\ninline int readInt() {\n    int c = gc();\n    while (c != '-' && (c < '0' || c > '9')) {\n        if (c == -1) return 0;\n        c = gc();\n    }\n    int s = 1;\n    if (c == '-') { s = -1; c = gc(); }\n    int x = 0;\n    while (c >= '0' && c <= '9') { x = x * 10 + (c - '0'); c = gc(); }\n    return x * s;\n}\n\nint main() {\n    auto startTime = chrono::steady_clock::now();\n\n    int R = readInt(), C = readInt(), A = readInt();\n    int L = readInt(), V = readInt(), B = readInt(), T = readInt();\n    int rs = readInt(), cs = readInt();\n\n    vector<int> ti(L), tj(L);\n    for (int i = 0; i < L; i++) {\n        ti[i] = readInt();\n        tj[i] = readInt();\n    }\n\n    // wind[a][r][c] -> (dr, dc)\n    vector<int8_t> W((size_t)A * R * C * 2);\n    for (int a = 0; a < A; a++)\n        for (int r = 0; r < R; r++)\n            for (int c = 0; c < C; c++) {\n                size_t idx = (((size_t)a * R + r) * C + c) * 2;\n                W[idx] = (int8_t)readInt();\n                W[idx + 1] = (int8_t)readInt();\n            }\n\n    // Coverage lists: for each cell, targets it covers when balloon is there.\n    int N = R * C;\n    vector<vector<int>> lists(N);\n    vector<int> stamp(N, 0);\n    for (int i = 0; i < L; i++) {\n        int u = ti[i], v = tj[i];\n        int stampId = i + 1;\n        for (int r = max(0, u - V); r <= min(R - 1, u + V); r++) {\n            int dr = r - u;\n            for (int dc = -V; dc <= V; dc++) {\n                int x = ((v + dc) % C + C) % C;\n                int d = abs(x - v);\n                int cd = min(d, C - d);\n                if (dr * dr + cd * cd > V * V) continue;\n                int p = r * C + x;\n                if (stamp[p] == stampId) continue;\n                stamp[p] = stampId;\n                lists[p].push_back(i);\n            }\n        }\n    }\n\n    // Distance to nearest target cell (BFS over grid, cyclic columns).\n    vector<int> dist(N, -1);\n    {\n        vector<int> q;\n        q.reserve(N);\n        for (int i = 0; i < L; i++) {\n            int p = ti[i] * C + tj[i];\n            if (dist[p] != 0) {\n                dist[p] = 0;\n                q.push_back(p);\n            }\n        }\n        size_t head = 0;\n        while (head < q.size()) {\n            int p = q[head++];\n            int r = p / C, c = p % C;\n            int d = dist[p] + 1;\n            if (r > 0 && dist[p - C] < 0) { dist[p - C] = d; q.push_back(p - C); }\n            if (r + 1 < R && dist[p + C] < 0) { dist[p + C] = d; q.push_back(p + C); }\n            int cl = (c + C - 1) % C, cr = (c + 1) % C;\n            int pl = r * C + cl, pr = r * C + cr;\n            if (dist[pl] < 0) { dist[pl] = d; q.push_back(pl); }\n            if (dist[pr] < 0) { dist[pr] = d; q.push_back(pr); }\n        }\n        for (int p = 0; p < N; p++) if (dist[p] < 0) dist[p] = 100000;\n    }\n\n    vector<int> alt(B, 0), pr(B, rs), pc(B, cs);\n    vector<char> lost(B, 0), launched(B, 0);\n    vector<char> cov(L, 0);\n\n    string out;\n    out.reserve((size_t)T * B * 3);\n\n    auto windAt = [&](int a /*1-based*/, int r, int c, int& dr, int& dc) {\n        size_t idx = (((size_t)(a - 1) * R + r) * C + c) * 2;\n        dr = W[idx];\n        dc = W[idx + 1];\n    };\n\n    for (int t = 0; t < T; t++) {\n        bool slow = chrono::duration<double>(chrono::steady_clock::now() - startTime).count() > 7.0;\n        fill(cov.begin(), cov.end(), 0);\n        for (int b = 0; b < B; b++) {\n            int d = 0;\n            if (lost[b]) {\n                d = 0;\n            } else if (!launched[b]) {\n                // Launch in turn 0 (all balloons launched immediately).\n                launched[b] = 1;\n                d = 1;\n                alt[b] = 1;\n                int dr, dc;\n                windAt(alt[b], pr[b], pc[b], dr, dc);\n                int nr = pr[b] + dr;\n                if (nr < 0 || nr >= R) {\n                    lost[b] = 1;\n                } else {\n                    int nc = ((pc[b] + dc) % C + C) % C;\n                    pr[b] = nr;\n                    pc[b] = nc;\n                    for (int i : lists[nr * C + nc]) cov[i] = 1;\n                }\n            } else {\n                double best = -1e300;\n                int bestd = 0, bnr = -1, bnc = -1, bna = alt[b];\n                const int order[3] = {0, 1, -1};\n                for (int k = 0; k < 3; k++) {\n                    int dd = order[k];\n                    int na = alt[b] + dd;\n                    if (na < 1 || na > A) continue;\n                    int dr, dc;\n                    windAt(na, pr[b], pc[b], dr, dc);\n                    int nr = pr[b] + dr;\n                    double score;\n                    int nc = -1;\n                    if (nr < 0 || nr >= R) {\n                        score = -1e15;\n                    } else {\n                        nc = ((pc[b] + dc) % C + C) % C;\n                        int p = nr * C + nc;\n                        long long gain = 0;\n                        if (!slow) {\n                            for (int i : lists[p]) if (!cov[i]) gain++;\n                        }\n                        score = (double)gain * 1e6 - dist[p];\n                    }\n                    if (score > best) {\n                        best = score;\n                        bestd = dd;\n                        bnr = nr;\n                        bnc = nc;\n                        bna = na;\n                    }\n                }\n                d = bestd;\n                alt[b] = bna;\n                if (bnr < 0 || bnr >= R) {\n                    lost[b] = 1;\n                } else {\n                    pr[b] = bnr;\n                    pc[b] = bnc;\n                    for (int i : lists[bnr * C + bnc]) cov[i] = 1;\n                }\n            }\n            if (b) out.push_back(' ');\n            if (d == 1) out += \"1\";\n            else if (d == -1) out += \"-1\";\n            else out += \"0\";\n        }\n        out.push_back('\\n');\n    }\n\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
