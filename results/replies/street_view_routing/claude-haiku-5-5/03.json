    "text": "This is a greedy heuristic, not an optimal solver. Each car repeatedly runs Dijkstra from its current junction (bounded by its remaining time) and heads for the unvisited street with the best length-per-second ratio. Cars share the visited set, so later cars cover different streets. A time guard stops the search at about 8 seconds and still prints a valid submission. I have not compiled or run it against the real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    auto startTime = chrono::steady_clock::now();\n    auto elapsed = [&]() {\n        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();\n    };\n\n    int N, M;\n    ll T;\n    int C, S;\n    if (!(cin >> N >> M >> T >> C >> S)) return 0;\n\n    // junction coordinates (not needed for the algorithm)\n    for (int i = 0; i < N; i++) {\n        double la, lo;\n        cin >> la >> lo;\n    }\n\n    vector<int> ea(M), eb(M), ed(M);\n    vector<ll> ec(M), el(M);\n    vector<vector<pair<int,int>>> out(N); // (edge id, neighbour)\n    for (int j = 0; j < M; j++) {\n        cin >> ea[j] >> eb[j] >> ed[j] >> ec[j] >> el[j];\n        out[ea[j]].push_back({j, eb[j]});\n        if (ed[j] == 2) out[eb[j]].push_back({j, ea[j]});\n    }\n\n    const ll INF = LLONG_MAX / 4;\n    const size_t MAX_ITIN = 1000000;\n    const double TIME_LIMIT = 8.0;\n\n    vector<char> visited(M, 0);\n    vector<ll> dist(N, INF);\n    vector<int> pn(N, -1), pe(N, -1);\n    vector<int> touched;\n\n    vector<vector<int>> itins(C);\n    bool timeUp = false;\n\n    for (int car = 0; car < C; car++) {\n        vector<int>& it = itins[car];\n        it.push_back(S);\n        if (timeUp) continue;\n\n        int cur = S;\n        ll rem = T;\n        while (true) {\n            if (elapsed() > TIME_LIMIT) { timeUp = true; break; }\n\n            // Dijkstra from cur, bounded by rem\n            for (int x : touched) { dist[x] = INF; pn[x] = -1; pe[x] = -1; }\n            touched.clear();\n\n            priority_queue<pair<ll,int>, vector<pair<ll,int>>, greater<pair<ll,int>>> pq;\n            dist[cur] = 0;\n            touched.push_back(cur);\n            pq.push({0, cur});\n\n            ll bestNum = 0, bestDen = 1; // ratio L / time\n            int bestU = -1, bestE = -1, bestV = -1;\n            ll bestD = 0;\n\n            while (!pq.empty()) {\n                auto [d, u] = pq.top();\n                pq.pop();\n                if (d != dist[u]) continue;\n                if (d > rem) break;\n\n                for (auto [e, v] : out[u]) {\n                    if (visited[e]) continue;\n                    ll t = d + ec[e];\n                    if (t > rem) continue;\n                    // compare el[e]/t > bestNum/bestDen\n                    if (bestU == -1 || el[e] * bestDen > bestNum * t) {\n                        bestNum = el[e];\n                        bestDen = t;\n                        bestU = u;\n                        bestE = e;\n                        bestV = v;\n                        bestD = d;\n                    }\n                }\n\n                for (auto [e, v] : out[u]) {\n                    ll nd = d + ec[e];\n                    if (nd > rem) continue;\n                    if (nd < dist[v]) {\n                        if (dist[v] == INF) touched.push_back(v);\n                        dist[v] = nd;\n                        pn[v] = u;\n                        pe[v] = e;\n                        pq.push({nd, v});\n                    }\n                }\n            }\n\n            if (bestU == -1) break;\n\n            // Build the path cur -> bestU\n            vector<int> path;\n            vector<int> pathEdges;\n            for (int x = bestU; x != cur; x = pn[x]) {\n                path.push_back(x);\n                pathEdges.push_back(pe[x]);\n            }\n            reverse(path.begin(), path.end());\n            reverse(pathEdges.begin(), pathEdges.end());\n\n            if (it.size() + path.size() + 1 > MAX_ITIN) break;\n\n            for (int e : pathEdges) visited[e] = 1;\n            for (int x : path) it.push_back(x);\n\n            // traverse the chosen street\n            visited[bestE] = 1;\n            it.push_back(bestV);\n            rem -= bestD + ec[bestE];\n            cur = bestV;\n        }\n    }\n\n    // Output\n    string outStr;\n    outStr.reserve(1 << 20);\n    outStr += to_string(C);\n    outStr += '\\n';\n    for (int car = 0; car < C; car++) {\n        const vector<int>& it = itins[car];\n        outStr += to_string(it.size());\n        outStr += '\\n';\n        for (int x : it) {\n            outStr += to_string(x);\n            outStr += '\\n';\n        }\n    }\n    fwrite(outStr.data(), 1, outStr.size(), stdout);\n    return 0;\n}\n```",
