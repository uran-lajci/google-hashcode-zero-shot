    "text": "This is a greedy heuristic, not an exact solver. Cars take turns (round-robin). On each turn a car runs a time-bounded Dijkstra from its position and moves toward the unvisited street with the best ratio of length to time, where time includes the approach. Every itinerary is feasible by construction, and a 8.5-second wall-clock guard stops early and outputs the current valid itineraries. I have not compiled or run it against real data.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\ntypedef long long ll;\n\nint main() {\n    auto startTime = chrono::steady_clock::now();\n    auto elapsed = [&]() {\n        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();\n    };\n\n    int N, M;\n    ll T;\n    int C, S;\n    if (!(cin >> N >> M >> T >> C >> S)) return 0;\n\n    // Junction coordinates (ignored for the algorithm)\n    for (int i = 0; i < N; i++) {\n        double la, lo;\n        cin >> la >> lo;\n    }\n\n    vector<int> SA(M), SB(M), SD(M);\n    vector<ll> SC(M), SL(M);\n    // adjacency: for each node, list of (to, cost, edge id)\n    struct Arc { int to; ll cost; int edge; };\n    vector<vector<Arc>> adj(N);\n    for (int j = 0; j < M; j++) {\n        int a, b, d;\n        ll c, l;\n        cin >> a >> b >> d >> c >> l;\n        SA[j] = a; SB[j] = b; SD[j] = d; SC[j] = c; SL[j] = l;\n        adj[a].push_back({b, c, j});\n        if (d == 2) adj[b].push_back({a, c, j});\n    }\n\n    vector<char> visited(M, 0);\n    const ll INF = LLONG_MAX / 4;\n\n    // Per-car state\n    vector<int> cur(C, S);\n    vector<ll> rem(C, T);\n    vector<vector<int>> path(C, vector<int>(1, S));\n    vector<char> done(C, 0);\n\n    vector<ll> dist(N);\n    vector<int> parNode(N), parEdge(N);\n\n    auto tryMove = [&](int k) -> bool {\n        int u = cur[k];\n        ll r = rem[k];\n        if (r <= 0) return false;\n\n        fill(dist.begin(), dist.end(), INF);\n        dist[u] = 0;\n        parNode[u] = -1;\n        parEdge[u] = -1;\n        priority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<pair<ll, int>>> pq;\n        pq.push({0, u});\n        while (!pq.empty()) {\n            auto [d, v] = pq.top();\n            pq.pop();\n            if (d != dist[v]) continue;\n            for (const Arc& e : adj[v]) {\n                ll nd = d + e.cost;\n                if (nd > r) continue;\n                if (nd < dist[e.to]) {\n                    dist[e.to] = nd;\n                    parNode[e.to] = v;\n                    parEdge[e.to] = e.edge;\n                    pq.push({nd, e.to});\n                }\n            }\n        }\n\n        // Choose best unvisited street direction\n        double bestVal = -1.0;\n        int bestJ = -1, bestFrom = -1, bestTo = -1;\n        ll bestCost = 0;\n        for (int j = 0; j < M; j++) {\n            if (visited[j]) continue;\n            // forward direction\n            for (int dir = 0; dir < 2; dir++) {\n                if (dir == 1 && SD[j] != 2) break;\n                int a = dir == 0 ? SA[j] : SB[j];\n                int b = dir == 0 ? SB[j] : SA[j];\n                if (dist[a] >= INF) continue;\n                ll total = dist[a] + SC[j];\n                if (total > r) continue;\n                double val = (double)SL[j] / (double)total;\n                if (val > bestVal) {\n                    bestVal = val;\n                    bestJ = j;\n                    bestFrom = a;\n                    bestTo = b;\n                    bestCost = total;\n                }\n            }\n        }\n        if (bestJ < 0) {\n            done[k] = 1;\n            return false;\n        }\n\n        // Reconstruct path from u to bestFrom\n        vector<int> nodesRev;\n        vector<int> edgesRev;\n        int v = bestFrom;\n        while (v != u) {\n            nodesRev.push_back(v);\n            edgesRev.push_back(parEdge[v]);\n            v = parNode[v];\n        }\n        // Append path in forward order\n        for (int i = (int)nodesRev.size() - 1; i >= 0; i--) {\n            path[k].push_back(nodesRev[i]);\n            visited[edgesRev[i]] = 1;\n        }\n        // Traverse the chosen street\n        path[k].push_back(bestTo);\n        visited[bestJ] = 1;\n        rem[k] -= bestCost;\n        cur[k] = bestTo;\n        return true;\n    };\n\n    bool moved = true;\n    while (moved) {\n        if (elapsed() > 8.5) break;\n        moved = false;\n        for (int k = 0; k < C; k++) {\n            if (done[k]) continue;\n            if (tryMove(k)) moved = true;\n            if (elapsed() > 8.5) { moved = false; break; }\n        }\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(C);\n    out += '\\n';\n    for (int k = 0; k < C; k++) {\n        out += to_string(path[k].size());\n        out += '\\n';\n        for (int v : path[k]) {\n            out += to_string(v);\n            out += '\\n';\n        }\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
