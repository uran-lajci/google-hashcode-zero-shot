    "text": "This is a greedy heuristic, not an exact solver. Each car repeatedly runs a time-bounded Dijkstra from its current junction and heads for the unvisited directed street that gives the best length per second of travel (approach to its start plus its own traversal cost). It stops when no unvisited street fits in the remaining time. A global 8.5-second guard stops the search early on very large inputs and still prints a valid submission. I have not compiled or run it against any data set.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    auto startTime = chrono::steady_clock::now();\n    auto elapsed = [&]() {\n        return chrono::duration<double>(chrono::steady_clock::now() - startTime).count();\n    };\n\n    int N, M;\n    long long T;\n    int C, S;\n    cin >> N >> M >> T >> C >> S;\n\n    for (int i = 0; i < N; i++) {\n        double la, lo;\n        cin >> la >> lo;\n    }\n\n    vector<int> EA(M), EB(M), ED(M);\n    vector<long long> EC(M), EL(M);\n    // adjacency: arcs from node\n    struct Arc { int to; long long cost; int edge; };\n    vector<vector<Arc>> adj(N);\n    for (int j = 0; j < M; j++) {\n        cin >> EA[j] >> EB[j] >> ED[j] >> EC[j] >> EL[j];\n        adj[EA[j]].push_back({EB[j], EC[j], j});\n        if (ED[j] == 2) {\n            adj[EB[j]].push_back({EA[j], EC[j], j});\n        }\n    }\n\n    vector<char> visited(M, 0);\n    const long long INF = LLONG_MAX / 4;\n    vector<long long> dist(N);\n    vector<int> par(N), parEdge(N);\n\n    vector<vector<int>> itineraries(C);\n    bool timeUp = false;\n\n    for (int car = 0; car < C; car++) {\n        itineraries[car].push_back(S);\n        int cur = S;\n        long long rem = T;\n\n        while (!timeUp) {\n            if (elapsed() > 8.5) { timeUp = true; break; }\n\n            fill(dist.begin(), dist.end(), INF);\n            fill(par.begin(), par.end(), -1);\n            fill(parEdge.begin(), parEdge.end(), -1);\n\n            dist[cur] = 0;\n            priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                           greater<pair<long long, int>>> pq;\n            pq.push({0, cur});\n\n            double bestRatio = -1.0;\n            int bestV = -1, bestE = -1, bestW = -1;\n            long long bestD = 0, bestC = 0;\n\n            while (!pq.empty()) {\n                auto [d, v] = pq.top();\n                pq.pop();\n                if (d != dist[v]) continue;\n                if (d > rem) break;\n                for (const Arc& a : adj[v]) {\n                    long long nd = d + a.cost;\n                    if (nd > rem) continue;\n                    if (!visited[a.edge]) {\n                        double ratio = (double)EL[a.edge] / (double)nd;\n                        if (ratio > bestRatio) {\n                            bestRatio = ratio;\n                            bestV = v;\n                            bestE = a.edge;\n                            bestW = a.to;\n                            bestD = d;\n                            bestC = a.cost;\n                        }\n                    }\n                    if (nd < dist[a.to]) {\n                        dist[a.to] = nd;\n                        par[a.to] = v;\n                        parEdge[a.to] = a.edge;\n                        pq.push({nd, a.to});\n                    }\n                }\n            }\n\n            if (bestV < 0) break;\n\n            // Reconstruct path from cur to bestV.\n            vector<int> pathNodes;\n            vector<int> pathEdges;\n            int x = bestV;\n            while (x != cur) {\n                pathNodes.push_back(x);\n                pathEdges.push_back(parEdge[x]);\n                x = par[x];\n            }\n            reverse(pathNodes.begin(), pathNodes.end());\n            reverse(pathEdges.begin(), pathEdges.end());\n\n            for (size_t k = 0; k < pathNodes.size(); k++) {\n                itineraries[car].push_back(pathNodes[k]);\n                visited[pathEdges[k]] = 1;\n            }\n\n            // Traverse the chosen street.\n            visited[bestE] = 1;\n            itineraries[car].push_back(bestW);\n            cur = bestW;\n            rem -= bestD + bestC;\n        }\n        if (timeUp) {\n            // Remaining cars stay at S.\n        }\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(C);\n    out += '\\n';\n    for (int car = 0; car < C; car++) {\n        out += to_string(itineraries[car].size());\n        out += '\\n';\n        for (int v : itineraries[car]) {\n            out += to_string(v);\n            out += '\\n';\n        }\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
