    "text": "This is a greedy heuristic, not an exact solver. Each step picks the unvisited street that gives the best length-per-second ratio (including the travel time to reach it) across all cars, and the car with the earliest free time moves next. Every committed move fits within T, so the output is always valid. An operation counter, rather than wall-clock time, caps the work so the output stays deterministic. I have not compiled or run it against real data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios_base::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N, M;\n    long long T;\n    int C, S;\n    cin >> N >> M >> T >> C >> S;\n\n    // Junction coordinates are not needed for the computation.\n    for (int i = 0; i < N; i++) {\n        double la, lo;\n        cin >> la >> lo;\n    }\n\n    vector<int> ea(M), eb(M), ed(M);\n    vector<long long> ec(M), el(M);\n    // arcs: for each node, list of (edge id, target node, cost)\n    vector<vector<array<long long, 3>>> arcs(N);\n    for (int j = 0; j < M; j++) {\n        cin >> ea[j] >> eb[j] >> ed[j] >> ec[j] >> el[j];\n        arcs[ea[j]].push_back({(long long)j, (long long)eb[j], ec[j]});\n        if (ed[j] == 2) {\n            arcs[eb[j]].push_back({(long long)j, (long long)ea[j], ec[j]});\n        }\n    }\n\n    vector<char> visited(M, 0);\n    vector<int> pos(C, S);\n    vector<long long> curTime(C, 0);\n    vector<vector<int>> paths(C, vector<int>(1, S));\n\n    priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                   greater<pair<long long, int>>> carQ;\n    for (int i = 0; i < C; i++) carQ.push({0, i});\n\n    const long long INF = LLONG_MAX / 4;\n    const long long LIMIT = 600000000LL;\n    long long ops = 0;\n\n    vector<long long> dist(N);\n    vector<int> parNode(N), parEdge(N);\n\n    while (!carQ.empty() && ops < LIMIT) {\n        auto [t, i] = carQ.top();\n        carQ.pop();\n        long long rem = T - t;\n        if (rem <= 0) continue;\n\n        int src = pos[i];\n        fill(dist.begin(), dist.end(), INF);\n        dist[src] = 0;\n        parNode[src] = -1;\n        parEdge[src] = -1;\n\n        priority_queue<pair<long long, int>, vector<pair<long long, int>>,\n                       greater<pair<long long, int>>> pq;\n        pq.push({0, src});\n\n        double bestVal = -1.0;\n        int bestX = -1, bestY = -1, bestJ = -1;\n        long long bestD = 0, bestC = 0;\n\n        while (!pq.empty()) {\n            auto [d, x] = pq.top();\n            pq.pop();\n            ops++;\n            if (d != dist[x]) continue;\n            for (auto &a : arcs[x]) {\n                ops++;\n                int j = (int)a[0];\n                int y = (int)a[1];\n                long long c = a[2];\n                long long nd = d + c;\n                if (nd > rem) continue;\n                if (!visited[j]) {\n                    double v = (double)el[j] / (double)max(1LL, nd);\n                    if (v > bestVal) {\n                        bestVal = v;\n                        bestX = x;\n                        bestY = y;\n                        bestJ = j;\n                        bestD = d;\n                        bestC = c;\n                    }\n                }\n                if (nd < dist[y]) {\n                    dist[y] = nd;\n                    parNode[y] = x;\n                    parEdge[y] = j;\n                    pq.push({nd, y});\n                }\n            }\n        }\n\n        if (bestVal < 0) {\n            // Nothing reachable and unvisited within remaining time: car is done.\n            continue;\n        }\n\n        // Reconstruct path src -> bestX\n        vector<int> nodes;\n        vector<int> edges;\n        int cur = bestX;\n        while (cur != src) {\n            nodes.push_back(cur);\n            edges.push_back(parEdge[cur]);\n            cur = parNode[cur];\n        }\n        reverse(nodes.begin(), nodes.end());\n        reverse(edges.begin(), edges.end());\n        for (size_t k = 0; k < nodes.size(); k++) {\n            paths[i].push_back(nodes[k]);\n            visited[edges[k]] = 1;\n        }\n        // Traverse the chosen street.\n        paths[i].push_back(bestY);\n        visited[bestJ] = 1;\n        pos[i] = bestY;\n        long long newT = t + bestD + bestC;\n        curTime[i] = newT;\n        carQ.push({newT, i});\n    }\n\n    // Output\n    string out;\n    out.reserve(1 << 20);\n    out += to_string(C);\n    out += '\\n';\n    for (int i = 0; i < C; i++) {\n        out += to_string(paths[i].size());\n        out += '\\n';\n        for (int v : paths[i]) {\n            out += to_string(v);\n            out += '\\n';\n        }\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
