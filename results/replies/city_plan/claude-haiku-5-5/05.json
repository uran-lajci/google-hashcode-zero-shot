    "text": "This is a greedy first-fit heuristic, not an optimal solver. It scans the grid in row-major order and, at each top-left position, places the first project that fits, rotating the starting project so residential and utility buildings stay interleaved. Adding a building never lowers the score, so filling greedily is safe. I have not compiled or run it against the data sets.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\ntypedef bitset<1024> BS;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    auto start = chrono::steady_clock::now();\n\n    int H, W, D, B;\n    cin >> H >> W >> D >> B;\n\n    vector<int> hp(B), wp(B), fr(B, -1), fc(B, -1);\n    vector<vector<BS>> pat(B);\n\n    for (int i = 0; i < B; i++) {\n        char t;\n        int h, w, val;\n        cin >> t >> h >> w >> val;\n        hp[i] = h;\n        wp[i] = w;\n        pat[i].assign(h, BS());\n        for (int row = 0; row < h; row++) {\n            string s;\n            cin >> s;\n            for (int j = 0; j < w; j++) {\n                if (s[j] == '#') {\n                    pat[i][row][j] = 1;\n                    if (fr[i] < 0) {\n                        fr[i] = row;\n                        fc[i] = j;\n                    }\n                }\n            }\n        }\n    }\n\n    vector<BS> occ(H, BS());\n    vector<array<int, 3>> placed;\n    int rot = 0;\n\n    for (int r = 0; r < H; r++) {\n        double el = chrono::duration<double>(chrono::steady_clock::now() - start).count();\n        if (el > 8.0) break;\n        for (int c = 0; c < W; c++) {\n            for (int k = 0; k < B; k++) {\n                int idx = (rot + k) % B;\n                if (r + hp[idx] > H || c + wp[idx] > W) continue;\n                // quick reject: first occupied cell of the plan must be free\n                if (occ[r + fr[idx]][c + fc[idx]]) continue;\n                bool ok = true;\n                for (int i = 0; i < hp[idx]; i++) {\n                    BS shifted = pat[idx][i] << c;\n                    if ((occ[r + i] & shifted).any()) {\n                        ok = false;\n                        break;\n                    }\n                }\n                if (ok) {\n                    for (int i = 0; i < hp[idx]; i++) {\n                        occ[r + i] |= (pat[idx][i] << c);\n                    }\n                    placed.push_back({idx, r, c});\n                    rot = (idx + 1) % B;\n                    break;\n                }\n            }\n        }\n    }\n\n    string out;\n    out += to_string(placed.size());\n    out += '\\n';\n    for (auto &p : placed) {\n        out += to_string(p[0]);\n        out += ' ';\n        out += to_string(p[1]);\n        out += ' ';\n        out += to_string(p[2]);\n        out += '\\n';\n    }\n    cout << out;\n    return 0;\n}\n```",
