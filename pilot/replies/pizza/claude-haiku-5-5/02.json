    "text": "This is a greedy heuristic, not an exact optimum. It scans top-left cells in row-major order. For each free top-left cell it tries every height `h`, takes the widest free width `w \u2264 H/h`, and keeps the largest valid rectangle. Validity uses 2D prefix sums of mushrooms, with tomatoes computed as area minus mushrooms. Chosen slices are marked used and the free-run lengths are updated. I have not compiled or run it against any data set, so the 10-second limit is an estimate.\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int R, C, L, H;\n    cin >> R >> C >> L >> H;\n    vector<string> g(R);\n    for (int i = 0; i < R; i++) cin >> g[i];\n\n    // If no slice can satisfy both constraints, output zero slices.\n    if (2 * L > H) {\n        printf(\"0\\n\");\n        return 0;\n    }\n\n    // 2D prefix sums of mushrooms.\n    int W1 = C + 1;\n    vector<int> P((size_t)(R + 1) * W1, 0);\n    for (int i = 0; i < R; i++) {\n        for (int j = 0; j < C; j++) {\n            int m = (g[i][j] == 'M') ? 1 : 0;\n            P[(size_t)(i + 1) * W1 + (j + 1)] =\n                P[(size_t)i * W1 + (j + 1)] + P[(size_t)(i + 1) * W1 + j] -\n                P[(size_t)i * W1 + j] + m;\n        }\n    }\n    auto mushRect = [&](int r, int c, int h, int w) -> int {\n        int r2 = r + h, c2 = c + w;\n        return P[(size_t)r2 * W1 + c2] - P[(size_t)r * W1 + c2] -\n               P[(size_t)r2 * W1 + c] + P[(size_t)r * W1 + c];\n    };\n\n    // used grid and run[i][j] = number of consecutive free cells starting at (i,j) going right.\n    vector<char> used((size_t)R * C, 0);\n    vector<int> run((size_t)R * (C + 1), 0);\n    auto RUN = [&](int i, int j) -> int& { return run[(size_t)i * (C + 1) + j]; };\n    for (int i = 0; i < R; i++)\n        for (int j = 0; j < C; j++) RUN(i, j) = C - j;\n\n    vector<array<int, 4>> slices;\n\n    for (int r = 0; r < R; r++) {\n        for (int c = 0; c < C; c++) {\n            if (used[(size_t)r * C + c]) continue;\n            int fw = INT_MAX;\n            int bestArea = 0, bh = 0, bw = 0;\n            int maxH = min(R - r, H);\n            for (int h = 1; h <= maxH; h++) {\n                fw = min(fw, RUN(r + h - 1, c));\n                if (fw == 0) break;\n                int w = min(fw, H / h);\n                if (w <= 0) break;\n                int area = h * w;\n                if (area <= bestArea) continue;\n                int mush = mushRect(r, c, h, w);\n                int tom = area - mush;\n                if (mush >= L && tom >= L) {\n                    bestArea = area;\n                    bh = h;\n                    bw = w;\n                }\n            }\n            if (bestArea > 0) {\n                slices.push_back({r, c, r + bh - 1, c + bw - 1});\n                for (int i = r; i < r + bh; i++) {\n                    for (int j = c; j < c + bw; j++) used[(size_t)i * C + j] = 1;\n                    for (int j = c + bw - 1; j >= 0; j--) {\n                        RUN(i, j) = used[(size_t)i * C + j] ? 0 : RUN(i, j + 1) + 1;\n                    }\n                }\n            }\n        }\n    }\n\n    string out;\n    out.reserve(slices.size() * 24 + 16);\n    out += to_string(slices.size());\n    out += '\\n';\n    for (auto& s : slices) {\n        out += to_string(s[0]); out += ' ';\n        out += to_string(s[1]); out += ' ';\n        out += to_string(s[2]); out += ' ';\n        out += to_string(s[3]); out += '\\n';\n    }\n    fwrite(out.data(), 1, out.size(), stdout);\n    return 0;\n}\n```",
